{
  "name": "minimal",
  "description": "Clean, distraction-free desktop — like Mint or elementary",
  "panel": {
    "position": "top",
    "height": 34,
    "dock": false,
    "widgets": ["app-launcher", "clock"]
  },
  "compositor": {
    "enabled": true,
    "blur": false,
    "vsync": "auto",
    "latency_mode": "low",
    "animation_speed": 3
  },
  "wallpaper": "/usr/share/wallpapers/solus/minimal.png",
  "services": {
    "gamemode": false,
    "tracker_services": false,
    "background_services_stopped": ["bluetooth", "cups", "geoclue"]
  },
  "shortcuts": {
    "super+d": "show-desktop",
    "super+return": "konsole",
    "super+f": "firefox",
    "super+e": "dolphin",
    "alt+f2": "krunner"
  },
  "performance": {
    "cpu_governor": "schedutil",
    "gpu_profile": "auto",
    "io_scheduler": "mq-deadline",
    "zram_enabled": true,
    "swappiness": 10
  }
}
