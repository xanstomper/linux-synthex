[Unit]
Description=Synthex Auto-Tuning Engine
After=graphical-session.target
ConditionPathExists=!/var/lib/synthex/auto-tune-state.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/synthex-auto-tune
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
# Auto-tune writes sysctl, modprobe, pipewire, udev rules, env.d — needs access
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectControlGroups=yes
MemoryMax=128M
CPUQuota=30%

[Install]
WantedBy=graphical-session.target
