[Unit]
Description=Synthex Auto-Tuning Engine
After=graphical-session.target
ConditionPathExists=!/var/lib/synthex/auto-tune-state.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/synthex-auto-tune
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=128M
[Install]
WantedBy=graphical-session.target

CPUQuota=30%
