[Unit]
Description=Synthex Integration Engine — Upstream monitoring and integration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/synthex-integration-engine daemon
Restart=on-failure
RestartSec=3600
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
