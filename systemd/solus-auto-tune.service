[Unit]
Description=Solus Auto-Tuning Engine
After=graphical-session.target
ConditionPathExists=!/var/lib/solus/auto-tune-state.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/solus/solus-auto-tune
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=128M
CPUQuota=30%
