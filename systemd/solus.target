[Unit]
Description=Solus Linux Platform
Documentation=https://docs.solus-project.org
Requires=dbus.service
After=dbus.service network-online.target

# Core infrastructure
Wants=solus-desktopd.service solus-stored.service solus-hwdaemon.service
Wants=solus-gpu-setupd.service solus-workspace.service
Wants=solus-marketplace.service solus-webappd.service
Wants=solus-recovery.service solus-oobe.service
Wants=solus-blueprint.service solus-blueprint.timer
Wants=solus-ananicy.service

# AI
Wants=solus-ai-hub.service
Wants=solus-agent.service

# Graphical (only on desktop installs)
Wants=solus-control-center.service solus-studiocd.service

[Install]
WantedBy=multi-user.target
