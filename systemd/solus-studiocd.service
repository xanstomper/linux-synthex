[Unit]
Description=Solus Studio Daemon
Documentation=https://solus-linux.org/docs/studio
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.solus.Studio
ExecStart=/usr/bin/solus-studiocd
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0


# Security hardening
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
