[Unit]
Description=Synthex Gaming Mode
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/synthex-gaming-mode on
RemainAfterExit=yes
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=64M
CPUQuota=20%
