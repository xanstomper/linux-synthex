[Unit]
Description=Synthex Gaming Mode
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/synthex-gaming-mode on
RemainAfterExit=yes
# Gaming mode needs root for CPU governor, GPU performance, sysctl writes
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
MemoryMax=64M
CPUQuota=20%

[Install]
WantedBy=graphical.target
