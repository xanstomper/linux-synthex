[Unit]
Description=Synthex Blueprint — Daily System Backup
Documentation=https://docs.synthex-project.org/blueprint

[Service]
Type=oneshot
ExecStart=/usr/bin/synthex-blueprint export /var/backups/synthex/system.zbp --quiet
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryMax=256M
[Install]
WantedBy=multi-user.target

CPUQuota=30%
