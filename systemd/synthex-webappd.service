[Unit]
Description=Synthex Web App Engine Daemon
Documentation=https://docs.synthex-project.org/webapp-engine
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/synthex-webappd --daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening — needs network + home write access for web app .desktop creation
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=128M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
