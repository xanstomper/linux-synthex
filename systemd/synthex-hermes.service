[Unit]
Description=SynthOS Hermes AI Agent Runtime
After=network.target dbus.service

[Service]
Type=dbus
BusName=org.synthex.Hermes
ExecStart=/usr/lib/synthex/synthex-hermes
Restart=always
RestartSec=5
Environment=RUST_LOG=info
StateDirectory=synthex/hermes
LogsDirectory=synthex

[Install]
WantedBy=multi-user.target
