[Unit]
Description=Solus Hardware Detection Daemon (Rust)
Documentation=https://github.com/xanstomper/solus-linux
After=local-fs.target syslog.target

[Service]
Type=simple
ExecStart=/usr/libexec/solus/solus-hwdaemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
