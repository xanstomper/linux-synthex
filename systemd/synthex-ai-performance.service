[Unit]
Description=SynthOS AI Performance Tuning
Documentation=https://getsynthex.io/docs/ai-performance
After=local-fs.target
Before=synthex-brain.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Apply AI/IPC kernel parameters
ExecStart=/bin/sh -c 'sysctl -p /etc/synthex/sysctl-ai-performance.conf'
# Set all CPU cores to performance governor for minimum inference latency
ExecStart=/bin/sh -c 'echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor'
# Prefer mq-deadline on NVMe for low-latency sequential I/O (model loading)
ExecStart=/bin/sh -c 'echo mq-deadline > /sys/block/nvme*/queue/scheduler 2>/dev/null || true'
# Increase NVMe read-ahead to 2 MiB for faster model weight streaming
ExecStart=/bin/sh -c 'echo 2048 > /sys/block/nvme*/queue/read_ahead_kb 2>/dev/null || true'

# ── Hardening ──────────────────────────────────────────────────────────────
# Note: this service writes /sys (governor/scheduler), so we deliberately omit
# ProtectKernelTunables.  All other hardening directives are applied.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProtectRoot=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
UMask=0077

[Install]
WantedBy=multi-user.target
