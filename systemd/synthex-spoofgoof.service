[Unit]
Description=Synthex SpoofGoof Zero-Latency Packet Noise & Traffic Obfuscation Daemon
Documentation=man:spoofgoof(1)
After=network.target synthex-aegis.service
PartOf=synthex.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/jewboy420/linux-synthex/src/synthex-security/synthex_spoofgoof.py daemon
Restart=always
RestartSec=5s

# Security Hardening
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target synthex.target
