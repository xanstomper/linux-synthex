[Unit]
Description=Synthex Hardware Detection Daemon (Rust)
Documentation=https://github.com/xanstomper/synthex-linux
After=local-fs.target syslog.target

[Service]
Type=simple
ExecStart=/usr/libexec/synthex/synthex-hwdaemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
