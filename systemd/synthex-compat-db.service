[Unit]
Description=Synthex Hardware Compatibility Database Scanner
After=synthex-hwdaemon.service
Wants=synthex-hwdaemon.service

[Service]
Type=oneshot
ExecStart=/usr/bin/synthex-compat scan
StandardOutput=journal

# Security hardening
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
