[Unit]
Description=Synthex Service Manager — systemd service health
Documentation=https://docs.synthex.org
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/synthex-service --json health
ExecStop=/usr/bin/synthex-service --json summary
RemainAfterExit=yes

# Security hardening
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=synthex.target
