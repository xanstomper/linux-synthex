[Unit]
Description=Solus Agent — Desktop AI Platform (DBus)
Documentation=https://docs.solus-project.org/agent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.solus.Agent
ExecStart=/usr/bin/solus-agentd
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# Resource limits
MemoryMax=512M
CPUQuota=60%

# Security
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=graphical-session.target
