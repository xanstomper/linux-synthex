[Unit]
Description=Synthex Studio Daemon
Documentation=https://synthex-linux.org/docs/studio
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.Studio
ExecStart=/usr/bin/synthex-studiocd
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0


# Security hardening
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
