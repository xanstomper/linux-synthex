[Unit]
Description=Synthex First Boot Setup
Documentation=https://synthex-linux.org/docs/firstboot
After=network-online.target syslog.target systemd-udevd.service
Wants=network-online.target
ConditionPathExists=!/var/lib/synthex/firstboot-complete

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/firstboot.sh
RemainAfterExit=yes
StandardOutput=journal+console

# First boot needs full write access (user creation, package install, system config)
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
