[Unit]
Description=Synthex First Boot Setup
Documentation=https://synthex-linux.org/docs/firstboot
After=network-online.target syslog.target systemd-udevd.service
Wants=network-online.target
ConditionPathExists=!/var/lib/synthex/firstboot-complete

[Service]
Type=oneshot
ExecStart=/usr/libexec/synthex/firstboot.sh
RemainAfterExit=yes
StandardOutput=journal+console

# Security hardening — needs broad access for first-time setup
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=512M
CPUQuota=50%
