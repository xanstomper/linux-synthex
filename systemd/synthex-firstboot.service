[Unit]
Description=SynthOS First Boot Setup
ConditionPathExists=!/var/lib/synthex/firstboot-done
After=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/synthex/synthex-firstboot
ExecStartPost=/usr/bin/touch /var/lib/synthex/firstboot-done
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
