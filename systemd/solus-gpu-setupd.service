[Unit]
Description=Solus GPU Driver Setup Daemon (Rust)
Documentation=https://github.com/xanstomper/solus-linux
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/libexec/solus/solus-gpu-setupd
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
