[Unit]
Description=Synthex Desktop Marketplace — Cache Update
Documentation=https://synthex-linux.org/docs/marketplace
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/synthex-marketplace list --cache
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
