# Solus RGB peripheral access rules
# Grants OpenRGB (and similar tools) access to motherboard / RAM / GPU /
# keyboard / mouse / fan RGB controllers without root.

# --- ASUS Aura (motherboard / GPU / peripherals) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="0b05", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", MODE="0666", TAG+="uaccess"

# --- Corsair (iCUE Link, Commander, keyboards, mice, fans) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", MODE="0666", TAG+="uaccess"

# --- Razer (Chroma keyboards, mice, mousepads) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="1532", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", MODE="0666", TAG+="uaccess"

# --- NZXT (Hue, Grid, RGB strips, AIO coolers) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e71", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", MODE="0666", TAG+="uaccess"

# --- Cooler Master (MasterKeys, RGB controllers) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="2516", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2516", MODE="0666", TAG+="uaccess"

# --- Gigabyte RGB Fusion / AORUS ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="1044", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1044", MODE="0666", TAG+="uaccess"

# --- ASRock Polychrome ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="26ce", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", MODE="0666", TAG+="uaccess"

# --- EVGA GPUs / peripherals ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="3842", MODE="0666", TAG+="uaccess"

# --- Lian Li (Uni Fan controllers, STRIMER) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="0cf2", MODE="0666", TAG+="uaccess"

# --- InWin (RGB fans / cases) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f00", MODE="0666", TAG+="uaccess"

# --- Thermaltake (TT RGB Plus) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="2433", MODE="0666", TAG+="uaccess"

# --- Logitech G-series (G HUB / Lightsync keyboards and mice) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c33f|c336|c33f|c539|c52b|c33f", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0666", TAG+="uaccess"

# --- Motherboard SMBus / i2c for SPD RAM RGB (Corsair Vengeance, G.Skill Trident Z) ---
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-*", GROUP="games", MODE="0660", TAG+="uaccess"

# --- OpenRGB system service hint: start on supported device add ---
SUBSYSTEM=="usb", ACTION=="add", ENV{ID_VENDOR_ID}=="0b05|1b1c|1532|1e71|2516|1044|26ce|0cf2|1f00|2433", \
    RUN+="/usr/bin/systemctl try-restart openrgb.service", TAG+="uaccess"
