#!/usr/bin/env bash
# solus-installer-hook — Calamares integration script
# Runs solus-installer-detect and writes configuration files that Calamares
# modules consume to auto-configure the target system for detected hardware.
#
# Called at the beginning of installation and during post-install.
set -euo pipefail

DETECT_BIN="/usr/bin/solus-installer-detect"
CALAMARES_CONF_DIR="/etc/calamares"
INSTALLER_CONF="/etc/solus-installer/hardware.json"
SESSION_FILE="/run/solus-installer/detection.json"

usage() {
    echo "Usage: solus-installer-hook [pre-install|post-install|write-calamares]"
    echo ""
    echo "  pre-install     Detect hardware, write Calamares overrides"
    echo "  post-install    Write system config for detected hardware"
    echo "  write-calamares Write Calamares settings files (JSON)"
    exit 1
}

# Run detection and save results
run_detection() {
    echo "🔍 Running Solus hardware detection..."
    mkdir -p "$(dirname "$SESSION_FILE")"
    mkdir -p "$(dirname "$INSTALLER_CONF")"

    if command -v "$DETECT_BIN" &>/dev/null; then
        "$DETECT_BIN" > "$SESSION_FILE"
    else
        echo "⚠  solus-installer-detect not available, using defaults"
        echo '{"form_factor":"desktop","gpus":[{"vendor":"unknown"}],"disks":[],"system":{"ram_mb":4096,"cpu_cores":4}}' > "$SESSION_FILE"
    fi

    echo "✅ Detection saved to $SESSION_FILE"
}

# Write Calamares module configurations
write_calamares_configs() {
    local json="$SESSION_FILE"
    [ ! -f "$json" ] && echo "No detection data — run pre-install first" && exit 1

    local gpu_type
    gpu_type=$(jq -r '.gpus[0].vendor // "unknown"' "$json")
    local form_factor
    form_factor=$(jq -r '.form_factor // "desktop"' "$json")
    local fs_type
    fs_type=$(jq -r '.filesystem_recommendation.fs // "btrfs"' "$json")
    local kernel
    kernel=$(jq -r '.kernel_recommendation.kernel // "kernel-core"' "$json")
    local params
    params=$(jq -r '.kernel_recommendation.extra_params // ""' "$json")
    local desktop
    desktop=$(jq -r '.edition_recommendation.desktop // "plasma"' "$json")
    local swap_type
    swap_type=$(jq -r '.swap_recommendation.swap_type // "zram"' "$json")
    local swap_size
    swap_size=$(jq -r '.swap_recommendation.size_mb // 4096' "$json")
    local driver
    driver=$(jq -r '.gpu_driver.driver // "modesetting"' "$json")
    local firmware
    firmware=$(jq -r '.firmware.firmware_type // "uefi"' "$json")

    # --- Write Calamares partition overrides ---
    PART_CONF="$CALAMARES_CONF_DIR/solus-partition-overrides.conf"
    cat > "$PART_CONF" <<EOF
# Solus partition overrides — auto-generated by solus-installer-detect
defaultFilesystem: "$fs_type"
btrfs:
    compression: "zstd:3"
    compressionLevel: 3
    snapper:
        enabled: true
swap:
    zram: true
    zramFraction: 0.5
    size: $swap_size
EOF
    echo "  ✅ Partition config: $PART_CONF (fs=$fs_type, swap=$swap_type)"

    # --- Write Calamares display manager overrides ---
    DM_CONF="$CALAMARES_CONF_DIR/solus-displaymanager-overrides.conf"
    cat > "$DM_CONF" <<EOF
# Solus display manager overrides — auto-generated by solus-installer-detect
defaultDesktop: "$desktop"
defaultDesktopEnvironment:
    plasma: "plasma"
displaymanagers:
    - sddm
greeter:
    sddm:
        theme: "solus-sddm-theme"
        enableNumlock: true
basicSetup: true
EOF
    echo "  ✅ Display manager config: $DM_CONF (desktop=$desktop)"

    # --- Write kernel cmdline override ---
    CMDLINE_CONF="$CALAMARES_CONF_DIR/solus-kernel-overrides.conf"
    cat > "$CMDLINE_CONF" <<EOF
# Solus kernel overrides — auto-generated by solus-installer-detect
kernel: "$kernel"
grub:
    defaults: "quiet splash $params"
EOF
    echo "  ✅ Kernel config: $CMDLINE_CONF (kernel=$kernel)"

    # --- Write services override ---
    SVCS_CONF="$CALAMARES_CONF_DIR/solus-services-overrides.conf"
    cat > "$SVCS_CONF" <<EOF
# Solus services overrides — auto-generated by solus-installer-detect
services:
    enabled:
        - NetworkManager
        - bluetooth
        - solus-system-daemon
EOF
    echo "  ✅ Services config: $SVCS_CONF"

    # --- Write package selection override (GPU driver) ---
    PKG_CONF="$CALAMARES_CONF_DIR/solus-package-overrides.conf"
    cat > "$PKG_CONF" <<EOF
# Solus package overrides — auto-generated by solus-installer-detect
additional_packages:
    - $kernel
EOF

    case "$gpu_type" in
        nvidia)
            echo "    - nvidia-driver" >> "$PKG_CONF"
            echo "    - nvidia-settings" >> "$PKG_CONF"
            echo "    - nvidia-vaapi-driver" >> "$PKG_CONF"
            echo "  ✅ NVIDIA driver packages added"
            ;;
        amd)
            echo "    - rocm-hip" >> "$PKG_CONF"
            echo "    - rocm-smi" >> "$PKG_CONF"
            echo "  ✅ AMD ROCm packages added"
            ;;
        intel)
            echo "    - intel-compute-runtime" >> "$PKG_CONF"
            echo "  ✅ Intel compute packages added"
            ;;
    esac

    if [ "$form_factor" = "laptop" ]; then
        echo "    - tlp" >> "$PKG_CONF"
        echo "    - power-profiles-daemon" >> "$PKG_CONF"
        echo "  ✅ Laptop power management packages added"
    fi
}

# Post-install: write final configuration
post_install() {
    local json="$INSTALLER_CONF"
    [ ! -f "$json" ] && echo "No hardware config found" && exit 0

    local gpu_type
    gpu_type=$(jq -r '.gpus[0].vendor // "unknown"' "$json")
    local form_factor
    form_factor=$(jq -r '.form_factor // "desktop"' "$json")
    local driver
    driver=$(jq -r '.gpu_driver.driver // "modesetting"' "$json")
    local params
    params=$(jq -r '.kernel_recommendation.extra_params // ""' "$json")

    # Configure GPU
    case "$gpu_type" in
        nvidia)
            # Enable NVIDIA modeset
            if [ -n "$params" ]; then
                for p in $params; do
                    if grep -q "^$p" /etc/default/grub 2>/dev/null; then
                        :  # Already set
                    else
                        sed -i "s/GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"$p /" /etc/default/grub 2>/dev/null || true
                    fi
                done
            fi

            # Enable NVIDIA DRM
            mkdir -p /etc/dracut.conf.d
            echo 'add_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "' > /etc/dracut.conf.d/nvidia.conf
            echo "  ✅ NVIDIA DRM modules configured"
            ;;
        amd)
            mkdir -p /etc/dracut.conf.d
            echo 'add_drivers+=" amdgpu "' > /etc/dracut.conf.d/amdgpu.conf
            echo "  ✅ AMDGPU modules configured"
            ;;
    esac

    # Enable system daemon
    if command -v systemctl &>/dev/null; then
        systemctl enable solus-system-daemon.service 2>/dev/null || true
        echo "  ✅ solus-system-daemon enabled"
    fi

    # Save detection result to installed system
    cp "$json" /mnt/etc/solus-installer/hardware.json 2>/dev/null || true

    echo "✅ Post-install configuration complete"
}

# ─── Main ────────────────────────────────────────────────────────

case "${1:-help}" in
    pre-install)
        run_detection
        write_calamares_configs
        # Copy to persistent location
        cp "$SESSION_FILE" "$INSTALLER_CONF" 2>/dev/null || true
        echo "✅ Pre-install configuration complete"
        ;;
    post-install)
        post_install
        ;;
    write-calamares)
        write_calamares_configs
        ;;
    *)
        usage
        ;;
esac
