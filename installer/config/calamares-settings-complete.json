{
    "modules-search": [
        "/usr/lib/calamares/modules",
        "/usr/share/calamares/modules"
    ],
    "sequence": [
        {
            "show": [
                "welcome",
                "locale",
                "keyboard",
                "partition",
                "users",
                "solusprofile",
                "summary"
            ]
        },
        {
            "exec": [
                "partition",
                "mount",
                "packages",
                "bootloader",
                "soluspostinstall",
                "unpackfs",
                "networkcfg",
                "hwclock",
                "services-systemd",
                "grubcfg",
                "plymouthcfg",
                "initramfscfg",
                "users",
                "displaymanager",
                "mkswapfile",
                "machineid",
                "fstab",
                "luksbootkeyfile",
                "removeuser",
                "umount",
                "finished"
            ]
        }
    ],
    "branding": "solus",
    "prompt-install": true,
    "dont-chroot": false,
    "oem-setup": false,
    "disable-cancel-during-install": false,
    "quit-at-end": true,
    "log-level": 6,
    "log-file": "/var/log/calamares.log"
}
