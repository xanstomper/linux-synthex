CONFIG_SCHED_BORE_DISABLE_LOAD=y
CONFIG_SCHED_BORE_PROCESSOR_FRIENDLY=y
CONFIG_SCHED_BORE_PROCESSOR_FRIENDLY_DEFAULT=0
