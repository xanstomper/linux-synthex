[Unit]
Description=Solus Safety — Boot Health Check
Documentation=https://solus-linux.org/docs/safety
After=multi-user.target
Wants=multi-user.target
ConditionPathExists=/var/lib/solus/firstboot-complete

[Service]
Type=oneshot
ExecStart=/usr/libexec/solus/solus-safety-check
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
# Health check is advisory — never block boot on its result.
SuccessExitStatus=0 1 2

[Install]
WantedBy=multi-user.target
