{
  "name": "Synthex Touch",
  "description": "Tablet & handheld. Finger-friendly. Bold.",
  "color_scheme": "synthex-frost",
  "accent": "#5B9BD5",
  "theme": "org.kde.breeze.desktop",
  "wallpaper": "synthex-frost",
  "panel_height": 56,
  "panel_location": "top",
  "blur": true,
  "transparency": "always",
  "animations_speed": 1,
  "compositor": "opengl",
  "menu_style": "kickoff-grid",
  "click_behavior": "single",
  "tooltips": false,
  "taskmanager_grouping": "disabled",
  "show_clock": true,
  "show_date": true,
  "font_size_adjust": 2,
  "window_decoration": "breeze",
  "border_size": "Large",
  "workspace_rows": 1,
  "workspace_cols": 4,
  "splash": "synthex-touch",
  "plug": "Touch-first interface with large targets",
  "id": "touch",
  "bg_color": "#171D24",
  "fg_color": "#5B9BD5",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeLight",
  "icon_theme": "breeze",
  "cursor_theme": "breeze_cursors"
}