{
  "name": "Synthex Lite",
  "description": "Lightweight. Fast. Old hardware friendly.",
  "color_scheme": "synthex-graphite",
  "accent": "#8899AA",
  "theme": "org.kde.breeze.desktop",
  "wallpaper": "solid",
  "panel_height": 32,
  "panel_location": "bottom",
  "blur": false,
  "transparency": "opaque",
  "animations_speed": 0,
  "compositor": "xrender",
  "menu_style": "simplemenu",
  "click_behavior": "double",
  "tooltips": true,
  "taskmanager_grouping": "always",
  "show_clock": true,
  "show_date": true,
  "font_size_adjust": -1,
  "window_decoration": "breeze",
  "border_size": "Tiny",
  "workspace_rows": 1,
  "workspace_cols": 2,
  "splash": "none",
  "plug": "Maximum performance on old hardware - no effects",
  "id": "lite",
  "bg_color": "#0B0F1A",
  "fg_color": "#8899AA",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeDark",
  "icon_theme": "breeze-dark",
  "cursor_theme": "breeze_cursors"
}