{
  "name": "Synthex Classic",
  "description": "Windows-like. Familiar. Easy onboarding.",
  "color_scheme": "synthex-mint",
  "accent": "#86C166",
  "theme": "org.kde.breeze.desktop",
  "wallpaper": "synthex-mint",
  "panel_height": 40,
  "panel_location": "bottom",
  "blur": false,
  "transparency": "opaque",
  "animations_speed": 2,
  "compositor": "opengl",
  "menu_style": "kickoff-windows",
  "click_behavior": "double",
  "tooltips": true,
  "taskmanager_grouping": "always",
  "show_clock": true,
  "show_date": true,
  "font_size_adjust": 0,
  "window_decoration": "breeze",
  "border_size": "Normal",
  "workspace_rows": 1,
  "workspace_cols": 2,
  "splash": "synthex",
  "plug": "Familiar Windows-style interface for newcomers",
  "id": "classic",
  "bg_color": "#2A2A1A",
  "fg_color": "#86C166",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeLight",
  "icon_theme": "breeze",
  "cursor_theme": "breeze_cursors"
}