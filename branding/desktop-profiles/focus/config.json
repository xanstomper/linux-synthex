{
  "name": "Synthex Focus",
  "description": "Distraction-free. Keyboard-centric. Ultra-minimal.",
  "color_scheme": "synthex-graphite",
  "accent": "#9BBD5C",
  "theme": "org.kde.breeze.desktop",
  "wallpaper": "synthex-graphite",
  "panel_height": 28,
  "panel_location": "top",
  "blur": false,
  "transparency": "translucent",
  "animations_speed": 3,
  "compositor": "xrender",
  "menu_style": "simplemenu",
  "click_behavior": "double",
  "tooltips": false,
  "taskmanager_grouping": "disabled",
  "show_clock": true,
  "show_date": false,
  "font_size_adjust": 1,
  "window_decoration": "breeze",
  "border_size": "Tiny",
  "workspace_rows": 1,
  "workspace_cols": 4,
  "splash": "none",
  "plug": "Focused minimalism for keyboard-driven power users",
  "id": "focus",
  "bg_color": "#0B0F1A",
  "fg_color": "#9BBD5C",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeDark",
  "icon_theme": "breeze-dark",
  "cursor_theme": "breeze_cursors"
}