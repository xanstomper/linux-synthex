{
  "name": "Synthex Pro",
  "description": "Developer & creator cockpit. Split-panel. Terminal-first.",
  "color_scheme": "synthex-graphite",
  "accent": "#5B9BD5",
  "theme": "org.kde.breeze-dark.desktop",
  "wallpaper": "synthex-graphite",
  "panel_height": 48,
  "panel_location": "left",
  "blur": true,
  "transparency": "translucent",
  "animations_speed": 2,
  "compositor": "opengl",
  "menu_style": "kickoff-search",
  "click_behavior": "double",
  "tooltips": true,
  "taskmanager_grouping": "by-program",
  "show_clock": true,
  "show_date": true,
  "font_size_adjust": 0,
  "window_decoration": "breeze",
  "border_size": "Normal",
  "workspace_rows": 2,
  "workspace_cols": 3,
  "splash": "synthex",
  "plug": "Developer cockpit with terminal-first workflow",
  "id": "pro",
  "bg_color": "#10151B",
  "fg_color": "#5B9BD5",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeDark",
  "icon_theme": "breeze-dark",
  "cursor_theme": "breeze_cursors"
}