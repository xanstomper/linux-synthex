{
  "name": "Synthex AI",
  "description": "AI-first desktop. Assistant everywhere. Smart workspace.",
  "color_scheme": "synthex-midnight",
  "accent": "#9BBD5C",
  "theme": "org.kde.breeze-dark.desktop",
  "wallpaper": "synthex-midnight",
  "panel_height": 32,
  "panel_location": "top",
  "blur": true,
  "transparency": "translucent",
  "animations_speed": 1,
  "compositor": "opengl",
  "menu_style": "kickoff-search",
  "click_behavior": "double",
  "tooltips": true,
  "taskmanager_grouping": "by-program",
  "show_clock": true,
  "show_date": true,
  "font_size_adjust": 0,
  "window_decoration": "synthex-plasma",
  "border_size": "Normal",
  "workspace_rows": 2,
  "workspace_cols": 4,
  "splash": "synthex",
  "plug": "AI-first workspace with assistant sidebar and smart search",
  "id": "ai",
  "bg_color": "#000000",
  "fg_color": "#9BBD5C",
  "widget_theme": "breeze",
  "color_scheme_ref": "BreezeDark",
  "icon_theme": "breeze-dark",
  "cursor_theme": "breeze_cursors"
}