[Plymouth Theme]
Name=Synthex
Description=Synthex Linux Boot Splash
ModuleName=synthex-theme

[synthex-theme]
ImageDir=/usr/share/plymouth/themes/synthex
HorizontalAlignment=0.5
VerticalAlignment=0.5
Transition=none
TransitionDuration=0.0
UseBackgroundCompositing=true
BackgroundStartColor=0x0B0F1A
BackgroundEndColor=0x1A1A2E
Logo=/usr/share/plymouth/themes/synthex/logo.png
LogoOpacity=0.8
Bullet=/usr/share/plymouth/themes/synthex/bullet.png
BulletHighlight=/usr/share/plymouth/themes/synthex/bullet-highlight.png
Watermark=/usr/share/plymouth/themes/synthex/watermark.png
