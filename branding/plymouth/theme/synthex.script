# ═══════════════════════════════════════════════════════════════════
# SynthOS Plymouth Boot Theme Script
# Dark navy/amber aesthetic
# ═══════════════════════════════════════════════════════════════════

# ── Background ───────────────────────────────────────────────────
Window.SetBackgroundTopColor    (0.043, 0.059, 0.102);   # #0B0F1A
Window.SetBackgroundBottomColor (0.102, 0.102, 0.180);   # #1A1A2E

# ── Logo ─────────────────────────────────────────────────────────
logo.image     = Image("logo.png");
logo.sprite    = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(0.0);

# ── Progress bar ─────────────────────────────────────────────────
progress_bar.image  = Image.CreateFilledRectangle(400, 4, 0.722, 0.376, 0.0, 1.0);
progress_bar.bg     = Image.CreateFilledRectangle(400, 4, 0.15,  0.15,  0.25, 1.0);
progress_bar_bg_sprite   = Sprite(progress_bar.bg);
progress_bar_sprite      = Sprite(progress_bar.image);
progress_bar_bg_sprite.SetX( Window.GetWidth() / 2 - 200);
progress_bar_bg_sprite.SetY( Window.GetHeight() / 2 + 60);
progress_bar_sprite.SetX(    Window.GetWidth() / 2 - 200);
progress_bar_sprite.SetY(    Window.GetHeight() / 2 + 60);
progress_bar_sprite.SetOpacity(0.0);

# ── Spinner ─────────────────────────────────────────────────────
spinner_image  = Image("spinner.png");
spinner_sprite = Sprite(spinner_image);
spinner_sprite.SetX(Window.GetWidth()  / 2 - spinner_image.GetWidth()  / 2);
spinner_sprite.SetY(Window.GetHeight() / 2 + spinner_image.GetHeight() + 15);
frame_count    = 0;
spin_angle     = 0;

# ── Password dialog ──────────────────────────────────────────────
dialog_image   = Image("dialog-background.png");
dialog_sprite  = Sprite();
dialog_sprite.SetOpacity(0.0);
prompt_sprite  = Sprite();
bullet_count   = 0;
MAX_BULLETS    = 15;
msg_sprite     = Sprite();

# ── Helpers ──────────────────────────────────────────────────────
fun fade_in(alpha) {
    alpha = Math.Clamp(Math.Int(alpha * 100), 0, 100) / 100;
    logo.sprite.SetOpacity(alpha);
    progress_bar_sprite.SetOpacity(alpha);
}

fun spin_update() {
    spin_angle = (spin_angle + 8) % 360;
    spinner_sprite.SetImage(spinner_image.Rotate(spin_angle * 0.01745));
}

fun refresh_callback() {
    frame_count++;
    if (frame_count < 50) {
        p = frame_count / 50.0;
        fade_in(p);
    }
    spin_update();
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Boot progress ────────────────────────────────────────────────
fun progress_callback(duration, progress) {
    if (progress == 1.0) {
        progress = 1.0;
    }
    bar_w = Math.Int(400 * progress);
    if (bar_w < 1) { bar_w = 1; }
    bar_img = Image.CreateFilledRectangle(bar_w, 4, 0.722, 0.376, 0.0, 1.0);
    progress_bar_sprite.SetImage(bar_img);
    progress_bar_sprite.SetOpacity(1.0);
}

Plymouth.SetBootProgressFunction(progress_callback);

# ── Quit (fade out on login screen) ─────────────────────────────
fun quit_callback() {
    logo.sprite.SetOpacity(1.0);
}

Plymouth.SetClientReturnFunction(quit_callback);

# ── Password prompt ─────────────────────────────────────────────
fun display_password_callback(prompt, bullets) {
    dialog_sprite.SetImage(dialog_image);
    dialog_sprite.SetX(Window.GetWidth()  / 2 - dialog_image.GetWidth()  / 2);
    dialog_sprite.SetY(Window.GetHeight() / 2 - dialog_image.GetHeight() / 2 + 40);
    dialog_sprite.SetOpacity(0.9);

    bullet_count = bullets;
    if (bullet_count > MAX_BULLETS) { bullet_count = MAX_BULLETS; }

    bullet_str = "";
    i = 0;
    while (i < bullet_count) {
        bullet_str += "●";
        i++;
    }
    msg_sprite.SetImage(Image.Text(bullet_str, 0.9, 0.75, 0.2, 1.0));
    msg_sprite.SetX(Window.GetWidth()  / 2 - 50);
    msg_sprite.SetY(Window.GetHeight() / 2 + 10);
    msg_sprite.SetOpacity(1.0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ── Message display ──────────────────────────────────────────────
fun message_callback(text) {
    msg_sprite.SetImage(Image.Text(text, 0.6, 0.7, 0.85, 1.0));
    msg_sprite.SetX(20);
    msg_sprite.SetY(Window.GetHeight() - 40);
    msg_sprite.SetOpacity(0.7);
}

Plymouth.SetMessageFunction(message_callback);
