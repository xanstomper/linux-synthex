#!/usr/bin/env python3
"""Synthex Theme Manager — switch between desktop themes.
Usage:
  synthex-theme list              — List available themes
  synthex-theme apply <name>      — Apply a theme
  synthex-theme current           — Show current theme
"""
import os, sys, subprocess, json

THEMES = {
    "graphite": {"name": "Synthex Graphite", "colors": "synthex-graphite", "wallpaper": "synthex-graphite.png", "accent": "#9BBD5C"},
    "frost":    {"name": "Synthex Frost",    "colors": "synthex-frost",    "wallpaper": "synthex-frost.png",    "accent": "#5B9BD5"},
    "midnight": {"name": "Synthex Midnight", "colors": "synthex-midnight", "wallpaper": "synthex-midnight.png", "accent": "#FFB300"},
    "mint":     {"name": "Synthex Mint",     "colors": "synthex-mint",     "wallpaper": "synthex-mint.png",     "accent": "#86C166"},
    "latte":    {"name": "Synthex Latte",    "colors": "synthex-latte",    "wallpaper": "synthex-latte.png",    "accent": "#D65D7A"},
}

CONFIG_DIR = os.path.expanduser("~/.config/synthex")
STATE_FILE = os.path.join(CONFIG_DIR, "current-theme.json")

def run(cmd):
    subprocess.run(cmd, capture_output=True, shell=True)

def apply(name):
    if name not in THEMES:
        print(f"Unknown theme: {name}")
        return
    t = THEMES[name]
    print(f"Applying {t['name']}...")
    run(f"plasma-apply-colorscheme {t['colors']} 2>/dev/null || true")
    run(f"plasma-apply-desktoptheme synthex-plasma-theme 2>/dev/null || true")
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump({"theme": name}, f)
    print(f"  Accent: {t['accent']}")
    print("  Logout and login to see full effect.")

def list_themes():
    cur = None
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            cur = json.load(f).get("theme")
    print("Available Synthex themes:")
    for name, t in THEMES.items():
        marker = ">" if name == cur else " "
        print(f"  {marker} {name:12} {t['name']:20} {t['accent']}")

def main():
    if len(sys.argv) < 2:
        list_themes()
        return
    cmd = sys.argv[1]
    if cmd == "list":
        list_themes()
    elif cmd == "apply" and len(sys.argv) >= 3:
        apply(sys.argv[2])
    elif cmd == "current":
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE) as f:
                print(f"Current: {json.load(f).get('theme', 'unknown')}")
        else:
            print("Current: none (default)")
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
