# Synthex Plasma Theme v1.0
# Based on the Synthex Brand Identity Guidelines
# Colour-coded for the Synthex Plasma edition (Amber accent)

# Widget Style
X-KDE-PluginInfo-Name=synthex-plasma
X-KDE-PluginInfo-ServiceTypes=KWin/Style
InitialPreference=10

# Plasma Theme Compatibility
[X-KDE-Plasma]
CompatibleVersions=6.0
