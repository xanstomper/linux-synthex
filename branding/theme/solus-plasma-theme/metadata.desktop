# Solus Plasma Theme v1.0
# Based on the Solus Brand Identity Guidelines
# Colour-coded for the Solus Plasma edition (Amber accent)

# Widget Style
X-KDE-PluginInfo-Name=solus-plasma
X-KDE-PluginInfo-ServiceTypes=KWin/Style
InitialPreference=10

# Plasma Theme Compatibility
[X-KDE-Plasma]
CompatibleVersions=6.0
