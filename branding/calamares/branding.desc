# ─── Solus Linux Calamares Branding Descriptor ────────────────────────
# This file defines the visual identity of the installer.
# Location: /usr/share/calamares/branding/solus/branding.desc
---
componentName: solus

strings:
  productName: "Solus Linux"
  shortProductName: "Solus"
  version: "2026.1"
  shortVersion: "2026.1"
  versionedName: "Solus Linux 2026.1"
  shortVersionedName: "Solus 2026.1"
  bootloaderEntryName: "Solus Linux"
  productUrl: "https://getsol.us"
  supportUrl: "https://discuss.getsol.us"
  bugUrl: "https://dev.getsol.us"

images:
  productLogo: "solus-logo.png"
  productIcon: "solus-icon.png"
  productWelcome: "solus-welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

style:
  SidebarBackground: "#1a1a2e"
  SidebarText: "#ffffff"
  SidebarTextCurrent: "#e94560"
  SidebarBackgroundCurrent: "#16213e"

colors:
  sidebarBackground: "#1a1a2e"
  sidebarText: "#ffffff"
  sidebarTextSelect: "#e94560"
  sidebarBackgroundSelect: "#16213e"
