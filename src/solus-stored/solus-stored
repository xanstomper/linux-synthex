                    {"id": "net.lutris.Lutris", "name": "Lutris", "source": "flatpak"},
                    {"id": "heroic", "name": "Heroic Launcher", "source": "flatpak"}
                ]},
                {"id": "development", "name": "Development", "icon": "💻", "apps": [
                    {"id": "com.visualstudio.code", "name": "VS Code", "source": "flatpak"},
                    {"id": "rust", "name": "Rust", "source": "rpm"},
                    {"id": "nodejs", "name": "Node.js", "source": "rpm"}
                ]},
                {"id": "internet", "name": "Internet", "icon": "🌐", "apps": [
                    {"id": "org.mozilla.firefox", "name": "Firefox", "source": "flatpak"},
                    {"id": "org.chromium.Chromium", "name": "Chromium", "source": "flatpak"}
                ]},
                {"id": "media", "name": "Media & Creativity", "icon": "🎨", "apps": [
                    {"id": "org.blender.Blender", "name": "Blender", "source": "flatpak"},
                    {"id": "org.kde.krita", "name": "Krita", "source": "flatpak"},
                    {"id": "com.obsproject.Studio", "name": "OBS Studio", "source": "flatpak"}
                ]}
            ]
        }


def run_daemon():
    """Run as daemon accepting commands via stdin/stdout JSON."""
    store = SoftwareStore()
    
    def signal_handler(sig, frame):
        print("\nShutting down...", file=sys.stderr)
        sys.exit(0)
    
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    print(f"☀️ Solus Software Store daemon v{VERSION}", file=sys.stderr)
    print("Listening for commands...", file=sys.stderr)
    
    # Simple JSON command protocol over stdin
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            cmd = json.loads(line)
            action = cmd.get("action", "")
            
            if action == "search":
                result = store.search(cmd.get("query", ""))
            elif action == "install":
                if cmd.get("source") == "flatpak":
                    result = store.install_flatpak(cmd.get("id", ""))
                else:
                    result = store.install_rpm(cmd.get("id", ""))
            elif action == "remove":
                if cmd.get("source") == "flatpak":
                    result = store.remove_flatpak(cmd.get("id", ""))
                else:
                    result = store.remove_rpm(cmd.get("id", ""))
            elif action == "check-updates":
                result = store.check_updates()
            elif action == "install-updates":
                result = store.install_updates()
            elif action == "categories":
                result = store.get_categories()
            elif action == "ping":
                result = {"pong": True, "version": VERSION}
            else:
                result = {"error": f"Unknown action: {action}"}
            
            print(json.dumps(result))
            sys.stdout.flush()
        except json.JSONDecodeError:
            print(json.dumps({"error": "Invalid JSON"}))
            sys.stdout.flush()


def main():
    if "--version" in sys.argv:
        print(f"Solus Software Store v{VERSION}")
        return
    
    run_daemon()


if __name__ == "__main__":
    main()
