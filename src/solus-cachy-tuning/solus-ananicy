#!/usr/bin/env bash
# solus-ananicy — Ananicy (Auto-Nice) daemon wrapper for Solus
# CachyOS-style auto-nice daemon that prioritizes gaming/media/desktop processes
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
RULES_DIR="${HERE%/src/*}/src/solus-cachy-tuning/ananicy-rules"
STATE_DIR="/var/lib/solus/ananicy"
PIDFILE="/run/solus-ananicy.pid"

ensure_dirs() { mkdir -p "$STATE_DIR"; }

cmd_start() {
    ensure_dirs
    echo "⚡ Starting Solus Ananicy (auto-nice daemon)..."
    # Use ananicy-cpp if available, otherwise built-in Python fallback
    if command -v ananicy-cpp &>/dev/null; then
        exec ananicy-cpp --rules "$RULES_DIR" "$@"
    fi
    # Python fallback — simple nice-level manager
    exec python3 -c "
import os, time, json, subprocess, signal, sys

RULES = '$RULES_DIR'
PIDFILE = '$PIDFILE'
STATE = '$STATE_DIR'

def load_rules():
    rules = {}
    rules_dir = os.path.join(RULES)
    if os.path.exists(rules_dir):
        for f in os.listdir(rules_dir):
            if f.endswith('.conf') or f.endswith('.rules'):
                for line in open(os.path.join(rules_dir, f)):
                    if 'name=' in line:
                        name = line.split('name=')[1].split()[0].strip('\"')
                        nice = int(line.split('nice=')[1].split()[0].strip('\"')) if 'nice=' in line else 0
                        rules[name] = nice
    return rules

def adjust_pids(rules):
    for proc in os.listdir('/proc'):
        if not proc.isdigit(): continue
        try:
            with open(f'/proc/{proc}/comm') as f:
                comm = f.read().strip()
            if comm in rules:
                target = rules[comm]
                current = os.getpriority(os.PRIO_PROCESS, int(proc))
                if current != target:
                    os.setpriority(os.PRIO_PROCESS, int(proc), target)
        except: pass

rules = load_rules()
with open(PIDFILE, 'w') as f: f.write(str(os.getpid()))
print(f'Solus Ananicy running ({len(rules)} rules)')
while True:
    adjust_pids(rules)
    time.sleep(5)
" &
    echo $! > "$PIDFILE"
    echo "✅ Ananicy started (PID $(cat $PIDFILE))"
}

cmd_stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
        echo "⏹  Ananicy stopped"
    else
        echo "Not running"
    fi
}

cmd_status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "✅ Ananicy running (PID $(cat $PIDFILE))"
    else
        echo "⏹  Ananicy not running"
    fi
}

case "${1:-help}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_stop; sleep 1; cmd_start ;;
    status)  cmd_status ;;
    *) echo "Usage: solus-ananicy [start|stop|restart|status]"; exit 1 ;;
esac
