class AppManagerWindow(Adw.ApplicationWindow):
    def __init__(self, app, **kw):
        super().__init__(application=app, title="SynthOS App Manager",
                         default_width=960, default_height=700, **kw)

        self._selected_category = "Browsers"
        self._search_query      = ""
        self._selected_apps: list[str] = []

        # ── Root layout ───────────────────────────────────────────────────────
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_content(root)

        # ── Header bar ────────────────────────────────────────────────────────
        hb = Adw.HeaderBar()
        hb.set_title_widget(Gtk.Label(label="SynthOS App Manager"))
        root.append(hb)

        # Search button
        search_btn = Gtk.ToggleButton(icon_name="system-search-symbolic")
        search_btn.connect("toggled", self._on_search_toggled)
        hb.pack_end(search_btn)

        # Install selected button
        self._install_btn = Gtk.Button(label="Install Selected (0)")
        self._install_btn.add_css_class("suggested-action")
        self._install_btn.connect("clicked", self._on_install_selected)
        self._install_btn.set_sensitive(False)
        hb.pack_end(self._install_btn)

        # Search bar
        self._search_bar = Gtk.SearchBar()
        self._search_entry = Gtk.SearchEntry()
        self._search_entry.set_hexpand(True)
        self._search_entry.connect("search-changed", self._on_search_changed)
        self._search_bar.set_child(self._search_entry)
        self._search_bar.connect_entry(self._search_entry)
        root.append(self._search_bar)
        search_btn.bind_property("active", self._search_bar, "search-mode-enabled",
                                 GLib.BindingFlags.BIDIRECTIONAL)

        # ── Body: sidebar + content ───────────────────────────────────────────
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_vexpand(True)
        root.append(body)

        # Category sidebar
        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scroll.set_size_request(180, -1)

        sidebar_list = Gtk.ListBox()
        sidebar_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sidebar_list.add_css_class("navigation-sidebar")
        sidebar_list.connect("row-selected", self._on_category_selected)
        sidebar_scroll.set_child(sidebar_list)
        body.append(sidebar_scroll)

        sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        body.append(sep)

        # Populate sidebar
        for cat in CATALOGUE:
            row = Gtk.ListBoxRow()
            row._category = cat
            lbl = Gtk.Label(label=cat, xalign=0)
            lbl.set_margin_start(12); lbl.set_margin_end(12)
            lbl.set_margin_top(8);   lbl.set_margin_bottom(8)
            row.set_child(lbl)
            sidebar_list.append(row)

        # Select first category
        sidebar_list.select_row(sidebar_list.get_row_at_index(0))

        # App list
        content_scroll = Gtk.ScrolledWindow()
        content_scroll.set_hexpand(True)
        content_scroll.set_vexpand(True)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content_box.set_margin_start(16); content_box.set_margin_end(16)
        content_box.set_margin_top(16);  content_box.set_margin_bottom(16)

        self._category_label = Gtk.Label(label="Browsers")
        self._category_label.add_css_class("title-2")
        self._category_label.set_xalign(0)
        self._category_label.set_margin_bottom(8)
        content_box.append(self._category_label)

        self._app_list = Gtk.ListBox()
        self._app_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self._app_list.add_css_class("boxed-list")
        content_box.append(self._app_list)
        content_scroll.set_child(content_box)
        body.append(content_scroll)

        # ── Status bar ────────────────────────────────────────────────────────
        status_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                             margin_start=12, margin_end=12, margin_top=4, margin_bottom=4)
        self._status_lbl = Gtk.Label(label="Ready", xalign=0)
        self._status_lbl.add_css_class("dim-label")
        self._status_lbl.add_css_class("caption")
        status_bar.append(self._status_lbl)
        root.append(status_bar)

        # Initial population
        self._populate_apps("Browsers")

    # ── Event handlers ────────────────────────────────────────────────────────
    def _on_search_toggled(self, btn):
        pass

    def _on_search_changed(self, entry):
        self._search_query = entry.get_text().lower()
        self._populate_apps(self._selected_category)

    def _on_category_selected(self, listbox, row):
        if row:
            cat = row._category
            self._selected_category = cat
            self._category_label.set_label(cat)
            self._populate_apps(cat)

    def _populate_apps(self, category: str):
        # Clear existing rows
        while True:
            row = self._app_list.get_row_at_index(0)
            if row is None:
                break
            self._app_list.remove(row)

        apps = CATALOGUE.get(category, [])
        q    = self._search_query

        for app in apps:
            if q and q not in app["name"].lower() and q not in app["desc"].lower():
                continue
            row = AppRow(app)
            # Checkbox for bulk install
            chk = Gtk.CheckButton()
            chk.set_valign(Gtk.Align.CENTER)
            chk._app_id = app["id"]
            chk.connect("toggled", self._on_app_toggled)
            row.add_prefix(chk)
            self._app_list.append(row)

        count = self._app_list.get_row_at_index(0) is not None
        self._status_lbl.set_label(f"{category} — {len(apps)} apps available")

    def _on_app_toggled(self, chk):
        aid = chk._app_id
        if chk.get_active():
            if aid not in self._selected_apps:
                self._selected_apps.append(aid)
        else:
            self._selected_apps = [x for x in self._selected_apps if x != aid]

        n = len(self._selected_apps)
        self._install_btn.set_label(f"Install Selected ({n})")
        self._install_btn.set_sensitive(n > 0)

    def _on_install_selected(self, _btn):
        if not self._selected_apps:
            return
        # Install all selected in background
        def run():
            for app_id in self._selected_apps:
                # Find source
                for cat in CATALOGUE.values():
                    for a in cat:
                        if a["id"] == app_id:
                            try:
                                if a["source"] == "flatpak":
                                    subprocess.run(
                                        ["flatpak", "install", "-y", "--noninteractive", "flathub", app_id],
                                        check=True, timeout=300
                                    )
                                elif a["source"] == "dnf":
                                    subprocess.run(
                                        ["pkexec", "dnf", "install", "-y", app_id],
                                        check=True, timeout=300
                                    )
                            except Exception as e:
                                GLib.idle_add(self._set_status, f"Error installing {app_id}: {e}")
            GLib.idle_add(self._set_status, "Installation complete!")

        self._install_btn.set_sensitive(False)
        self._set_status("Installing selected apps…")
        threading.Thread(target=run, daemon=True).start()

    def _set_status(self, msg: str):
        self._status_lbl.set_label(msg)
        return False


# ─────────────────────────────────────────────────────────────────────────────
class AppManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.connect("activate", self._on_activate)

    def _on_activate(self, _app):
        win = AppManagerWindow(self)
        win.present()


