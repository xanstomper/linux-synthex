# ─────────────────────────────────────────────────────────────────────────────
class AppRow(Adw.ActionRow):
    def __init__(self, app_data: dict, **kw):
        super().__init__(
            title    = app_data["name"],
            subtitle = app_data["desc"],
            **kw
        )
        self._data = app_data

        # Source badge
        badge = Gtk.Label(label=app_data["source"].upper())
        badge.add_css_class("dim-label")
        badge.add_css_class("caption")
        badge.set_valign(Gtk.Align.CENTER)
        self.add_suffix(badge)

        # Status / install button
        self._btn = Gtk.Button(valign=Gtk.Align.CENTER)
        self._btn.connect("clicked", self._on_clicked)
        self.add_suffix(self._btn)
        self._refresh_status()

    def _refresh_status(self):
        installed = self._check_installed()
        if installed:
            self._btn.set_label("✓ Installed")
            self._btn.add_css_class("success")
            self._btn.remove_css_class("suggested-action")
        else:
            self._btn.set_label("Install")
            self._btn.add_css_class("suggested-action")
            self._btn.remove_css_class("success")

    def _check_installed(self) -> bool:
        d = self._data
        try:
            if d["source"] == "flatpak":
                r = subprocess.run(["flatpak", "info", d["id"]],
                                   capture_output=True, timeout=5)
                return r.returncode == 0
            elif d["source"] == "dnf":
                r = subprocess.run(["rpm", "-q", d["id"]],
                                   capture_output=True, timeout=5)
                return r.returncode == 0
        except Exception:
            pass
        return False

    def _on_clicked(self, _btn):
        installed = self._check_installed()
        if installed:
            self._show_manage_menu()
        else:
            self._install()

    def _install(self):
        self._btn.set_label("Installing…")
        self._btn.set_sensitive(False)

        def run():
            d = self._data
            try:
                if d["source"] == "flatpak":
                    subprocess.run(
                        ["flatpak", "install", "-y", "--noninteractive", "flathub", d["id"]],
                        check=True, timeout=300
                    )
                elif d["source"] == "dnf":
                    subprocess.run(
                        ["pkexec", "dnf", "install", "-y", d["id"]],
                        check=True, timeout=300
                    )
                GLib.idle_add(self._on_install_done, True)
            except Exception as e:
                GLib.idle_add(self._on_install_done, False)

        threading.Thread(target=run, daemon=True).start()

    def _on_install_done(self, success: bool):
        self._btn.set_sensitive(True)
        self._refresh_status()
        return False

    def _show_manage_menu(self):
        menu = Gtk.PopoverMenu.new_from_model(Gio.Menu())
        # Simplified — real impl would use a proper menu
        print(f"Manage {self._data['name']}")


