#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# synthex-aegis — Synthex Aegis Security Center launcher (GUI)
# Works both from an installed system (/usr/lib/synthex/aegis) and from a
# source checkout (next to this script).
if [ -f /usr/lib/synthex/aegis/aegis_gui.py ]; then
    exec python3 /usr/lib/synthex/aegis/aegis_gui.py "$@"
fi
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
exec python3 "$DIR/aegis_gui.py" "$@"
