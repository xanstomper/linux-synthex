#!/usr/bin/env python3
"""Synthex Snapshot Manager — BTRFS snapshot management.
Like Timeshift, but native BTRFS CLI.

Usage:
    synthex-timeshift                  Show snapshot list
    synthex-timeshift create <desc>    Create snapshot
    synthex-timeshift list             List snapshots
    synthex-timeshift restore <id>     Restore snapshot
    synthex-timeshift delete <id>      Delete snapshot
"""
import os, sys, subprocess, json, datetime

SNAPPER_CONFIG = "root"

def run_snapper(*args):
    try:
        r = subprocess.run(["snapper", "-c", SNAPPER_CONFIG] + list(args),
                          capture_output=True, text=True, timeout=30)
        return r.stdout, r.stderr, r.returncode
    except FileNotFoundError:
        return "", "snapper not installed", 127
    except subprocess.TimeoutExpired:
        return "", "timeout", 124

def cmd_list():
    out, err, code = run_snapper("list")
    if code != 0:
        print(f"❌ snapper error: {err[:200]}")
        print("   Install: sudo dnf install snapper && sudo snapper -c root create-config /")
        return
    print("📸 Synthex Snapshot Manager")
    print("═" * 60)
    if out.strip():
        print(out)
    else:
        print("No snapshots found")
    print()
    print("  Commands: create <desc>, restore <id>, delete <id>")

def cmd_create(desc):
    out, err, code = run_snapper("create", "-d", desc or f"manual-{datetime.date.today()}")
    if code == 0:
        print(f"✅ Snapshot created: {desc}")
    else:
        print(f"❌ Failed: {err[:200]}")

def cmd_restore(snap_id):
    print(f"🔄 Restoring snapshot #{snap_id}...")
    confirm = input(f"Type 'RESTORE' to revert to snapshot #{snap_id}: ")
    if confirm != "RESTORE":
        print("Aborted.")
        return
    out, err, code = run_snapper("undochange", f"{snap_id}..0")
    if code == 0:
        print(f"✅ Snapshot #{snap_id} restored. Reboot recommended.")
    else:
        print(f"❌ Failed: {err[:200]}")

def cmd_delete(snap_id):
    print(f"🗑️  Deleting snapshot #{snap_id}...")
    confirm = input(f"Delete snapshot #{snap_id}? (y/N): ")
    if confirm.lower() != "y":
        print("Aborted.")
        return
    out, err, code = run_snapper("delete", snap_id)
    if code == 0:
        print(f"✅ Snapshot #{snap_id} deleted")
    else:
        print(f"❌ Failed: {err[:200]}")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("list", "-h", "--help"):
        cmd_list()
        return
    cmd = sys.argv[1]
    if cmd == "create":
        desc = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else f"manual-{datetime.date.today()}"
        cmd_create(desc)
    elif cmd == "restore" and len(sys.argv) >= 3:
        cmd_restore(sys.argv[2])
    elif cmd == "delete" and len(sys.argv) >= 3:
        cmd_delete(sys.argv[2])
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
