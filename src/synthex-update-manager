#!/usr/bin/env python3
"""
Synthex Update Manager — safe system update tool
Mint-style update management for Synthex.

Usage:
    synthex-update check        — Check for available updates
    synthex-update list         — List available updates
    synthex-update install      — Install all updates
    synthex-update schedule     — View/set auto-update schedule
"""
import os, sys, subprocess, json, datetime

UPDATE_CACHE = "/var/cache/synthex/updates.json"
CONFIG = "/etc/synthex/update-manager.conf"

def log(msg): print(f"[updates] {msg}")

def dnf_check():
    """Check for DNF updates"""
    try:
        r = subprocess.run(["dnf", "check-update", "--quiet"], capture_output=True, text=True, timeout=120)
        updates = []
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 3 and not parts[0].startswith("."):
                updates.append({"name": parts[0], "version": parts[1], "repo": parts[2]})
        return updates
    except subprocess.TimeoutExpired:
        log("DNF check timed out")
        return []
    except FileNotFoundError:
        return []

def flatpak_check():
    """Check for Flatpak updates"""
    try:
        r = subprocess.run(["flatpak", "remote-ls", "--updates", "--columns=name,application", "--system"],
                          capture_output=True, text=True, timeout=60)
        updates = []
        for line in r.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and not parts[0].startswith("Name"):
                updates.append({"name": parts[0].strip(), "app": parts[1].strip()})
        return updates
    except: return []

def check():
    print("🔍 Checking for updates...")
    dnf_updates = dnf_check()
    flatpak_updates = flatpak_check()
    
    total = len(dnf_updates) + len(flatpak_updates)
    
    # Cache results
    os.makedirs(os.path.dirname(UPDATE_CACHE), exist_ok=True)
    with open(UPDATE_CACHE, "w") as f:
        json.dump({
            "timestamp": datetime.datetime.now().isoformat(),
            "dnf": dnf_updates,
            "flatpak": flatpak_updates,
            "total": total
        }, f)
    
    print(f"\n📦 Updates available: {total}")
    if dnf_updates:
        print(f"\n  System packages: {len(dnf_updates)}")
        for u in dnf_updates[:5]:
            print(f"    • {u['name']}: {u['version']}")
        if len(dnf_updates) > 5:
            print(f"    ... and {len(dnf_updates)-5} more")
    if flatpak_updates:
        print(f"\n  Flatpak apps: {len(flatpak_updates)}")
        for u in flatpak_updates[:3]:
            print(f"    • {u['name']}")
        if len(flatpak_updates) > 3:
            print(f"    ... and {len(flatpak_updates)-3} more")
    return total

def list_updates():
    if not os.path.exists(UPDATE_CACHE):
        print("No update cache. Run 'synthex-update check' first.")
        return
    with open(UPDATE_CACHE) as f:
        data = json.load(f)
    print(f"Last checked: {data['timestamp']}")
    print(f"Total updates: {data['total']}")
    for u in data['dnf']:
        print(f"  [system] {u['name']}: {u['version']} ({u['repo']})")
    for u in data['flatpak']:
        print(f"  [flatpak] {u['name']} ({u['app']})")

def install():
    updates = check()
    if updates == 0:
        print("✅ System is up to date!")
        return
    
    print(f"\n📥 Installing {updates} updates...")
    
    # Create snapshot before update
    log("Creating pre-update snapshot...")
    subprocess.run(["snapper", "-c", "root", "create", "-d", "pre-update"], 
                  capture_output=True, timeout=30)
    
    # Install DNF updates
    dnf_count = 0
    try:
        r = subprocess.run(["dnf", "upgrade", "-y", "--refresh"], capture_output=True, text=True, timeout=600)
        if "Complete!" in r.stdout:
            dnf_count = r.stdout.count("Upgraded:") + r.stdout.count("Installed:")
        log("DNF updates installed")
    except subprocess.TimeoutExpired:
        log("DNF upgrade timed out")
    
    # Install Flatpak updates
    try:
        r = subprocess.run(["flatpak", "update", "-y", "--system"], capture_output=True, text=True, timeout=600)
        log("Flatpak updates installed")
    except: pass
    
    print(f"\n✅ Update complete!")
    print(f"   Snapshot created: pre-update")

def schedule():
    config = {"auto_check": True, "auto_download": False, "interval_hours": 24}
    if os.path.exists(CONFIG):
        with open(CONFIG) as f:
            config.update(json.loads(f.read()))
    print("Update Schedule:")
    print(f"  Auto-check: {'✅' if config['auto_check'] else '❌'}")
    print(f"  Auto-download: {'✅' if config['auto_download'] else '❌'}")
    print(f"  Check interval: every {config['interval_hours']} hours")

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("install",) and os.geteuid() != 0:
        print("Installing updates requires root. Re-run with sudo.")
        sys.exit(1)
    cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
    {"check": check, "list": list_updates, "install": install, "schedule": schedule}.get(cmd, check)()
