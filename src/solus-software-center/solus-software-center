#!/usr/bin/env bash
# solus-software-center — QML application launcher
# Launches the Software Center with qmlscene or native binary
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
QML_MAIN="$HERE/ui/Main.qml"

# Try native binary first, fall back to qmlscene
if command -v solus-software-center-bin &>/dev/null; then
    exec solus-software-center-bin "$@"
fi

if command -v qmlscene &>/dev/null; then
    exec qmlscene "$QML_MAIN" "$@"
fi

if command -v qml6 &>/dev/null; then
    exec qml6 "$QML_MAIN" "$@"
fi

echo "Solus Software Center"
echo "QML runtime not found. Install qt6-qtdeclarative or compile the native binary."
echo "Source: $QML_MAIN"
exit 1
