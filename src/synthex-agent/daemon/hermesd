# ═══ AI Provider Layer ══════════════════════════════════════════════

class AIProvider:
    """Universal model provider — switch models with a UI selection."""
    def __init__(self, config):
        self.config = config
    
    def chat(self, messages, timeout=120):
        prov = self.config["model"]["provider"]
        model = self.config["model"]["model"]
        cfg = self.config["providers"].get(prov, {})
        base = cfg.get("base_url", ""); key = cfg.get("api_key", "")
        
        import urllib.request
        url = f"{base.rstrip('/')}/chat/completions"
        body = json.dumps({"model": model, "messages": messages, "stream": False,
                          "temperature": self.config["model"]["temperature"],
                          "max_tokens": self.config["model"]["max_tokens"]}).encode()
        headers = {"Content-Type": "application/json"}
        if key: headers["Authorization"] = f"Bearer {key}"
        try:
            req = urllib.request.Request(url, data=body, headers=headers)
            resp = urllib.request.urlopen(req, timeout=timeout)
            data = json.loads(resp.read())
            text = data.get("choices", [{}])[0].get("message", {}).get("content", "")
            return {"response": text}
        except Exception as e:
            return {"error": str(e)}


# ═══ Distro-Specific Toolchain ══════════════════════════════════════

class DistroTools:
    """Distro-specific tools that Hermes can invoke.
    Knows how to: install packages, update system, rollback, configure
    NVIDIA/AMD/gaming, manage Flatpaks, read logs, explain errors.
    """
    
    @staticmethod
    def install_package(name):
        try:
            r = subprocess.run(["sudo", "dnf", "install", "-y", name], capture_output=True, text=True, timeout=120)
            return {"ok": r.returncode == 0, "output": r.stdout[-500:], "error": r.stderr[-200:]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def remove_package(name):
        try:
            r = subprocess.run(["sudo", "dnf", "remove", "-y", name], capture_output=True, text=True, timeout=120)
            return {"ok": r.returncode == 0, "output": r.stdout[-500:]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def search_package(query):
        try:
            r = subprocess.run(["dnf", "search", query], capture_output=True, text=True, timeout=30)
            lines = [l for l in r.stdout.splitlines() if l.strip() and not l.startswith(("==", "Last"))][:20]
            return {"results": lines}
        except Exception as e: return {"error": str(e)}
    
    @staticmethod
    def system_update():
        try:
            r = subprocess.run(["sudo", "dnf", "update", "-y"], capture_output=True, text=True, timeout=600)
            return {"ok": r.returncode == 0, "output": r.stdout[-500:]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def system_upgrade():
        try:
            r = subprocess.run(["sudo", "dnf", "upgrade", "--refresh", "-y"], capture_output=True, text=True, timeout=600)
            return {"ok": r.returncode == 0, "output": r.stdout[-500:]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def check_updates():
        try:
            r = subprocess.run(["dnf", "check-update"], capture_output=True, text=True, timeout=60)
            if r.returncode == 0: return {"updates": 0}
            count = len([l for l in r.stdout.splitlines() if l.strip() and not l.startswith(("Last", "Upgraded"))])
            return {"updates": count, "list": r.stdout[:1000]}
        except: return {"updates": 0}
    
    @staticmethod
    def install_nvidia():
        try:
            cmds = [
                ["sudo", "dnf", "install", "-y", "akmod-nvidia", "nvidia-driver", "nvidia-settings", "nvidia-prime"],
                ["sudo", "bash", "-c", "echo 'options nvidia-drm modeset=1' > /etc/modprobe.d/nvidia.conf"],
            ]
            for c in cmds:
                r = subprocess.run(c, capture_output=True, text=True, timeout=120)
                if r.returncode != 0: return {"ok": False, "error": r.stderr[:200]}
            return {"ok": True, "message": "NVIDIA drivers installed. Reboot to apply."}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def install_amd():
        try:
            r = subprocess.run(["sudo", "dnf", "install", "-y", "mesa-dri-drivers", "mesa-vulkan-drivers",
                               "mesa-va-drivers", "libva-utils"], capture_output=True, text=True, timeout=120)
            return {"ok": r.returncode == 0, "message": "AMD drivers updated"}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def gaming_mode(enable=True):
        if enable:
            subprocess.run(["sudo", "sysctl", "-w", "vm.swappiness=10"], capture_output=True)
            subprocess.run(["sudo", "sysctl", "-w", "vm.max_map_count=2147483642"], capture_output=True)
            open("/tmp/synthex-gaming-mode", "w").close()
            return {"ok": True, "message": "🎮 Gaming mode ON"}
        else:
            subprocess.run(["sudo", "sysctl", "-w", "vm.swappiness=60"], capture_output=True)
            if os.path.exists("/tmp/synthex-gaming-mode"): os.remove("/tmp/synthex-gaming-mode")
            return {"ok": True, "message": "Gaming mode OFF"}
    
    @staticmethod
    def flatpak_install(app_id):
        try:
            r = subprocess.run(["flatpak", "install", "-y", app_id], capture_output=True, text=True, timeout=120)
            return {"ok": r.returncode == 0, "output": r.stdout[-300:]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def flatpak_search(query):
        try:
            r = subprocess.run(["flatpak", "search", query], capture_output=True, text=True, timeout=30)
            lines = [l for l in r.stdout.splitlines() if l.strip()][:15]
            return {"results": lines}
        except Exception as e: return {"error": str(e)}
    
    @staticmethod
    def service_list():
        try:
            r = subprocess.run(["systemctl", "list-units", "--type=service", "--no-pager"], capture_output=True, text=True, timeout=15)
            lines = [l for l in r.stdout.splitlines() if l.strip()][:25]
            return {"services": lines}
        except Exception as e: return {"error": str(e)}
    
    @staticmethod
    def service_action(action, name):
        try:
            r = subprocess.run(["sudo", "systemctl", action, name], capture_output=True, text=True, timeout=30)
            return {"ok": r.returncode == 0, "output": r.stdout[:200]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def read_logs(unit=None, lines=50):
        try:
            cmd = ["journalctl", "--no-pager", "-n", str(lines)]
            if unit: cmd += ["-u", unit]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            return {"logs": r.stdout}
        except Exception as e: return {"error": str(e)}
    
    @staticmethod
    def snapshot_create(desc=""):
        try:
            r = subprocess.run(["sudo", "snapper", "-c", "root", "create", "-d", desc or "hermes-auto"],
                              capture_output=True, text=True, timeout=30)
            return {"ok": r.returncode == 0, "output": r.stdout[:200]}
        except Exception as e: return {"ok": False, "error": str(e)}
    
    @staticmethod
    def snapshot_list():
        try:
            r = subprocess.run(["snapper", "-c", "root", "list"], capture_output=True, text=True, timeout=15)
            return {"snapshots": r.stdout}
        except Exception as e: return {"error": str(e)}
    
    @staticmethod
    def system_info():
        return {
            "os": platform.freedesktop_os_release().get("NAME", "Linux"),
            "kernel": platform.release(), "hostname": platform.node(),
            "cpu": platform.processor() or "?", "cores": os.cpu_count(),
            "desktop": os.environ.get("XDG_CURRENT_DESKTOP", "?"),
            "session": os.environ.get("XDG_SESSION_TYPE", "?"),
        }


# ═══ Agent Engine ═══════════════════════════════════════════════════

class AgentEngine:
    """Core agent that processes requests using tools + AI."""
    
    def __init__(self, provider, config):
        self.provider = provider
        self.config = config
        self.distro = DistroTools()
        self.tools = self._build_tools()
    
    def _build_tools(self):
        return {
            "install_package": self.distro.install_package,
            "remove_package": self.distro.remove_package,
            "search_package": self.distro.search_package,
            "system_update": self.distro.system_update,
            "system_upgrade": self.distro.system_upgrade,
            "check_updates": self.distro.check_updates,
            "install_nvidia": self.distro.install_nvidia,
            "install_amd": self.distro.install_amd,
            "gaming_mode": self.distro.gaming_mode,
            "flatpak_install": self.distro.flatpak_install,
            "flatpak_search": self.distro.flatpak_search,
            "service_list": self.distro.service_list,
            "service_action": self.distro.service_action,
            "read_logs": self.distro.read_logs,
            "snapshot_create": self.distro.snapshot_create,
            "snapshot_list": self.distro.snapshot_list,
            "system_info": self.distro.system_info,
        }
    
    def process(self, query, context=None, permission="interactive"):
        """Process a natural language query. Returns plan + result."""
        system = """You are Hermes, the built-in AI assistant for Synthex Linux.
You are part of the operating system — like Windows Copilot for Linux.
You have deep knowledge of the distro and can control it.

When the user asks you to DO something:
1. First explain what you plan to do
2. Wait for approval (in interactive mode)
3. Execute using your tools
4. Report the result

Available tools: """ + ", ".join(self.tools.keys()) + """

Respond in this format when action is needed:
PLAN: What you intend to do
TOOL: tool_name | arg1=val1 | arg2=val2
RESULT: What happened

For questions without actions, just answer helpfully."""
        
        messages = [{"role": "system", "content": system}]
        if context:
            for c in context.get("recent", [])[-10:]:
                messages.append({"role": c["role"], "content": c["content"]})
        messages.append({"role": "user", "content": query})
        
        result = self.provider.chat(messages)
        if "error" in result:
            return {"response": f"⚠️ {result['error']}", "plan": None, "tool": None}
        
        response = result.get("response", "")
        
        # Parse tool call
        import re
        tool_match = re.search(r'TOOL:\s*(\w+)\s*(?:\|.*)?', response)
        plan_match = re.search(r'PLAN:\s*(.+?)(?:\n|$)', response)
        
        plan = plan_match.group(1).strip() if plan_match else None
        tool_name = tool_match.group(1) if tool_match else None
        
        tool_result = None
        if tool_name and tool_name in self.tools:
            if permission == "interactive":
                return {"response": response, "plan": plan, "tool": tool_name, "needs_approval": True}
            elif permission == "trusted":
                tool_result = self.tools[tool_name]()
                response += f"\n\n✅ Done: {json.dumps(tool_result)[:300]}"
            # read-only: don't execute
        
        return {"response": response, "plan": plan, "tool": tool_name, "result": tool_result}
    
    def execute_tool(self, tool_name, args=None):
        if tool_name in self.tools:
            try:
                return self.tools[tool_name](**(args or {}))
            except Exception as e:
                return {"ok": False, "error": str(e)}
        return {"ok": False, "error": f"Unknown tool: {tool_name}"}


# ═══ Memory System ══════════════════════════════════════════════════

class MemorySystem:
    def __init__(self):
        self.data = self._load()
    def _load(self):
        if MEMORY_FILE.exists():
            try: return json.loads(MEMORY_FILE.read_text())
            except: pass
        return {"conversations": [], "facts": [], "preferences": {}, "skills": []}
    def _save(self):
        MEMORY_FILE.write_text(json.dumps(self.data, indent=2))
    def add(self, role, content):
        self.data["conversations"].append({"role": role, "content": content, "ts": time.time()})
        self.data["conversations"] = self.data["conversations"][-200:]
        self._save()
    def context(self):
        return {"recent": self.data["conversations"][-20:], "facts": self.data["facts"][-10:]}


# ═══ Skills System ══════════════════════════════════════════════════

class SkillsSystem:
    """Hermes skills — reusable task workflows."""
    def __init__(self):
        self.skills = self._load()
    def _load(self):
        if SKILLS_FILE.exists():
            try: return json.loads(SKILLS_FILE.read_text())
            except: pass
        return {"skills": []}
    def _save(self):
        SKILLS_FILE.write_text(json.dumps(self.skills, indent=2))
    def add(self, name, prompt, category="general"):
        self.skills["skills"].append({"name": name, "prompt": prompt, "category": category, "created": time.time()})
        self._save()
    def list(self):
        return self.skills.get("skills", [])


# ═══ D-Bus Service ═════════════════════════════════════════════════

class HermesDaemon(dbus.service.Object):
    """The core daemon — Hermes OS Agent."""
    
    def __init__(self, bus, path):
        super().__init__(bus, path)
        self.config = load_config()
        self.provider = AIProvider(self.config)
        self.engine = AgentEngine(self.provider, self.config)
        self.memory = MemorySystem()
        self.skills = SkillsSystem()
        self._status = "ready"  # ready | thinking | working | needs_permission
        self._pending_tool = None
        self._pending_args = None
        
        print(f"🧠 Synthex Hermes daemon running on {BUS_NAME}")
        print(f"   Model: {self.config['model']['provider']}/{self.config['model']['model']}")
    
    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def Chat(self, query):
        """Process a chat message. Returns JSON with response + plan."""
        context = self.memory.context()
        perm = self.config["permissions"].get("default", "interactive")
        result = self.engine.process(query, context, perm)
        self.memory.add("user", query)
        self.memory.add("assistant", result.get("response", ""))
        
        if result.get("needs_approval"):
            self._status = "needs_permission"
            self._pending_tool = result.get("tool")
            self._pending_args = None
        
        return json.dumps(result)
    
    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def CodeAction(self, request):
        """Code generation/refactoring request. Takes JSON: {task, code, path}."""
        try:
            r = json.loads(request) if isinstance(request, str) else request
        except: r = {"task": request, "code": "", "path": ""}
        task = r.get("task", "")
        code = r.get("code", "")
        path = r.get("path", "")
        
        prompt = f"File: {path}\n\n```\n{code[:3000]}\n```\n\nTask: {task}"
        result = self.engine.process(prompt, permission="trusted")
        self.memory.add("user", f"Code: {task}")
        self.memory.add("assistant", result.get("response", ""))
        return json.dumps({"response": result.get("response", "")})
    
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ApproveAction(self, tool_name):
        """Approve a pending tool execution."""
        tool = tool_name or self._pending_tool
        if not tool:
            return json.dumps({"error": "No pending action"})
        result = self.engine.execute_tool(tool)
        self._status = "ready"
        self._pending_tool = None
        return json.dumps({"approved": True, "result": result})
    
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def GetPendingAction(self):
        """Get the pending action description."""
        if self._pending_tool:
            return json.dumps({"tool": self._pending_tool, "status": self._status})
        return json.dumps({"tool": None})
    
    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def QuickCommand(self, category, query):
        """Quick distro commands: install, update, nvidia, amd, gaming, flatpak, logs, doctor."""
        if category == "install": r = DistroTools.install_package(query)
        elif category == "remove": r = DistroTools.remove_package(query)
        elif category == "search": r = DistroTools.search_package(query)
        elif category == "update": r = DistroTools.system_update()
        elif category == "upgrade": r = DistroTools.system_upgrade()
        elif category == "check-updates": r = DistroTools.check_updates()
        elif category == "nvidia": r = DistroTools.install_nvidia()
        elif category == "amd": r = DistroTools.install_amd()
        elif category == "gaming": r = DistroTools.gaming_mode(query != "off")
        elif category == "flatpak-install": r = DistroTools.flatpak_install(query)
        elif category == "flatpak-search": r = DistroTools.flatpak_search(query)
        elif category == "services": r = DistroTools.service_list()
        elif category == "service":
            parts = query.split(" ", 1)
            r = DistroTools.service_action(parts[0], parts[1]) if len(parts) == 2 else {"error": "usage: start|stop|restart <name>"}
        elif category == "logs": r = DistroTools.read_logs(query or None)
        elif category == "snapshot": r = DistroTools.snapshot_create(query)
        elif category == "snapshots": r = DistroTools.snapshot_list()
        elif category == "info": r = DistroTools.system_info()
        elif category == "doctor":
            updates = DistroTools.check_updates()
            services = DistroTools.service_list()
            info = DistroTools.system_info()
            r = {"updates": updates, "system": info, "services_count": len(services.get("services", []))}
        else: r = {"error": f"Unknown: {category}"}
        return json.dumps(r)
    
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def GetStatus(self):
        return json.dumps({
            "status": self._status,
            "model": f"{self.config['model']['provider']}/{self.config['model']['model']}",
            "memory": len(self.memory.data["conversations"]),
            "skills": len(self.skills.list()),
        })
    
    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def SetConfig(self, json_str):
        try:
            c = json.loads(json_str); self.config.update(c); save_config(self.config)
            self.provider = AIProvider(self.config)
            self.engine = AgentEngine(self.provider, self.config)
            return json.dumps({"saved": True})
        except Exception as e: return json.dumps({"error": str(e)})
    
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def GetConfig(self):
        return json.dumps(self.config)
    
    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def AddSkill(self, skill_json):
        s = json.loads(skill_json)
        self.skills.add(s.get("name", "skill"), s.get("prompt", ""), s.get("category", "general"))
        return json.dumps({"ok": True})
    
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ListSkills(self):
        return json.dumps(self.skills.list())
    
    @dbus.service.signal(IFACE, signature="s")
    def StatusChanged(self, status):
        pass


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    name = dbus.service.BusName(BUS_NAME, bus)
    daemon = HermesDaemon(bus, OBJ_PATH)
    try: GLib.MainLoop().run()
    except KeyboardInterrupt: print("\n⏹ Stopped")

if __name__ == "__main__":
    main()
