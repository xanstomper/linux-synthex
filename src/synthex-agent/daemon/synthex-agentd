# ═══ AI Provider Layer ══════════════════════════════════════════════

class AIProvider:
    """Universal model provider — Ollama, OpenCode, OpenAI, Anthropic..."""
    def __init__(self, config):
        self.config = config
    
    def chat(self, messages, stream=False, timeout=120):
        prov = self.config["model"]["provider"]
        model = self.config["model"]["model"]
        cfg = self.config["providers"].get(prov, {})
        base = cfg.get("base_url", "")
        key = cfg.get("api_key", "")
        if not base or not cfg.get("enabled"):
            return {"error": f"Provider '{prov}' not configured"}
        
        import urllib.request
        url = f"{base.rstrip('/')}/chat/completions"
        body = json.dumps({"model": model, "messages": messages, "stream": stream,
                          "temperature": self.config["model"]["temperature"],
                          "max_tokens": self.config["model"]["max_tokens"]}).encode()
        headers = {"Content-Type": "application/json"}
        if key: headers["Authorization"] = f"Bearer {key}"
        try:
            req = urllib.request.Request(url, data=body, headers=headers)
            resp = urllib.request.urlopen(req, timeout=timeout)
            data = json.loads(resp.read())
            text = data.get("choices", [{}])[0].get("message", {}).get("content", "")
            return {"response": text}
        except Exception as e:
            return {"error": str(e)}

    def stream_chat(self, messages):
        """Generator for streaming responses."""
        prov = self.config["model"]["provider"]
        model = self.config["model"]["model"]
        cfg = self.config["providers"].get(prov, {})
        base = cfg.get("base_url", ""); key = cfg.get("api_key", "")
        import urllib.request
        url = f"{base.rstrip('/')}/chat/completions"
        body = json.dumps({"model": model, "messages": messages, "stream": True}).encode()
        headers = {"Content-Type": "application/json"}
        if key: headers["Authorization"] = f"Bearer {key}"
        try:
            req = urllib.request.Request(url, data=body, headers=headers)
            resp = urllib.request.urlopen(req, timeout=120)
            for line in resp:
                if line.startswith(b"data: "):
                    chunk = line[6:].strip()
                    if chunk == b"[DONE]": break
                    try:
                        d = json.loads(chunk)
                        delta = d.get("choices", [{}])[0].get("delta", {}).get("content", "")
                        if delta: yield delta
                    except: continue
        except: yield "⚠️ Connection error"


