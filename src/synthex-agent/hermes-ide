    # ═══ Core Functions ═══════════════════════════════════════════
    
    def _load_project(self):
        """Load the Synthex project file tree."""
        self.file_store.clear()
        if not self.project_root.exists():
            return
        self._populate_tree(self.project_root, None)
        self.file_tree.expand_all()
    
    def _populate_tree(self, path, parent_iter):
        try:
            entries = sorted(path.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower()))
            for entry in entries:
                if entry.name.startswith(".") or entry.name.startswith("__pycache__"):
                    continue
                is_dir = entry.is_dir()
                display = "📁 " + entry.name if is_dir else "📄 " + entry.name
                child = self.file_store.append(parent_iter, [display, str(entry), is_dir])
                if is_dir and entry.name not in (".git", "node_modules", "__pycache__"):
                    self._populate_tree(entry, child)
        except PermissionError:
            pass
    
    def _on_file_activated(self, tree, path, col):
        model = tree.get_model()
        iter_ = model.get_iter(path)
        file_path = model.get_value(iter_, 1)
        is_dir = model.get_value(iter_, 2)
        if is_dir:
            if tree.is_row_expanded(path):
                tree.collapse_row(path)
            else:
                tree.expand_row(path, False)
        else:
            self._open_file_path(file_path)
    
    def _open_file(self, widget=None):
        dialog = Gtk.FileChooserDialog("Open File", self, Gtk.FileChooserAction.OPEN,
                                       (Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                                        Gtk.STOCK_OPEN, Gtk.ResponseType.OK))
        if dialog.run() == Gtk.ResponseType.OK:
            self._open_file_path(dialog.get_filename())
        dialog.destroy()
    
    def _open_folder(self, widget=None):
        dialog = Gtk.FileChooserDialog("Open Folder", self, Gtk.FileChooserAction.SELECT_FOLDER,
                                       (Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                                        Gtk.STOCK_OPEN, Gtk.ResponseType.OK))
        if dialog.run() == Gtk.ResponseType.OK:
            self.project_root = Path(dialog.get_filename())
            self._load_project()
        dialog.destroy()
    
    def _open_file_path(self, path):
        try:
            content = open(path).read()
            self.buffer.set_text(content)
            self.current_file = path
            self._detect_language(path)
            self.set_title(f"Hermes IDE — {os.path.basename(path)}")
        except Exception as e:
            self._agent_msg(f"❌ Cannot open {path}: {e}")
    
    def _detect_language(self, path):
        ext = os.path.splitext(path)[1]
        lang = self.lang_manager.guess_language(path, None)
        if lang:
            self.buffer.set_language(lang)
            self.lang_lbl.set_text(lang.get_name())
        else:
            self.lang_lbl.set_text("Plain Text")
    
    def _save_file(self, widget=None):
        if self.current_file:
            start = self.buffer.get_start_iter()
            end = self.buffer.get_end_iter()
            text = self.buffer.get_text(start, end, True)
            with open(self.current_file, "w") as f: f.write(text)
            self._agent_msg(f"✅ Saved {os.path.basename(self.current_file)}")
        else:
            self._save_as()
    
    def _save_as(self, widget=None):
        dialog = Gtk.FileChooserDialog("Save As", self, Gtk.FileChooserAction.SAVE,
                                       (Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                                        Gtk.STOCK_SAVE, Gtk.ResponseType.OK))
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            start = self.buffer.get_start_iter()
            end = self.buffer.get_end_iter()
            text = self.buffer.get_text(start, end, True)
            with open(path, "w") as f: f.write(text)
            self.current_file = path
            self.set_title(f"Hermes IDE — {os.path.basename(path)}")
        dialog.destroy()
    
    def _on_buffer_changed(self, buf):
        pass  # could mark dirty
    
    def _get_code(self):
        start = self.buffer.get_start_iter()
        end = self.buffer.get_end_iter()
        return self.buffer.get_text(start, end, True)
    
    # ═══ Agent Integration ════════════════════════════════════════
    
    def _agent_msg(self, text, is_user=False):
        lbl = Gtk.Label()
        escaped = html.escape(str(text))
        if is_user:
            lbl.set_markup(f"<b>You:</b> {escaped}")
            lbl.set_name("msg-user")
        else:
            lbl.set_markup(escaped)
            lbl.set_name("msg-agent")
        lbl.set_line_wrap(True); lbl.set_xalign(0)
        self.chat_box.pack_start(lbl, False, False, 0)
        self.chat_box.show_all()
    
    def _agent_submit(self, widget=None):
        text = self.agent_entry.get_text().strip()
        if not text: return
        self.agent_entry.set_text("")
        self._agent_msg(text, is_user=True)
        self._agent_msg("🤔 Thinking...")
        self.agent_status.set_text("🟡 Thinking")
        threading.Thread(target=self._do_agent, args=(text,), daemon=True).start()
    
    def _do_agent(self, text):
        code = self._get_code()
        path = self.current_file or "untitled"
        # Try CodeAction first if there's code in the editor
        if code.strip():
            result = self.client.code_action(text, code[:3000], path)
        else:
            result = self.client.chat(text)
        GLib.idle_add(self._show_agent_result, result)
    
    def _show_agent_result(self, result):
        children = self.chat_box.get_children()
        if children and "Thinking" in (children[-1].get_text() or ""):
            self.chat_box.remove(children[-1])
        response = result.get("response", result.get("error", "No response"))
        self._agent_msg(response[:2000])
        self.agent_status.set_text("🟢 Ready")
        
        # Extract code blocks and offer to insert
        import re
        code_blocks = re.findall(r'```(\w*)\n(.*?)```', response, re.DOTALL)
        for lang, code in code_blocks:
            if len(code) > 20:
                btn = Gtk.Button(label=f"📋 Insert {lang or 'code'} block into editor")
                btn.set_name("btn-accent")
                btn.connect("clicked", lambda w, c=code: self._insert_code(c))
                self.chat_box.pack_start(btn, False, False, 0)
                self.chat_box.show_all()
    
    def _insert_code(self, code):
        self.buffer.set_text(code.strip())
        self._agent_msg(f"✅ Inserted {len(code)} chars into editor")
    
    def _agent_task(self, task):
        self.agent_entry.set_text(task)
        self._agent_submit()
    
    def _generate_project(self, widget=None):
        """Generate a new project using Hermes."""
        dialog = Gtk.Dialog("Generate Project", self, 0,
                           (Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                            Gtk.STOCK_OK, Gtk.ResponseType.OK))
        box = dialog.get_content_area()
        box.set_spacing(6); box.set_margin_start(10); box.set_margin_end(10); box.set_margin_top(10)
        
        lbl = Gtk.Label(label="What project do you want to create?")
        box.pack_start(lbl, False, False, 0)
        
        entry = Gtk.Entry()
        entry.set_placeholder_text("e.g., Python CLI tool, React web app, Rust game...")
        box.pack_start(entry, False, False, 0)
        
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK and entry.get_text().strip():
            task = entry.get_text().strip()
            dialog.destroy()
            self._agent_msg(f"💻 Generating: {task}", is_user=True)
            self._agent_msg("🤔 Creating project...")
            threading.Thread(target=self._do_generate, args=(task,), daemon=True).start()
        else:
            dialog.destroy()
    
    def _do_generate(self, task):
        code = self._get_code()
        result = self.client.code_action(f"Generate a complete project: {task}", "", "new-project")
        GLib.idle_add(self._show_agent_result, result)
    
    def _update_model(self):
        if self.client.available:
            try:
                s = json.loads(self.client.iface.GetStatus())
                self.agent_status.set_text(f"🟢 {s.get('model', 'Hermes')}")
            except: pass
    
    def _on_key(self, widget, event):
        if event.keyval == 65293 and event.state & Gdk.ModifierType.CONTROL_MASK:
            self._agent_submit()
            return True
        return False
    
    def _toggle_pane(self, pane):
        """Toggle sidebar/agent panel visibility."""
        pass  # simplified


def main():
    app = Gtk.Application(application_id="org.solus.hermes.ide")
    app.connect("activate", lambda a: HermesIDE(a).show_all())
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app.run(None)

if __name__ == "__main__":
    main()
