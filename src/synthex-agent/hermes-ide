# ═══ DBus Client ═══════════════════════════════════════════════════

class HermesClient:
    def __init__(self):
        self.available = False
        self._connect()
    def _connect(self):
        try:
            import dbus; bus = dbus.SessionBus()
            self.obj = bus.get_object("org.solus.Hermes", "/org/synthex/Hermes")
            self.iface = dbus.Interface(self.obj, "org.solus.Hermes")
            self.available = True
        except:
            self.available = False
            if DAEMON.exists():
                subprocess.Popen([str(DAEMON)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(2)
                try:
                    import dbus; bus = dbus.SessionBus()
                    self.obj = bus.get_object("org.solus.Hermes", "/org/synthex/Hermes")
                    self.iface = dbus.Interface(self.obj, "org.solus.Hermes")
                    self.available = True
                except: pass
    def chat(self, query):
        if not self.available: return {"response": "⚠️ Daemon not running"}
        try: return json.loads(self.iface.Chat(query))
        except Exception as e: return {"response": f"Error: {e}"}
    def code_action(self, task, code="", path=""):
        if not self.available: return {"response": "Daemon not running"}
        req = json.dumps({"task": task, "code": code, "path": path})
        try: return json.loads(self.iface.CodeAction(req))
        except Exception as e: return {"response": f"Error: {e}"}


# ═══ Hermes Desktop IDE ════════════════════════════════════════════

