#!/usr/bin/env bash
# synthex-nvidia-installer — Nobara-style NVIDIA driver wizard with auto-detection
set -euo pipefail

AMBER='\033[38;5;214m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

[[ $EUID -eq 0 ]] || { echo -e "${RED}Run as root${NC}"; exit 1; }

echo -e "${AMBER}══════════════════════════════════════════════${NC}"
echo -e "${AMBER}  🖥️  Synthex NVIDIA Driver Installer${NC}"
echo -e "${AMBER}══════════════════════════════════════════════${NC}"
echo ""

# ─── Detect NVIDIA GPU ────────────────────────────────────────────────
GPU=$(lspci -nn | grep -i 'VGA.*NVIDIA' | head -1 || true)
if [ -z "$GPU" ]; then
    echo -e "${YELLOW}⚠️  No NVIDIA GPU detected.${NC}"
    echo "Available GPUs:"
    lspci | grep -i vga
    echo ""
    echo -n "Install NVIDIA drivers anyway? (y/N): "
    read -r REPLY
    [[ "$REPLY" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
else
    GPU_MODEL=$(echo "$GPU" | sed 's/.*NVIDIA.*\[/NVIDIA /;s/\].*//')
    echo -e "${GREEN}✅ Detected: $GPU_MODEL${NC}"
fi

# ─── Detect kernel ────────────────────────────────────────────────────
KVER=$(uname -r)
echo "  Kernel: $KVER"

# ─── Check if already installed ───────────────────────────────────────
if lsmod | grep -q nvidia 2>/dev/null; then
    echo -e "${YELLOW}⚠️  NVIDIA driver already loaded.${NC}"
    echo -n "Reinstall/update? (y/N): "
    read -r REPLY
    [[ "$REPLY" =~ ^[Yy]$ ]] || { echo "Keeping current drivers."; exit 0; }
fi

# ─── Install ──────────────────────────────────────────────────────────
echo ""
echo -e "${AMBER}Installing NVIDIA driver stack...${NC}"

dnf install -y \
    akmod-nvidia \
    nvidia-driver \
    nvidia-settings \
    nvidia-prime \
    nvidia-modprobe \
    nvidia-xconfig \
    xorg-x11-drv-nvidia-cuda \
    cuda 2>/dev/null || true

# ─── Build kernel module ──────────────────────────────────────────────
echo -e "${AMBER}Building NVIDIA kernel module for $KVER...${NC}"
akmods --kernels "$KVER" 2>/dev/null || \
    dkms autoinstall -k "$KVER" 2>/dev/null || true

# ─── Configure ────────────────────────────────────────────────────────
echo -e "${AMBER}Configuring NVIDIA...${NC}"

# Enable Wayland NVIDIA modeset
mkdir -p /etc/modprobe.d
cat > /etc/modprobe.d/nvidia.conf << 'EOF'
options nvidia-drm modeset=1
options nvidia-drm fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1
EOF

# Add nouveau to blacklist
cat > /etc/modprobe.d/nouveau-blacklist.conf << 'EOF'
blacklist nouveau
options nouveau modeset=0
EOF

# Rebuild initramfs
echo -e "${AMBER}Rebuilding initramfs...${NC}"
dracut --force 2>/dev/null || true

# ─── Secure Boot handling ─────────────────────────────────────────────
if mokutil --sb-state 2>/dev/null | grep -q "enabled"; then
    echo ""
    echo -e "${YELLOW}⚠️  Secure Boot is enabled.${NC}"
    echo "You need to enroll the MOK key:"
    echo "  1. A blue MOK Manager screen will appear on reboot"
    echo "  2. Select 'Enroll MOK'"
    echo "  3. Enter the password (set during akmod build)"
    echo "  4. Reboot"
fi

echo ""
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
echo -e "${GREEN}  ✅ NVIDIA driver installation complete${NC}"
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
echo ""
echo "Reboot to activate NVIDIA drivers."
echo ""
echo "After reboot, verify with:"
echo "  nvidia-smi"
echo "  glxinfo | grep 'NVIDIA'"
