#!/usr/bin/env bash
# synthex-log-viewer — view and filter system logs (journalctl wrapper)
# Usage: synthex-log-viewer [boot|kernel|errors|warnings|service|today|follow|search] [args]
set -euo pipefail

AMBER='\033[38;5;214m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

[[ $EUID -eq 0 ]] && SUDO="" || SUDO="sudo"

show_boot() { echo -e "${AMBER}📋 Current boot logs:${NC}"; $SUDO journalctl -b --no-pager | tail -50; }
show_kernel() { echo -e "${AMBER}📋 Kernel logs (dmesg):${NC}"; $SUDO journalctl -k --no-pager | tail -50; }
show_errors() { echo -e "${AMBER}📋 Error logs (priority 0-3):${NC}"; $SUDO journalctl -p err --no-pager | tail -50; }
show_warnings() { echo -e "${AMBER}📋 Warning logs (priority 0-4):${NC}"; $SUDO journalctl -p warning --no-pager | tail -50; }
show_today() { echo -e "${AMBER}📋 Today's logs:${NC}"; $SUDO journalctl --since today --no-pager | tail -80; }
show_service() { local s="${1:-}"; [ -z "$s" ] && { echo "Usage: service <name>"; exit 1; }; echo -e "${AMBER}📋 Logs for $s:${NC}"; $SUDO journalctl -u "$s" --no-pager | tail -50; }
follow_logs() { echo -e "${AMBER}📋 Following logs (Ctrl+C to stop):${NC}"; $SUDO journalctl -f; }
search_logs() { local q="${1:-}"; [ -z "$q" ] && { echo "Usage: search <query>"; exit 1; }; echo -e "${AMBER}📋 Searching for '$q':${NC}"; $SUDO journalctl --no-pager | grep -i "$q" | tail -50; }
show_boots() { echo -e "${AMBER}📋 Boot history:${NC}"; $SUDO journalctl --list-boots --no-pager | tail -10; }

CMD="${1:-errors}"; shift 2>/dev/null || true
case "$CMD" in
    boot)    show_boot ;;
    kernel)  show_kernel ;;
    errors|error) show_errors ;;
    warnings|warning) show_warnings ;;
    today)   show_today ;;
    service) show_service "$@" ;;
    follow|f) follow_logs ;;
    search)  search_logs "$@" ;;
    boots)   show_boots ;;
    *)       echo "Usage: synthex-log-viewer [boot|kernel|errors|warnings|today|service <name>|follow|search <q>|boots]"; exit 1 ;;
esac
