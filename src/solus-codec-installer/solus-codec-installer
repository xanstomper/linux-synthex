#!/usr/bin/env bash
# solus-codec-installer — Nobara-style one-click codec installer
set -euo pipefail

AMBER='\033[38;5;214m'
GREEN='\033[0;32m'
NC='\033[0m'

[[ $EUID -eq 0 ]] || { echo "Run as root: sudo solus-codec-installer"; exit 1; }

echo -e "${AMBER}══════════════════════════════════════════════${NC}"
echo -e "${AMBER}  🎬 Solus Codec Installer${NC}"
echo -e "${AMBER}══════════════════════════════════════════════${NC}"
echo ""
echo "This installs full multimedia codec support:"
echo "  H.264, H.265/HEVC, AV1, VP9, VP8, AAC, MP3, FLAC, Opus"
echo "  DVD playback, Blu-ray, hardware acceleration (VAAPI/NVENC/NVDEC)"
echo ""

# ─── Install codec pack ───────────────────────────────────────────────
if dnf list installed solus-codec-pack &>/dev/null 2>&1; then
    echo -e "${GREEN}✅ Codec pack already installed${NC}"
else
    echo "Installing solus-codec-pack..."
    dnf install -y solus-codec-pack 2>/dev/null || {
        echo "Falling back to individual packages..."
        dnf install -y \
            ffmpeg ffmpeg-libs \
            x264 x265 libaom dav1d openh264 libvpx \
            gstreamer1-plugins-base gstreamer1-plugins-good \
            gstreamer1-plugins-bad-free gstreamer1-plugins-bad-free-extras \
            gstreamer1-plugins-ugly-free gstreamer1-plugin-libav \
            flac opus lame libdvdnav libdvdread libdvdcss \
            libva intel-vaapi-driver mesa-va-drivers \
            vlc mpv 2>/dev/null || true
    }
fi

# ─── Verify ───────────────────────────────────────────────────────────
echo ""
echo -e "${AMBER}Verifying codec support...${NC}"
echo -n "  ffmpeg:     "; command -v ffmpeg &>/dev/null && echo "✅" || echo "❌"
echo -n "  H.264 (x264): "; ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libx264 && echo "✅" || echo "❌"
echo -n "  H.265 (x265): "; ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libx265 && echo "✅" || echo "❌"
echo -n "  AV1 (dav1d):  "; command -v dav1d &>/dev/null && echo "✅" || echo "❌"
echo -n "  GStreamer:   "; command -v gst-launch-1.0 &>/dev/null && echo "✅" || echo "❌"
echo -n "  VAAPI:       "; command -v vainfo &>/dev/null && echo "✅" || echo "❌"
echo -n "  DVD (libdvd): "; ldconfig -p | grep -q libdvdcss && echo "✅" || echo "❌"
echo -n "  VLC:         "; command -v vlc &>/dev/null && echo "✅" || echo "❌"

echo ""
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
echo -e "${GREEN}  ✅ Codec installation complete${NC}"
echo -e "${GREEN}══════════════════════════════════════════════${NC}"
