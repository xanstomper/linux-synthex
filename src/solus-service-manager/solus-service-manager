#!/usr/bin/env bash
# solus-service-manager — manage systemd services (enable/disable/start/stop/restart/status)
# Usage: solus-service-manager [list|start|stop|restart|enable|disable|status|failed|mask] <service>
set -euo pipefail

AMBER='\033[38;5;214m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

[[ $EUID -eq 0 ]] && SUDO="" || SUDO="sudo"

list_services() {
    local state="${1:-all}"
    echo -e "${AMBER}📋 Services ($state):${NC}"
    echo ""
    case "$state" in
        running)  $SUDO systemctl list-units --type=service --state=running --no-pager --no-legend | awk '{print "  ✅ "$1}' ;;
        failed)   $SUDO systemctl --failed --no-pager --no-legend | awk '{print "  ❌ "$1}' ;;
        enabled)  $SUDO systemctl list-unit-files --type=service --state=enabled --no-pager --no-legend | awk '{print "  ● "$1}' ;;
        disabled) $SUDO systemctl list-unit-files --type=service --state=disabled --no-pager --no-legend | awk '{print "  ○ "$1}' ;;
        all)      $SUDO systemctl list-units --type=service --no-pager --no-legend | awk '{print "  "$1"  ["$4"]"}' ;;
        *)        echo "Usage: list [running|failed|enabled|disabled|all]"; exit 1 ;;
    esac
}

show_status() {
    local svc="${1:-}"
    [ -z "$svc" ] && { echo "Usage: status <service>"; exit 1; }
    $SUDO systemctl status "$svc" --no-pager 2>/dev/null || echo -e "${RED}Service not found: $svc${NC}"
}

do_action() {
    local action="$1" svc="$2"
    [ -z "$svc" ] && { echo "Usage: $action <service>"; exit 1; }
    echo -e "${AMBER}⚙️  $action $svc...${NC}"
    $SUDO systemctl "$action" "$svc" 2>/dev/null && echo -e "${GREEN}✅ $action $svc done${NC}" \
        || echo -e "${RED}❌ Failed to $action $svc${NC}"
}

CMD="${1:-list}"; shift 2>/dev/null || true
case "$CMD" in
    list)   list_services "${1:-all}" ;;
    status) show_status "$1" ;;
    start)  do_action start "$1" ;;
    stop)   do_action stop "$1" ;;
    restart) do_action restart "$1" ;;
    enable) do_action enable "$1" ;;
    disable) do_action disable "$1" ;;
    mask)   do_action mask "$1" ;;
    unmask) do_action unmask "$1" ;;
    failed) list_services failed ;;
    running) list_services running ;;
    *) echo "Usage: solus-service-manager [list|status|start|stop|restart|enable|disable|mask|failed|running] <service>"; exit 1 ;;
esac
