#!/usr/bin/env python3
import sys
from pathlib import Path

candidate_paths = [
    Path("/home/jewboy420/linux-synthex/src/synthex-brain"),
    Path("/usr/lib/synthex/synthex-brain"),
    Path(__file__).resolve().parent / "synthex-brain"
]
for p in candidate_paths:
    if p.exists() and str(p) not in sys.path:
        sys.path.insert(0, str(p))

from synthex_sql_brain import main
if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] not in ["status", "guide", "log-action", "json", "-h", "--help"]:
        # If user passes goal directly to synthex-guide
        sys.argv = [sys.argv[0], "guide"] + sys.argv[1:]
    elif len(sys.argv) == 1:
        sys.argv = [sys.argv[0], "status"]
    main()
