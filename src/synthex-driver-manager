#!/usr/bin/env python3
"""Synthex Driver Manager — GUI for GPU/driver management.
Like Mint's mintdrivers. Lists available drivers and installs them.

Usage:
    synthex-driver-manager            Interactive driver manager
    synthex-driver-manager list       List available drivers
    synthex-driver-manager auto       Auto-install recommended drivers
    synthex-driver-manager status     Show current driver status
"""
import os, sys, subprocess, json, glob

def detect_gpu():
    """Detect GPUs in system."""
    gpus = []
    try:
        r = subprocess.run(["lspci", "-nn"], capture_output=True, text=True, timeout=10)
        for line in r.stdout.splitlines():
            if "VGA" in line or "3D" in line or "Display" in line:
                gpus.append(line.strip())
    except: pass
    return gpus

def driver_status():
    """Check currently loaded drivers."""
    status = {}
    # NVIDIA
    try:
        r = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
        status["nvidia_loaded"] = "nvidia" in r.stdout
        if status["nvidia_loaded"]:
            r2 = subprocess.run(["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"], 
                               capture_output=True, text=True, timeout=10)
            status["nvidia_version"] = r2.stdout.strip() if r2.returncode == 0 else "?"
    except: pass
    # AMD
    try:
        r = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
        status["amdgpu_loaded"] = "amdgpu" in r.stdout
    except: pass
    # Intel
    try:
        r = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
        status["i915_loaded"] = "i915" in r.stdout
    except: pass
    # OpenGL
    try:
        r = subprocess.run(["glxinfo", "-B"], capture_output=True, text=True, timeout=10)
        for line in r.stdout.splitlines():
            if "OpenGL vendor" in line:
                status["gl_vendor"] = line.split(":")[1].strip()
            if "OpenGL renderer" in line:
                status["gl_renderer"] = line.split(":")[1].strip()
            if "OpenGL version" in line:
                status["gl_version"] = line.split(":")[1].strip()
    except: pass
    return status

def get_available_drivers():
    """List available driver packages."""
    drivers = {
        "nvidia": {
            "name": "NVIDIA (proprietary)",
            "packages": ["akmod-nvidia", "nvidia-driver", "nvidia-settings", "nvidia-prime"],
            "desc": "Best performance for NVIDIA GPUs. Includes CUDA support.",
            "repo": "rpmfusion-nonfree"
        },
        "nvidia-open": {
            "name": "NVIDIA (open kernel)",
            "packages": ["akmod-nvidia-open", "nvidia-driver", "nvidia-settings"],
            "desc": "Open-source NVIDIA kernel module (newer GPUs only)",
            "repo": "rpmfusion-nonfree"
        },
        "amd": {
            "name": "AMD (open-source)",
            "packages": ["mesa-dri-drivers", "mesa-vulkan-drivers", "mesa-va-drivers", 
                        "libva-utils", "amdvlk"],
            "desc": "Best performance for AMD GPUs. Vulkan + VAAPI included.",
            "repo": "fedora"
        },
        "intel": {
            "name": "Intel (open-source)",
            "packages": ["mesa-dri-drivers", "mesa-vulkan-drivers", "intel-media-driver",
                        "libva-utils", "intel-gpu-tools"],
            "desc": "Best performance for Intel GPUs. VAAPI hardware encoding.",
            "repo": "fedora"
        },
    }
    return drivers

def cmd_list():
    print("🎮 Synthex Driver Manager")
    print("═" * 60)
    gpus = detect_gpu()
    print("\nDetected GPUs:")
    for g in gpus:
        print(f"  🖥  {g}")
    print()
    status = driver_status()
    print("Current Drivers:")
    for k, v in status.items():
        print(f"  • {k}: {v}")
    print("\nAvailable Drivers:")
    for key, info in get_available_drivers().items():
        already = status.get(f"{key.split('-')[0]}_loaded", False)
        mark = "✅" if already else "  "
        print(f"  {mark} {info['name']}")
        print(f"     {info['desc']}")
        print(f"     Install: sudo dnf install {' '.join(info['packages'][:2])}")
    print()

def cmd_auto():
    """Auto-detect and install best drivers."""
    gpus = detect_gpu()
    status = driver_status()
    print("🎮 Auto-installing recommended drivers...")
    for g in gpus:
        gpu_lower = g.lower()
        if "nvidia" in gpu_lower and not status.get("nvidia_loaded"):
            print("  Detected NVIDIA GPU. Installing NVIDIA drivers...")
            subprocess.run(["sudo", "dnf", "install", "-y", 
                          "akmod-nvidia", "nvidia-driver", "nvidia-settings"])
            print("  ✅ NVIDIA drivers installed")
        elif "amd" in gpu_lower or "advanced micro devices" in gpu_lower:
            print("  Detected AMD GPU. Ensuring Mesa drivers...")
            subprocess.run(["sudo", "dnf", "install", "-y",
                          "mesa-dri-drivers", "mesa-vulkan-drivers", "mesa-va-drivers"])
            print("  ✅ AMD drivers up to date")
        elif "intel" in gpu_lower:
            print("  Detected Intel GPU. Ensuring Intel drivers...")
            subprocess.run(["sudo", "dnf", "install", "-y",
                          "mesa-dri-drivers", "intel-media-driver"])
            print("  ✅ Intel drivers up to date")

def cmd_status():
    status = driver_status()
    print("🎮 Driver Status")
    for k, v in status.items():
        print(f"  {k}: {v}")

def main():
    if len(sys.argv) < 2:
        cmd_list()
        return
    cmd = sys.argv[1]
    if cmd == "list": cmd_list()
    elif cmd == "auto": cmd_auto()
    elif cmd == "status": cmd_status()
    else: print(__doc__)

if __name__ == "__main__":
    main()
