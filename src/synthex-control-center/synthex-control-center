#!/usr/bin/env bash
# SynthOS System Settings Launcher
# Uses the real, native desktop settings application for the current session.
set -euo pipefail

# 1. Cinnamon (Linux Mint) — the real cinnamon-settings with all hardware modules
if command -v cinnamon-settings &>/dev/null; then
    exec cinnamon-settings "$@"
fi

# 2. COSMIC (System76 / Pop!_OS)
if command -v cosmic-settings &>/dev/null; then
    exec cosmic-settings "$@"
fi

# 3. KDE Plasma
if command -v systemsettings &>/dev/null; then
    exec systemsettings "$@"
fi
if command -v systemsettings5 &>/dev/null; then
    exec systemsettings5 "$@"
fi

# 4. GNOME
if command -v gnome-control-center &>/dev/null; then
    exec gnome-control-center "$@"
fi

# 5. XFCE
if command -v xfce4-settings-manager &>/dev/null; then
    exec xfce4-settings-manager "$@"
fi

# 6. MATE
if command -v mate-control-center &>/dev/null; then
    exec mate-control-center "$@"
fi

# 7. Budgie
if command -v budgie-control-center &>/dev/null; then
    exec budgie-control-center "$@"
fi

echo "Error: No supported desktop settings application found." >&2
echo "Install one of: cinnamon-settings, gnome-control-center, systemsettings, cosmic-settings" >&2
exit 1
