#!/usr/bin/env bash
# SynthOS System Settings Launcher
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HERE/../.." && pwd)"

# Launch Native SynthOS Control Center.
# GTK3/PyGObject lives in system site-packages — the repo venv does not ship
# gi bindings, so prefer the system interpreter.
PY=""
for CAND in /usr/bin/python3 python3 "$REPO_ROOT/.venv/bin/python"; do
    if command -v "$CAND" >/dev/null 2>&1 && "$CAND" -c "import gi" >/dev/null 2>&1; then
        PY="$CAND"
        break
    fi
done
# Resolve main.py location across source repo and system install paths
MAIN_PY=""
for CAND in "$HERE/main.py" "/home/jewboy420/linux-synthex/src/synthex-control-center/main.py" "/usr/lib/synthex/synthex-control-center/main.py"; do
    if [ -f "$CAND" ]; then
        MAIN_PY="$CAND"
        break
    fi
done
[ -n "$MAIN_PY" ] || { echo "Could not locate main.py for Synthex Control Center" >&2; exit 1; }

exec "$PY" "$MAIN_PY" "$@"

