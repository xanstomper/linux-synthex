#!/usr/bin/env bash
# synthex-desktopd — Desktop Customization Daemon entry point
# Tries native compiled binary, then Python fallback
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

if command -v synthex-desktopd-bin &>/dev/null; then
    exec synthex-desktopd-bin "$@"
fi

# Python fallback: apply layouts/themes directly
echo "synthex-desktopd: using Python fallback"
export PYTHONPATH="$HERE:$PYTHONPATH"
exec python3 -c "
import sys, json, os, subprocess
from desktopd import DesktopDaemon
from layout_manager import LayoutManager

# D-Bus service simulation
if '--dbus' in sys.argv:
    print('synthex-desktopd: D-Bus mode (stub)')
    # In production this registers org.synthex.Desktop on D-Bus
    sys.exit(0)

# CLI mode
for arg in sys.argv[1:]:
    if arg.startswith('--layout='):
        name = arg.split('=', 1)[1]
        layout = LayoutManager()
        layout.apply(name)
        print(f'Layout applied: {name}')
    elif arg.startswith('--theme='):
        print(f'Theme requested: {arg.split(\"=\", 1)[1]}')
print('synthex-desktopd ready')
"
