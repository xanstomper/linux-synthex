#!/usr/bin/env python3
"""Solus Power Profiles — power-profiles-daemon integration.
Usage:
    solus-power-profiles              Show current profile
    solus-power-profiles list         List available profiles
    solus-power-profiles set <name>   Set profile
    solus-power-profiles daemon       Run daemon (systemd service)
"""
import os, sys, subprocess, json, time, signal

POWER_PROFILES = ["performance", "balanced", "power-saver"]
STATE_FILE = "/var/lib/solus/power-profile"
PIDFILE = "/run/solus-power-profiles.pid"

def get_current():
    if os.path.exists(STATE_FILE):
        return open(STATE_FILE).read().strip()
    # Check power-profiles-daemon
    try:
        r = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return r.stdout.strip()
    except: pass
    # Check platform profile (ACPI)
    for path in ["/sys/firmware/acpi/platform_profile"]:
        if os.path.exists(path):
            return open(path).read().strip()
    return "balanced"

def cmd_list():
    current = get_current()
    print("🔋 Solus Power Profiles")
    for p in POWER_PROFILES:
        marker = "●" if p == current else "○"
        print(f"  {marker} {p}")
    print(f"\nCurrent: {current}")

def cmd_set(profile):
    if profile not in POWER_PROFILES:
        print(f"Invalid profile. Choose: {', '.join(POWER_PROFILES)}")
        return
    print(f"🔋 Setting power profile: {profile}")
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f: f.write(profile)
    # Apply via power-profiles-daemon
    try:
        subprocess.run(["powerprofilesctl", "set", profile], capture_output=True, timeout=10)
    except: pass
    # Apply CPU governor
    gov = "performance" if profile == "performance" else "powersave" if profile == "power-saver" else "schedutil"
    try:
        for cpu in range(os.cpu_count() or 1):
            path = f"/sys/devices/system/cpu/cpu{cpu}/cpufreq/scaling_governor"
            if os.path.exists(path):
                with open(path, "w") as f: f.write(gov)
    except: pass
    # Apply PCIe ASPM
    if profile == "power-saver":
        try: subprocess.run(["sudo", "sh", "-c", "echo powersave > /sys/module/pcie_aspm/parameters/policy"], capture_output=True)
        except: pass
    print(f"✅ Profile set to {profile}")

def cmd_daemon():
    """Daemon mode — watches for profile changes and applies them."""
    with open(PIDFILE, "w") as f: f.write(str(os.getpid()))
    print(f"Solus Power Profiles daemon started (PID {os.getpid()})")
    while True:
        profile = get_current()
        for cpu in range(os.cpu_count() or 1):
            try:
                path = f"/sys/devices/system/cpu/cpu{cpu}/cpufreq/scaling_governor"
                if os.path.exists(path):
                    cur = open(path).read().strip()
                    expected = "performance" if profile == "performance" else "powersave" if profile == "power-saver" else "schedutil"
                    if cur != expected:
                        with open(path, "w") as f: f.write(expected)
            except: pass
        time.sleep(30)

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        print(f"Current: {get_current()}")
        return
    cmd = sys.argv[1]
    if cmd == "list": cmd_list()
    elif cmd == "set" and len(sys.argv) >= 3: cmd_set(sys.argv[2])
    elif cmd == "daemon": cmd_daemon()
    elif cmd == "status": print(f"Current profile: {get_current()}")
    else: print(__doc__)

if __name__ == "__main__":
    main()
