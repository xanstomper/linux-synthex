#!/usr/bin/env bash
# synthex-kernel-manager — list, install, switch, remove kernels
# Usage: synthex-kernel-manager [list|install|switch|remove|info|default|cleanup]
set -euo pipefail

AMBER='\033[38;5;214m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

[[ $EUID -eq 0 ]] && SUDO="" || SUDO="sudo"

list_kernels() {
    echo -e "${AMBER}📦 Installed kernels:${NC}"
    echo ""
    local running=$(uname -r)
    for k in $(ls /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -Vr); do
        if [ "$k" = "$running" ]; then
            echo -e "  ${GREEN}▶ $k (running)${NC}"
        else
            echo "    $k"
        fi
    done
    echo ""
    echo -e "${AMBER}Available kernels in repos:${NC}"
    dnf list available 'kernel*' 2>/dev/null | grep '^kernel' | awk '{print "    "$1"  "$2}' | head -20
}

install_kernel() {
    local ver="${1:-}"
    echo -e "${AMBER}📦 Installing kernel...${NC}"
    if [ -n "$ver" ]; then
        $SUDO dnf install -y "kernel-$ver" "kernel-core-$ver" "kernel-modules-$ver"
    else
        $SUDO dnf install -y kernel kernel-core kernel-modules
    fi
    echo -e "${AMBER}Rebuilding initramfs...${NC}"
    $SUDO dracut --force --regenerate-all 2>/dev/null || true
    $SUDO grub2-mkconfig -o /boot/grub2/grub.cfg 2>/dev/null || \
        $SUDO grub2-mkconfig -o /boot/efi/EFI/synthex/grub.cfg 2>/dev/null || true
    echo -e "${GREEN}✅ Kernel installed. Reboot to use.${NC}"
}

switch_kernel() {
    echo -e "${AMBER}Available kernels to boot:${NC}"
    list_kernels
    echo ""
    echo "To switch kernels, reboot and select from GRUB menu."
    echo "Or set default:"
    echo "  sudo grub2-set-default 0  (first kernel)"
    echo "  sudo grub2-reboot 1       (boot specific entry once)"
}

remove_kernel() {
    local ver="${1:-}"
    [ -z "$ver" ] && { echo "Usage: synthex-kernel-manager remove <version>"; exit 1; }
    local running=$(uname -r)
    [ "$ver" = "$running" ] && { echo -e "${RED}❌ Cannot remove running kernel${NC}"; exit 1; }
    echo -e "${AMBER}Removing kernel $ver...${NC}"
    $SUDO dnf remove -y "kernel-$ver" "kernel-core-$ver" "kernel-modules-$ver" "kernel-devel-$ver" 2>/dev/null || true
    $SUDO grub2-mkconfig -o /boot/grub2/grub.cfg 2>/dev/null || true
    echo -e "${GREEN}✅ Kernel $ver removed.${NC}"
}

kernel_info() {
    local k="${1:-$(uname -r)}"
    echo -e "${AMBER}Kernel: $k${NC}"
    echo ""
    echo "  Version:   $(echo $k | cut -d- -f1)"
    echo "  Release:   $(echo $k | cut -d- -f2)"
    echo "  Arch:      $(uname -m)"
    echo "  Booted:    $(uname -r)"
    echo "  Compiler:  $(cat /proc/version | grep -oP 'gcc[^ ]* [^ ]*' | head -1)"
    echo ""
    echo "  Scheduler: $(cat /sys/block/sda/queue/scheduler 2>/dev/null || echo 'N/A')"
    echo "  Governor:  $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'N/A')"
    echo "  Modules:   $(ls /lib/modules/$k/kernel 2>/dev/null | wc -l) directories"
    echo "  cmdline:   $(cat /proc/cmdline)"
}

cleanup_kernels() {
    echo -e "${AMBER}🧹 Cleaning old kernels (keeping current + 1 backup)...${NC}"
    local running=$(uname -r)
    local installed=($(ls /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -Vr))
    local keep=0
    for k in "${installed[@]}"; do
        if [ "$k" = "$running" ]; then continue; fi
        keep=$((keep + 1))
        if [ $keep -gt 1 ]; then
            echo "  Removing: $k"
            $SUDO dnf remove -y "kernel-$k" "kernel-core-$k" "kernel-modules-$k" 2>/dev/null || true
        fi
    done
    echo -e "${GREEN}✅ Cleanup done. Kept running + 1 backup.${NC}"
}

CMD="${1:-list}"; shift 2>/dev/null || true
case "$CMD" in
    list) list_kernels ;;
    install) install_kernel "$@" ;;
    switch) switch_kernel ;;
    remove) remove_kernel "$@" ;;
    info) kernel_info "$@" ;;
    cleanup) cleanup_kernels ;;
    *) echo "Usage: synthex-kernel-manager [list|install <ver>|switch|remove <ver>|info|cleanup]"; exit 1 ;;
esac
