#!/usr/bin/env bash
# solus-gpu-setupd — GPU Detection and Driver Setup entry point
# Tries native binary, then shell script fallback
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

if command -v solus-gpu-setupd-bin &>/dev/null; then
    exec solus-gpu-setupd-bin "$@"
fi

exec bash "$HERE/solus-gpu-setupd.sh" "$@"
