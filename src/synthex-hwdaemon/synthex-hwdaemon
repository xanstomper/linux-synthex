#!/usr/bin/env python3
"""synthex-hwdaemon — Hardware Detection Daemon entry point.
Tries native binary, then Python vault fallback."""
import os, sys
HERE = os.path.dirname(os.path.abspath(__file__))

# Try native binary
native = os.path.join(HERE, "synthex-hwdaemon-bin")
if os.path.exists(native) and os.access(native, os.X_OK):
    os.execv(native, [native] + sys.argv[1:])

# Python fallback
sys.path.insert(0, HERE)
from hw_vault import main as hwmain
sys.exit(hwmain())
