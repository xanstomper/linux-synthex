#!/usr/bin/env python3
"""solus-ai-assistant — unified entrypoint for Solus AI assistants.

Subcommands:
    driver        Detect hardware → recommend + install drivers
    troubleshoot  Detect broken services / missing deps → suggest fixes
    performance   Analyze hardware → recommend kernel + graphics + ZRAM tuning

Each subcommand supports --json for machine-readable output.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    sub = sys.argv[1]
    rest = sys.argv[2:]
    mod = {
        "driver": "driver_assistant.py",
        "troubleshoot": "troubleshooter.py",
        "performance": "performance_advisor.py",
    }.get(sub)
    if not mod:
        print(f"unknown subcommand: {sub}\n{__doc__}")
        return 1
    path = os.path.join(HERE, mod)
    # exec the module as a script with the remaining args
    import runpy
    sys.argv = [path] + rest
    try:
        runpy.run_path(path, run_name="__main__")
    except SystemExit as e:
        return e.code or 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
