"""
Synthex Native At-Rest Cryptographic Security CLI
Zero-Software Overhead, Pure Native Linux OS-Level Encryption.
Usage:
  synthex-encrypt status                  — Full native at-rest and hardware encryption report
  synthex-encrypt harden                  — Apply anti-coldboot RAM sysctls & memory protection
  synthex-encrypt tpm-enroll <device>     — Seal LUKS2 disk key to TPM 2.0 (PCR 0+2+7)
"""

import os
import sys
from pathlib import Path

_SEC_DIR = Path(__file__).resolve().parent / "synthex-security"
if str(_SEC_DIR) not in sys.path:
    sys.path.insert(0, str(_SEC_DIR))

try:
    from synthex_encryption import SynthexEncryptionEngine
except ImportError:
    SynthexEncryptionEngine = None


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["status", "--status", "-s"]:
        if SynthexEncryptionEngine:
            engine = SynthexEncryptionEngine.get_instance()
            health = engine.get_full_cryptographic_health()
            print("=================================================================")
            print(" Synthex Native At-Rest & System Cryptographic Security Hub")
            print("=================================================================")
            print(" Architecture: Zero-Overhead Native Linux Data-At-Rest Encryption")
            print(" State when Powered Off: 100% ENCRYPTED & INACCESSIBLE (Ciphertext)")
            print(" State when Logged Out : LOCKED (Decryption Keys Evicted from RAM)")
            print(" State when Logged In  : TRANSPARENT WIRE-SPEED ACCESS (AES-NI)")
            print("-----------------------------------------------------------------")
            for layer in health["layers"]:
                print(f" 🔒 {layer['layer']:<38} : {layer['status']}")
                print(f"    └─ {layer['details']}")
            print("=================================================================")
        else:
            print("Synthex Encryption Engine loading error.")
        return

    cmd = sys.argv[1]
    engine = SynthexEncryptionEngine.get_instance() if SynthexEncryptionEngine else None

    if cmd == "harden":
        if engine:
            ok, msg = engine.apply_kernel_anticoldboot_hardening()
            print(f"[{'OK' if ok else 'ERR'}] {msg}")
            ok2, msg2 = engine.enable_kernel_memory_encryption()
            print(f"[{'OK' if ok2 else 'ERR'}] {msg2}")
        else:
            print("Engine not available.")

    elif cmd == "tpm-enroll" and len(sys.argv) >= 3:
        dev = sys.argv[2]
        if engine:
            ok, msg = engine.enroll_tpm2(dev)
            print(f"[{'OK' if ok else 'ERR'}] {msg}")

    else:
        print(__doc__)


if __name__ == "__main__":
    main()
