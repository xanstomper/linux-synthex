#!/usr/bin/env python3
"""Synthex Disk Encryption — LUKS or VeraCrypt setup helper.
Usage:
  synthex-encrypt setup <device>    — Encrypt a disk
  synthex-encrypt open <device>     — Open encrypted volume
  synthex-encrypt close <volume>    — Close encrypted volume
  synthex-encrypt status            — Show encryption status
  synthex-encrypt wizard            — Interactive setup wizard
"""
import os, sys, subprocess, json

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

def cmd_setup(device):
    print(f"Synthex Disk Encryption Setup")
    print(f"Device: {device}")
    print()
    print("Choose encryption method:")
    print("1) LUKS2 (Linux native, recommended)")
    print("2) VeraCrypt (cross-platform)")
    choice = input("Choice [1]: ").strip() or "1"
    if choice == "1":
        print(f"Running: cryptsetup luksFormat {device}")
        print("WARNING: This will ERASE all data on the device!")
        confirm = input("Type YES to continue: ")
        if confirm == "YES":
            run(["sudo", "cryptsetup", "luksFormat", "--type", "luks2", "--cipher", "aes-xts-plain64", "--key-size", "512", "--hash", "sha256", device])
            print(f"Device {device} encrypted with LUKS2")
            name = input("Volume name [synthex-secret]: ").strip() or "synthex-secret"
            run(["sudo", "cryptsetup", "open", device, name])
            run(["sudo", "mkfs.btrfs", f"/dev/mapper/{name}"])
            print(f"Encrypted volume {name} ready at /dev/mapper/{name}")
    elif choice == "2":
        print("VeraCrypt requires veracrypt package")
        run(["sudo", "dnf", "install", "-y", "veracrypt"])
        print("Run: veracrypt --create")

def cmd_status():
    print("Encryption Status:")
    # Check LUKS
    r = run(["sudo", "cryptsetup", "status"])
    if r.stdout:
        for line in r.stdout.splitlines():
            print(f"  LUKS: {line}")
    # Check if dm-crypt active
    r = run(["ls", "/dev/mapper/"])
    if r.stdout:
        for line in r.stdout.splitlines():
            if line not in ["control"]:
                print(f"  Active: {line}")
    # Check kernel support
    r = run(["lsmod"])
    if "dm_crypt" in r.stdout:
        print("  DM-Crypt: Loaded")
    if "aesni" in r.stdout:
        print("  AES-NI: Available (hardware acceleration)")

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        cmd_status()
        return
    cmd = sys.argv[1]
    if cmd == "setup" and len(sys.argv) >= 3:
        cmd_setup(sys.argv[2])
    elif cmd == "status":
        cmd_status()
    elif cmd == "wizard":
        print("Interactive encryption wizard...")
        print("Step 1: Select device")
        r = run(["lsblk", "-o", "NAME,SIZE,TYPE,MOUNTPOINT"])
        print(r.stdout)
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
