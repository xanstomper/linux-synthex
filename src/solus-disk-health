#!/usr/bin/env python3
"""Solus Disk Health — SMART + NVMe disk health monitor.
Usage:
    solus-disk-health                  Show all disk health
    solus-disk-health <device>         Check specific device
    solus-disk-health smart <device>   Show full SMART data
    solus-disk-health monitor          Daemon mode (periodic check)
"""
import os, sys, subprocess, json, time, glob

HEALTH_CACHE = "/var/lib/solus/disk-health.json"

def get_disks():
    disks = []
    for dev in glob.glob("/dev/sd?") + glob.glob("/dev/nvme?n?"):
        if os.path.exists(dev):
            disks.append(dev)
    return sorted(disks)

def smart_status(dev):
    """Get SMART health status for a device."""
    result = {"device": dev, "health": "UNKNOWN", "temp": "?", "hours": "?", "type": "?"}
    base = os.path.basename(dev)
    # Determine type
    if "nvme" in base:
        result["type"] = "NVMe"
        try:
            r = subprocess.run(["smartctl", "-H", dev], capture_output=True, text=True, timeout=10)
            if "PASSED" in r.stdout or "passed" in r.stdout:
                result["health"] = "PASSED"
            elif "FAILED" in r.stdout:
                result["health"] = "FAILED"
            # Temperature
            r2 = subprocess.run(["smartctl", "-A", dev], capture_output=True, text=True, timeout=10)
            for line in r2.stdout.splitlines():
                if "Temperature:" in line:
                    result["temp"] = line.split(":")[1].strip().split()[0]
                if "Power_On_Hours" in line:
                    parts = line.split()
                    if len(parts) >= 10:
                        result["hours"] = parts[9]
        except: pass
    else:
        result["type"] = "SATA/SAS"
        try:
            r = subprocess.run(["smartctl", "-H", dev], capture_output=True, text=True, timeout=10)
            if "PASSED" in r.stdout:
                result["health"] = "PASSED"
            elif "FAILED" in r.stdout:
                result["health"] = "FAILED"
            r2 = subprocess.run(["smartctl", "-A", dev], capture_output=True, text=True, timeout=10)
            for line in r2.stdout.splitlines():
                if "Temperature_Celsius" in line:
                    parts = line.split()
                    if len(parts) >= 10:
                        result["temp"] = parts[9]
                if "Power_On_Hours" in line:
                    parts = line.split()
                    if len(parts) >= 10:
                        result["hours"] = parts[9]
        except: pass
    return result

def cmd_default():
    disks = get_disks()
    if not disks:
        print("💾 No disks detected.")
        return
    print("💾 Solus Disk Health")
    print("═" * 60)
    for dev in disks:
        status = smart_status(dev)
        health_mark = "🟢" if status["health"] == "PASSED" else "🔴" if status["health"] == "FAILED" else "⚪"
        print(f"  {health_mark} {dev} ({status['type']})")
        print(f"     Health: {status['health']:8}  Temp: {status['temp']}°C  Power-On: {status['hours']}h")
    print()

def cmd_device(dev):
    if not os.path.exists(dev):
        print(f"❌ Device not found: {dev}")
        return
    print(f"💾 {dev}")
    print("═" * 60)
    r = subprocess.run(["smartctl", "-a", dev], capture_output=True, text=True, timeout=30)
    print(r.stdout[-2000:] if len(r.stdout) > 2000 else r.stdout)

def cmd_monitor():
    print("💾 Solus Disk Health Monitor starting...")
    while True:
        disks = get_disks()
        issues = []
        for dev in disks:
            status = smart_status(dev)
            if status["health"] == "FAILED":
                issues.append(f"❌ {dev}: HEALTH FAILED! Back up immediately!")
            elif status["health"] == "UNKNOWN":
                pass  # no SMART available
        # Cache results
        with open(HEALTH_CACHE, "w") as f:
            json.dump({d: smart_status(d) for d in disks}, f)
        time.sleep(3600)  # hourly

def main():
    if len(sys.argv) < 2:
        cmd_default()
    elif sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    elif sys.argv[1] == "smart" and len(sys.argv) >= 3:
        cmd_device(sys.argv[2])
    elif sys.argv[1] == "monitor":
        cmd_monitor()
    else:
        cmd_device(sys.argv[1])

if __name__ == "__main__":
    main()
