#!/usr/bin/env python3
"""Solus Agent — Native Desktop Frontend.
Taskbar AI assistant + Codex IDE + Knowledge Base.
Super+Space to open. No browser. No localhost.
"""
import os, sys, subprocess, threading, time, signal

HERE = os.path.dirname(os.path.abspath(__file__))
QML_PANEL = os.path.join(HERE, "ui", "Main.qml")
QML_CODEX = os.path.join(HERE, "codex", "ui", "Codex.qml")
DAEMON = os.path.join(HERE, "daemon", "solus-agentd")

def ensure_daemon():
    try:
        import dbus
        bus = dbus.SessionBus()
        obj = bus.get_object("org.solus.Agent", "/org/solus/Agent")
        obj.GetStatus(dbus_interface="org.solus.Agent", timeout=2)
        return
    except:
        pass
    print("🚀 Starting Solus Agent daemon...")
    subprocess.Popen([DAEMON], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(2)

def register_shortcut():
    try:
        subprocess.run(["kwriteconfig5", "--file", "kglobalshortcutsrc",
            "--group", "solus-agent", "--key", "_k_friendly_name", "Solus Agent"], capture_output=True)
        subprocess.run(["kwriteconfig5", "--file", "kglobalshortcutsrc",
            "--group", "solus-agent", "--key", "toggle_popup",
            "Meta+Space,none,Meta+Space,Toggle Solus Agent Panel"], capture_output=True)
    except:
        pass

def launch_qml(qml_file):
    for runner in ["qmlscene", "qml6", "qt6-qmlscene"]:
        path = subprocess.run(["which", runner], capture_output=True, text=True).stdout.strip()
        if path:
            os.execvp(runner, [runner, qml_file])
    print("❌ QML runtime not found. Install qt6-qtdeclarative")
    sys.exit(1)

def main():
    if "--daemon" in sys.argv:
        os.execv(DAEMON, [DAEMON])
    elif "--codex" in sys.argv:
        ensure_daemon()
        launch_qml(QML_CODEX)
    elif "--kb" in sys.argv:
        ensure_daemon()
        from daemon.solus_agentd import KnowledgeBase
        kb = KnowledgeBase()
        folders = sys.argv[2:] if len(sys.argv) > 2 else [os.path.expanduser("~/Documents")]
        total = 0
        for f in folders:
            c = kb.index_folder(f)
            print(f"  📚 {f}: {c} docs")
            total += c
        print(f"✅ Indexed {total} documents")
    else:
        ensure_daemon()
        register_shortcut()
        launch_qml(QML_PANEL)

if __name__ == "__main__":
    main()
