[Unit]
Description=SynthOS snapshot-manager service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.SnapshotManager
ExecStart=/usr/libexec/synthex/synthex-snapshot-manager
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
