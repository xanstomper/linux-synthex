[Unit]
Description=SynthOS sync service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.Sync
ExecStart=/usr/libexec/synthex/synthex-sync
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
