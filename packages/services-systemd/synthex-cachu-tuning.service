[Unit]
Description=SynthOS cachu-tuning service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.CachuTuning
ExecStart=/usr/libexec/synthex/synthex-cachu-tuning
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
