[Unit]
Description=SynthOS nvidia-installer service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.NvidiaInstaller
ExecStart=/usr/libexec/synthex/synthex-nvidia-installer
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
