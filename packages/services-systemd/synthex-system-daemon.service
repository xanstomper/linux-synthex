[Unit]
Description=SynthOS system-daemon service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.SystemDaemon
ExecStart=/usr/libexec/synthex/synthex-system-daemon
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
