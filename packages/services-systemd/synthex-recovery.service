[Unit]
Description=SynthOS recovery service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.Recovery
ExecStart=/usr/libexec/synthex/synthex-recovery
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
