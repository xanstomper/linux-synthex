[Unit]
Description=SynthOS wine-manager service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.WineManager
ExecStart=/usr/libexec/synthex/synthex-wine-manager
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
