[Unit]
Description=SynthOS service-manager service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.ServiceManager
ExecStart=/usr/libexec/synthex/synthex-service-manager
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
