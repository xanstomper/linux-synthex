[Unit]
Description=SynthOS codec-installer service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.CodecInstaller
ExecStart=/usr/libexec/synthex/synthex-codec-installer
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
