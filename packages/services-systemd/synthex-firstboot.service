[Unit]
Description=SynthOS firstboot service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.Firstboot
ExecStart=/usr/libexec/synthex/synthex-firstboot
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
