[Unit]
Description=SynthOS perf-tuning service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.PerfTuning
ExecStart=/usr/libexec/synthex/synthex-perf-tuning
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
