[Unit]
Description=SynthOS agent service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.Agent
ExecStart=/usr/libexec/synthex/synthex-agent
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
