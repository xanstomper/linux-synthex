[Unit]
Description=SynthOS update-manager service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.synthex.UpdateManager
ExecStart=/usr/libexec/synthex/synthex-update-manager
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=graphical-session.target
