[General]
font=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0
fixedFont=JetBrains Mono,10,-1,5,50,0,0,0,0,0
toolBarStyle=IconTextRight
compositingEnabled=true
animationsEnabled=true
desktopToolTips=1

[KDE Look and Feel]
Package=org.solus.desktop
Theme=Breeze

[KDE Global Theme]
Theme=org.solus.desktop

[Icons]
Theme=Solus-Tela-circle

[Plasma Theme]
theme=Solus-Fluent-Material

[Color Scheme]
ColorScheme=SolusFluent
Theme=SolusFluent
shading=41

[Fonts]
forceFontDPI=96
useFontDPI=true
antiAliasing=grayscale
hinting=slight
excludeRegular=Inter,10,-1,5,50,0,0,0,0,0

[Cursor]
Theme=Solus-Cursor
Size=24

[ScreenScaleFactors]
ScaleFactor=1

[KWin]
BlurEnabled=true
BlurStrength=30
TranslucencyEnabled=true
SlideEffect=1
BorderlessMaximizedWindows=true
WindowCornerRadius=12

[KWin/Effects]
blurEnabled=true
slideEnabled=true
fadeEnabled=true
dimScreenForMeEnabled=true
desktopCubeEnabled=false
magiclampEnabled=true
wobblywindowsEnabled=false
overviewEnabled=true
slideBackEnabled=true

[KWin/Script/overview]
Enabled=true

[KWin/Desktops]
Number=4
Rows=2
LayoutName=grid

[KWin/Windows]
Placement=Smart
SnapOnlyMaximizing=true
SnapOnlyTiling=true
BorderSnapZone=10
CenterSnapZone=50

[KWin/MouseBindings]
CommandTitleBar=Maximize
CommandTitleBarWheel=Shade
CommandWindowWheel=ChangeOpacity
ActivateRaised=true
InnerAction=Maximize

[KWin/Compositing]
AnimationSpeed=1
AnimationCurve=MaterialEased
Backend=OpenGL
OpenGLIsUnsafe=false

[KRunner]
ActivateOnPaste=true
HistoryBehavior=EnableHistory
TerminalCommand=konsole
FreeFloating=true

[Notification Center]
ShowNotificationsOnAllMonitors=false
DoNotDisturb=false

[Wallpaper]
plugin=image
DefaultWallpaper=/usr/share/wallpapers/solus-default.jpg
FillMode=2

[Task Manager]
Grouping=ByApplication
Sorting=Alpha
ShowOnlyCurrentDesktop=false
ShowOnlyCurrentScreen=true
ShowToolTips=true
MiddleClickAction=Close
Launcher=true

[Digital Clock]
DateFormat=dddd d MMMM
TimeFormat=HH:mm
ShowDate=true
ShowSeconds=false

[System Tray]
ShowAll=false

[System Tray Items]
networkmanagement=true
bluetooth=true
volume=true
battery=true
notifications=true
mediaplayer=true
clipboard=true
keyboard=true
keyboardlayout=true

[Power Management]
ButtonEvents.LidAction=1
ButtonEvents.PowerButtonAction=1
AC.PowerDownAction=2
AC.SuspendSession=0
Battery.PowerDownAction=2
Battery.SuspendSession=1
LowBattery.UseActionForBattery=true
LowBattery.BatteryAction=2
LowBattery.Level=15

[Screen Locking]
Timeout=5
LockOnResume=true
UnlockOnResume=false

[Desktop]
IconsEnabled=true
IconSize=3

[Screensaver]
Enabled=false
Timeout=10

[Shortcuts]
DefaultShortcuts=kde_defaults
CustomShortcuts=

[KDE Wallet]
Enabled=false
FirstUse=true

[Online Accounts]
Enabled=false

[Location]
Enabled=false

[KIO]
ConfirmDelete=false
TrashConfirmDelete=true

[File Associations]
text/html=firefox.desktop
application/pdf=okularApplication_pdf.desktop
image/png=gwenview.desktop

[Launch Feedback]
BusyCursor=true
TaskbarButton=true

[Proxy]
Enabled=false
Type=0

[Samba]
Enabled=false

[Privacy]
RecentFiles=true
RecentFilesMax=10
