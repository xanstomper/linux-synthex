// ╔══════════════════════════════════════════════════════════════╗
// ║  SynthOS Nova — Waybar Multi-Bar Configuration                  ║
// ║  Exact match to reference rice:                                ║
// ║  1. Top Floating Status Pill: [ ● Date  Time ]                ║
// ║  2. Bottom Floating Island Dock:                              ║
// ║     [ Left Tools | Center Pinned & Active Apps | Right Status]║
// ╚══════════════════════════════════════════════════════════════╝
[
    // ─── 1. TOP FLOATING STATUS PILL ──────────────────────────────────────────
    {
        "name": "top-pill",
        "layer": "top",
        "position": "top",
        "height": 38,
        "width": 320,
        "margin-top": 14,
        "margin-bottom": 0,
        "modules-center": [
            "custom/top-dot",
            "clock#top"
        ],
        "custom/top-dot": {
            "format": "●",
            "tooltip": "SynthOS Status: Active & Synced"
        },
        "clock#top": {
            "format": "{:%a, %d %B %Y   %I:%M %p}",
            "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "interval": 1
        }
    },

    // ─── 2. BOTTOM FLOATING ISLAND DOCK ───────────────────────────────────────
    {
        "name": "bottom-dock",
        "layer": "top",
        "position": "bottom",
        "height": 64,
        "margin-bottom": 16,
        "margin-left": 180,
        "margin-right": 180,
        "modules-left": [
            "custom/launcher",
            "custom/search",
            "custom/workspaces",
            "custom/notifications"
        ],
        "modules-center": [
            "wlr/taskbar"
        ],
        "modules-right": [
            "network",
            "bluetooth",
            "pulseaudio",
            "battery",
            "clock#dock"
        ],

        // ── Left Utility Island ──────────────────────────────────────────────
        "custom/launcher": {
            "format": "󰕰",
            "tooltip": "Application Launcher  (Super)",
            "on-click": "wofi --show drun || rofi -show drun || synthex-launcher",
            "interval": "once"
        },
        "custom/search": {
            "format": "󰍉",
            "tooltip": "Universal Search  (Super+Space)",
            "on-click": "wofi --show run || rofi -show run",
            "interval": "once"
        },
        "custom/workspaces": {
            "format": "󰹟",
            "tooltip": "Overview & Workspaces  (Super+Tab)",
            "on-click": "hyprctl dispatch togglespecialworkspace",
            "interval": "once"
        },
        "custom/notifications": {
            "format": "󰂚",
            "tooltip": "Notifications  (Super+N)",
            "on-click": "makoctl dismiss -a || dunstctl close-all",
            "interval": "once"
        },

        // ── Center Pinned & Running Apps ────────────────────────────────────
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 32,
            "icon-theme": "Papirus-Dark",
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "ignore-list": ["kitty", "alacritty-rice"],
            "app_ids-mapping": {
                "firefox": "firefox",
                "code": "visual-studio-code",
                "spotify": "spotify",
                "org.kde.dolphin": "system-file-manager",
                "discord": "discord",
                "Alacritty": "terminal"
            }
        },

        // ── Right Status Island ─────────────────────────────────────────────
        "network": {
            "format-wifi": "󰤨",
            "format-ethernet": "󰈀",
            "format-disconnected": "󰤭",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\nSpeed: ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
            "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
            "on-click": "nm-connection-editor || synthex-control-center --page network"
        },

        "bluetooth": {
            "format": "󰂯",
            "format-disabled": "󰂲",
            "format-connected": "󰂱",
            "tooltip-format": "Bluetooth: {status}",
            "tooltip-format-connected": "{controller_alias}\nConnected to: {device_alias}",
            "on-click": "blueman-manager || synthex-control-center --page bluetooth"
        },

        "pulseaudio": {
            "format": "{icon}",
            "format-muted": "󰖁",
            "format-icons": {
                "default": ["󰕿", "󰖀", "󰕾"]
            },
            "tooltip-format": "Volume: {volume}% {desc}",
            "on-click": "pavucontrol || synthex-control-center --page audio",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
        },

        "battery": {
            "format": "{icon}",
            "format-charging": "󰂄",
            "format-plugged": "󰚥",
            "format-icons": ["󰁺", "󰁼", "󰁾", "󰁿", "󰁹"],
            "tooltip-format": "{capacity}%  {timeTo}",
            "states": {
                "warning": 30,
                "critical": 15
            }
        },

        "clock#dock": {
            "format": "{:%I:%M %p}",
            "format-alt": "{:%b %d, %I:%M %p}",
            "tooltip-format": "{:%A, %d %B %Y}\n{:%H:%M:%S}",
            "interval": 1
        }
    }
]
