[Desktop Entry]
Type=Application
Name=Welcome to Synthex
Name[de]=Willkommen bei Synthex
Comment=First-run setup wizard
Comment[de]=Einrichtungsassistent für den ersten Start
Exec=synthex-welcome
Icon=start-here-synthex
Terminal=false
Categories=System;Settings;
StartupNotify=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
Keywords=welcome;setup;first;run;