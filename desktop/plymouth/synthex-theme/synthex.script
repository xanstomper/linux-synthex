#!/usr/bin/plymouthd
# ═══════════════════════════════════════════════════════════════════════════
#  SynthOS Plymouth Boot Theme — "Solaris"
#  Charcoal gradient, glowing periwinkle sun logo, elegant centered growth bar.
# ═══════════════════════════════════════════════════════════════════════════

# ── Background gradient ──────────────────────────────────────────────────────
Window.SetBackgroundTopColor    (0.051, 0.055, 0.071, 1.0);   # #0D0F14
Window.SetBackgroundBottomColor (0.102, 0.110, 0.133, 1.0);   # #1A1D24

# ── Logo ─────────────────────────────────────────────────────────────────────
logo_image  = Image("synthex-logo.png");
logo_sprite = Sprite();
logo_sprite.SetImage(logo_image);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 36);
logo_sprite.SetOpacity(0);

# ── "SynthOS" wordmark ───────────────────────────────────────────────────────
label_image  = Image.Text("SynthOS", 0.424, 0.533, 0.659, 1.0);   # periwinkle
label_sprite = Sprite();
label_sprite.SetImage(label_image);
label_sprite.SetX(Window.GetWidth()  / 2 - label_image.GetWidth()  / 2);
label_sprite.SetY(logo_sprite.GetY() + logo_image.GetHeight() + 14);
label_sprite.SetOpacity(0);

# ── Ambient glow behind logo (subtle pulsing halo) ───────────────────────────
glow_image  = Image.CreateFilledWith(logo_image.GetWidth() + 120,
                                     logo_image.GetHeight() + 120,
                                     0.424, 0.533, 0.659, 1.0);
glow_sprite = Sprite();
glow_sprite.SetImage(glow_image);
glow_sprite.SetX(logo_sprite.GetX() - 60);
glow_sprite.SetY(logo_sprite.GetY() - 60);
glow_sprite.SetOpacity(0);

# ── Progress bar (thin, centered, grows from middle) ─────────────────────────
BAR_W = 280; BAR_H = 3; BAR_Y_OFFSET = 96;

bar_bg_sprite = Sprite();
bar_bg_sprite.SetImage(Image.CreateFilledWith(BAR_W, BAR_H, 1.0, 1.0, 1.0, 1.0));
bar_bg_sprite.SetX(Window.GetWidth() / 2 - BAR_W / 2);
bar_bg_sprite.SetY(label_sprite.GetY() + label_image.GetHeight() + BAR_Y_OFFSET);
bar_bg_sprite.SetOpacity(0);

bar_sprite = Sprite();
bar_sprite.SetImage(Image.CreateFilledWith(1, BAR_H, 0.424, 0.533, 0.659, 1.0));
bar_sprite.SetX(Window.GetWidth() / 2);
bar_sprite.SetY(bar_bg_sprite.GetY());
bar_sprite.SetOpacity(0);

# ── State ────────────────────────────────────────────────────────────────────
boot_progress = 0;
frame_count   = 0;
fade_done     = 0;
dialog_visible = 0;

# ── Fade-in (logo, wordmark, glow ramp up over ~0.5s) ────────────────────────
fun fade_in(t) {
    alpha = Math.Min(1.0, t * 2.2);
    logo_sprite.SetOpacity(alpha);
    label_sprite.SetOpacity(alpha);
    glow_sprite.SetOpacity(alpha * 0.10);
    bar_bg_sprite.SetOpacity(alpha * 0.18);
}

# ── Pulsing glow + centered progress growth ──────────────────────────────────
fun refresh_callback() {
    frame_count++;
    local.elapsed = frame_count / 50.0;

    if (fade_done == 0) {
        fade_in(elapsed);
        if (elapsed >= 0.5) { fade_done = 1; }
    }

    # gentle halo pulse (sinusoidal between 0.05 and 0.16)
    pulse = 0.105 + 0.055 * Math.Sin(frame_count * 0.06);
    glow_sprite.SetOpacity(pulse * (fade_done == 1 ? 1.0 : Math.Min(1.0, local.elapsed * 2.2)));

    # progress bar grows from center outward, capped at full width
    w = Math.Clamp(Math.Int(BAR_W * boot_progress), 1, BAR_W);
    bar_sprite.SetImage(Image.CreateFilledWith(w, BAR_H, 0.424, 0.533, 0.659, 1.0));
    # keep centered while growing
    bar_sprite.SetX(Window.GetWidth() / 2 - w / 2);
    bar_sprite.SetOpacity(fade_done == 1 ? 0.95 : Math.Min(1.0, local.elapsed * 2.2) * 0.95);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    boot_progress = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── Quit (graceful fade out → hands off to SDDM) ─────────────────────────────
fun quit_callback() {
    logo_sprite.SetOpacity(0);
    label_sprite.SetOpacity(0);
    glow_sprite.SetOpacity(0);
    bar_sprite.SetOpacity(0);
    bar_bg_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);

# ── LUKS encryption passphrase dialog ────────────────────────────────────────
fun password_callback(action, bullets) {
    dialog_visible = 1;

    # prompt label
    prompt_img    = Image.Text("Disk Encryption Passphrase", 0.831, 0.886, 0.980, 1.0);
    prompt_sprite = Sprite();
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetX(Window.GetWidth() / 2 - prompt_img.GetWidth() / 2);
    prompt_sprite.SetY(Window.GetHeight() / 2 + 70);
    prompt_sprite.SetOpacity(0.9);

    # subtle underline field
    field_w = 260; field_h = 2;
    field_img = Image.CreateFilledWith(field_w, field_h, 0.424, 0.533, 0.659, 1.0);
    field_sprite = Sprite();
    field_sprite.SetImage(field_img);
    field_sprite.SetX(Window.GetWidth() / 2 - field_w / 2);
    field_sprite.SetY(prompt_sprite.GetY() + 28);
    field_sprite.SetOpacity(0.6);

    # bullet dots for entered characters
    bullet_str = "";
    for (i = 0; i < bullets; i++) { bullet_str += "●"; }
    bullet_img    = Image.Text(bullet_str, 0.424, 0.533, 0.659, 1.0);
    bullet_sprite = Sprite();
    bullet_sprite.SetImage(bullet_img);
    bullet_sprite.SetX(Window.GetWidth() / 2 - bullet_img.GetWidth() / 2);
    bullet_sprite.SetY(prompt_sprite.GetY() + 4);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

# ── Boot message line ────────────────────────────────────────────────────────
fun message_callback(text) {
    msg_img    = Image.Text(text, 0.353, 0.392, 0.502, 0.7);
    msg_sprite = Sprite();
    msg_sprite.SetImage(msg_img);
    msg_sprite.SetX(Window.GetWidth() / 2 - msg_img.GetWidth() / 2);
    msg_sprite.SetY(Window.GetHeight() - 44);
}
Plymouth.SetMessageFunction(message_callback);
