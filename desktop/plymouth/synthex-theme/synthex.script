#!/usr/bin/plymouthd
# Synthex Plymouth Boot Theme — script module
# /usr/share/plymouth/themes/synthex/synthex.script

# ── Background ────────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor    (0.043, 0.059, 0.102, 1.0);  # #0B0F1A
Window.SetBackgroundBottomColor (0.051, 0.075, 0.153, 1.0);  # #0D1327

# ── Logo ──────────────────────────────────────────────────────────────────────
logo_image  = Image("synthex-logo.png");
logo_sprite = Sprite();
logo_sprite.SetImage(logo_image);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40);
logo_sprite.SetOpacity(0);

# ── "SynthOS" text label ──────────────────────────────────────────────────────
label_image  = Image.Text("SynthOS", 1.0, 0.70, 0.0, 1.0);   # amber #FFB300 ≈ rgb(1,0.7,0)
label_sprite = Sprite();
label_sprite.SetImage(label_image);
label_sprite.SetX(Window.GetWidth()  / 2 - label_image.GetWidth()  / 2);
label_sprite.SetY(logo_sprite.GetY() + logo_image.GetHeight() + 16);
label_sprite.SetOpacity(0);

# ── Spinner ───────────────────────────────────────────────────────────────────
spinner_image  = Image("spinner.png");
spinner_sprite = Sprite();
spinner_sprite.SetImage(spinner_image);
spinner_sprite.SetX(Window.GetWidth()  / 2 - spinner_image.GetWidth()  / 2);
spinner_sprite.SetY(label_sprite.GetY() + label_image.GetHeight() + 24);
spinner_sprite.SetOpacity(0);

# ── Progress bar ──────────────────────────────────────────────────────────────
progress_bar_bg_image = Image.CreateFilledWith(300, 4, 0.165, 0.165, 0.243, 1.0); # #2A2A3E
progress_bar_image    = Image.CreateFilledWith(300, 4, 1.0,   0.70,  0.0,   1.0); # #FFB300

progress_bar_bg_sprite = Sprite();
progress_bar_bg_sprite.SetImage(progress_bar_bg_image);
progress_bar_bg_sprite.SetX(Window.GetWidth() / 2 - 150);
progress_bar_bg_sprite.SetY(spinner_sprite.GetY() + spinner_image.GetHeight() + 20);
progress_bar_bg_sprite.SetOpacity(0);

progress_bar_sprite = Sprite();
progress_bar_sprite.SetImage(progress_bar_image);
progress_bar_sprite.SetX(progress_bar_bg_sprite.GetX());
progress_bar_sprite.SetY(progress_bar_bg_sprite.GetY());
progress_bar_sprite.SetOpacity(0);

# ── Password dialog ───────────────────────────────────────────────────────────
dialog_visible = 0;

# ── Animation state ───────────────────────────────────────────────────────────
boot_progress    = 0;
spin_angle       = 0;
fade_in_done     = 0;
frame_count      = 0;

# ── Fade-in (first ~60 frames) ───────────────────────────────────────────────
fun fade_in(progress) {
    alpha = Math.Min(1.0, progress * 3.0);
    logo_sprite.SetOpacity(alpha);
    label_sprite.SetOpacity(alpha);
    spinner_sprite.SetOpacity(alpha);
    progress_bar_bg_sprite.SetOpacity(alpha * 0.6);
    progress_bar_sprite.SetOpacity(alpha * 0.6);
}

# ── Spinner rotation ──────────────────────────────────────────────────────────
fun spin_update() {
    spin_angle = (spin_angle + 8) % 360;
    spinner_sprite.SetImage(spinner_image.Rotate(spin_angle * Math.Pi / 180));
}

# ── Progress bar update ───────────────────────────────────────────────────────
fun progress_update(p) {
    w = Math.Clamp(Math.Int(300 * p), 1, 300);
    bar = Image.CreateFilledWith(w, 4, 1.0, 0.70, 0.0, 1.0);
    progress_bar_sprite.SetImage(bar);
    progress_bar_sprite.SetOpacity(1.0);
    progress_bar_bg_sprite.SetOpacity(1.0);
}

# ── Main refresh callback (called every frame) ────────────────────────────────
fun refresh_callback() {
    frame_count++;
    local.elapsed = frame_count / 50.0;          # ~50fps Plymouth default

    if (fade_in_done == 0) {
        fade_in(elapsed);
        if (elapsed >= 0.4) { fade_in_done = 1; }
    }

    spin_update();
    progress_update(boot_progress);
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Progress callback ─────────────────────────────────────────────────────────
fun progress_callback(duration, progress) {
    boot_progress = progress;
}

Plymouth.SetBootProgressFunction(progress_callback);

# ── Quit (fade out on login screen) ──────────────────────────────────────────
fun quit_callback() {
    logo_sprite.SetOpacity(0);
    label_sprite.SetOpacity(0);
    spinner_sprite.SetOpacity(0);
    progress_bar_sprite.SetOpacity(0);
    progress_bar_bg_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);

# ── Encryption password dialog ────────────────────────────────────────────────
fun password_callback(action, bullets) {
    dialog_visible = 1;
    # Render password prompt text
    prompt_img    = Image.Text("🔒  Disk Encryption Passphrase:", 0.533, 0.6, 0.867, 1.0);
    prompt_sprite = Sprite();
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetX(Window.GetWidth() / 2 - prompt_img.GetWidth() / 2);
    prompt_sprite.SetY(Window.GetHeight() / 2 + 60);

    # Render bullet dots
    bullet_str = "";
    for (i = 0; i < bullets; i++) { bullet_str += "●"; }
    bullet_img    = Image.Text(bullet_str, 1.0, 0.70, 0.0, 1.0);
    bullet_sprite = Sprite();
    bullet_sprite.SetImage(bullet_img);
    bullet_sprite.SetX(Window.GetWidth() / 2 - bullet_img.GetWidth() / 2);
    bullet_sprite.SetY(Window.GetHeight() / 2 + 88);
}

Plymouth.SetDisplayPasswordFunction(password_callback);

# ── Message display ───────────────────────────────────────────────────────────
fun message_callback(text) {
    msg_img    = Image.Text(text, 0.533, 0.6, 0.867, 0.7);
    msg_sprite = Sprite();
    msg_sprite.SetImage(msg_img);
    msg_sprite.SetX(Window.GetWidth() / 2 - msg_img.GetWidth() / 2);
    msg_sprite.SetY(Window.GetHeight() - 48);
}

Plymouth.SetMessageFunction(message_callback);
