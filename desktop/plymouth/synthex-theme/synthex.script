#!/usr/bin/ubersh

# Synthex Plymouth Theme

# Colors
Window.SetBackgroundTopColor (0.06, 0.06, 0.10, 1.0);
Window.SetBackgroundBottomColor (0.06, 0.06, 0.10, 1.0);

# Framerate
planes.dont_move = 1;

# Logo
logo = Image("synthex-logo.png");
logo.sprite = Pixmap(logo);
logo.x = Window.GetWidth() / 2 - logo.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.GetHeight() / 2;

# Spinner
spinner = Image("spinner.png");
spinner.sprite = Pixmap(spinner);
spinner.x = Window.GetWidth() / 2 - spinner.GetWidth() / 2;
spinner.y = logo.y + logo.GetHeight() + 30;

fun spin_it (t) {
    spinner.sprite.Set alpha (1.0);
    spinner.angle = Steps (180 * t);
}

# Boot text
boot_text = Image("loading-text.png");
boot_text.sprite = Pixmap(boot_text);
boot_text.x = Window.GetWidth() / 2 - boot_text.GetWidth() / 2;
boot_text.y = spinner.y + spinner.GetHeight() + 15;

# Bullet progress
progress = 0.0;
update_progress() {
    progress = bootsplash.GetProgress();
    if (progress > 1.0) progress = 1.0;
}

# Main loop
fun mainLoop () {
    update_progress();

    logo.sprite.SetAlpha(1.0);
    spin_it(progress);
    boot_text.sprite.SetAlpha(1.0);

    if (progress >= 1.0) {
        quit();
    }

    Frame();
}
