[Desktop Entry]
Type=Service
Name=Synthex System
Comment=Manage Synthex services, updates, and system health
Icon=preferences-system
Exec=/usr/bin/synthex-control-center --page system
X-KDE-ServiceTypes=KCModule
X-KDE-ParentApp=kcm_shell
X-KDE-ParentComponents=SolusSystem
X-KDE-Library=kcm_shell
X-KDE-FactoryName=synthex-system
X-KDE-ParentWidget=true
Categories=Qt;KDE;System;Settings;
OnlyShowIn=KDE;
