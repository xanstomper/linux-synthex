[Desktop Entry]
Type=Service
Name=Synthex Performance
Comment=Configure CPU governor, GPU profile, and system tuning
Icon=preferences-system-performance
Exec=/usr/bin/synthex-control-center --page performance
X-KDE-ServiceTypes=KCModule
X-KDE-ParentApp=kcm_shell
X-KDE-ParentComponents=SynthexPerformance
X-KDE-Library=kcm_shell
X-KDE-FactoryName=synthex-performance
X-KDE-ParentWidget=true
Categories=Qt;KDE;System;Settings;
OnlyShowIn=KDE;
