[Desktop Entry]
Type=Service
Name=Solus System
Comment=Manage Solus services, updates, and system health
Icon=preferences-system
Exec=/usr/bin/solus-control-center --page system
X-KDE-ServiceTypes=KCModule
X-KDE-ParentApp=kcm_shell
X-KDE-ParentComponents=SolusSystem
X-KDE-Library=kcm_shell
X-KDE-FactoryName=solus-system
X-KDE-ParentWidget=true
Categories=Qt;KDE;System;Settings;
OnlyShowIn=KDE;
