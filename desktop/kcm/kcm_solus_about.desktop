[Desktop Entry]
Type=Service
Name=Solus About
Comment=About Solus Linux — version, kernel, system info
Icon=help-about
Exec=/usr/bin/solus-control-center --page about
X-KDE-ServiceTypes=KCModule
X-KDE-ParentApp=kcm_shell
X-KDE-ParentComponents=SolusAbout
X-KDE-Library=kcm_shell
X-KDE-FactoryName=solus-about
X-KDE-ParentWidget=true
Categories=Qt;KDE;System;Settings;
OnlyShowIn=KDE;
