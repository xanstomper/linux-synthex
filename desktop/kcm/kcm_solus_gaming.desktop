[Desktop Entry]
Type=Service
Name=Solus Gaming
Comment=Configure gaming mode, performance, and controller support
Icon=applications-games
Exec=/usr/bin/solus-control-center --page gaming
X-KDE-ServiceTypes=KCModule
X-KDE-ParentApp=kcm_shell
X-KDE-ParentComponents=SolusGaming
X-KDE-Library=kcm_shell
X-KDE-FactoryName=solus-gaming
X-KDE-ParentWidget=true
Categories=Qt;KDE;System;Settings;
OnlyShowIn=KDE;
