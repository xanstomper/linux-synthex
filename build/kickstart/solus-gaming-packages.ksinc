# Solus Linux Gaming Platform
# Kickstart Include: solus-gaming-packages.ksinc
#
# Include this file in a Solus kickstart to add gaming packages.
# Usage: %include solus-gaming-packages.ksinc

# ── Graphics Drivers ──────────────────────────────────────────

# AMD GPU stack
@amdgpu-drivers
mesa-dri-drivers
mesa-vulkan-drivers
mesa-va-drivers
mesa-vdpau-drivers
libva
libva-utils
vulkan-loader
vulkan-tools
linux-firmware-amd

# Intel GPU stack
@intel-gpu-drivers
intel-media-driver
intel-vaapi-driver
intel-compute-runtime
intel-gpu-tools
linux-firmware-intel

# NVIDIA GPU stack (proprietary + Nouveau packages)
kernel-driver-nvidia
kernel-driver-nouveau
nvidia-driver
nvidia-settings
nvidia-utils
nvidia-compute-utils
linux-firmware-nvidia

# ── Core Gaming Meta-Packages ─────────────────────────────────

solus-gaming-platform
solus-gpu-drivers
solus-gaming-control-center
solus-gaming-tools
solus-steam-optimizer

# ── Game Launchers ────────────────────────────────────────────

steam
steam-devices
lutris
heroic-games-launcher

# ── Wine / Proton / Compatibility Layers ─────────────────────

wine-core
wine-proton
wine-wayland
wine-staging
wine-ge-custom
dxvk
dxvk-ge
vkd3d-proton

# ── Gaming Tools ──────────────────────────────────────────────

gamemode
gamemode-devel
gamescope
mangohud
goverlay
vkbasalt
preload
mangoplot

# ── Shader Cache Management ──────────────────────────────────

dxvk-state-cache-manager
mesa-shader-cache-tools

# ── Performance Monitoring ────────────────────────────────────

s-tui
stress
stress-ng
cpupower
cpufrequtils
powerstat
turbostat
perf

# ── Controller Support ────────────────────────────────────────

joycond
ds4drv
xpadneo
xow
antimicrox
sc-controller
game-devices-udev

# ── Network Optimization ──────────────────────────────────────

bbr-tuning
irqbalance
irqbalance-ui

# ── Benchmarking ──────────────────────────────────────────────

unigine-heaven
unigine-valley
unigine-superposition
gputest
glmark2
glxgears (mesa-demos)
vulkaninfo (vulkan-tools)
phoronix-test-suite

# ── Audio ─────────────────────────────────────────────────────

pipewire
pipewire-pulseaudio
pipewire-alsa
easyeffects
pulseeffects (legacy)

# ── Recording / Streaming ─────────────────────────────────────

obs-studio
obs-studio-vkcapture
gpu-screen-recorder
wl-screenrec
replay-sorcery

# ── Additional Utilities ──────────────────────────────────────

protontricks
protonup-qt
winetricks
bottles
game-mode-tools
gaming-accessories
corectrl
lact (Linux AMD Control Tool)
nvtop
radeontop
greenwithenvy (nvidia GPU monitoring)

# ── Minecraft + Emulation ─────────────────────────────────────

prism-launcher
retroarch
dolphin-emu
rpcs3
pcsx2
ppsspp
mame
emudeck

# ── Game Streaming (Bazzite-style) ────────────────────────────

sunshine
moonlight

# ── VR Support ────────────────────────────────────────────────

monado
alvr
steamvr

# ── Controller Input Remapping ────────────────────────────────

antimicrox
sc-controller
input-remapper

# ── Decky Loader (Steam Deck plugin loader) ───────────────────

decky-loader

# ── Handheld Daemon (ROG Ally / Legion Go TDP + gyro) ────────

handheld-daemon

# ── Low-latency Audio ─────────────────────────────────────────

rtkit
realtime-setup

# ── Distrobox (container dev, Bazzite) ────────────────────────

distrobox
