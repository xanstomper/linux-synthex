# Synthex Linux — RPM Build Environment with Rust support
# Based on Fedora 41 with complete toolchain for building all Rust daemons + utilities
FROM fedora:41

LABEL maintainer="Synthex Linux Team <dev@solus.org>"
LABEL description="Synthex RPM build environment with rustc + cargo — builds Rust daemons and utilities into RPM packages"

# Install ALL build dependencies
RUN dnf install -y \
    # RPM build tools
    rpm-build rpmdevtools createrepo_c dnf5-plugins rpmlint mock \
    # C/C++ toolchain (kernel modules, daemon deps)
    gcc gcc-c++ make cmake autoconf automake libtool \
    # Qt6/KF6 for desktop daemons
    qt6-qtbase-devel qt6-qtdeclarative-devel kf6-kconfig-devel kf6-kcoreaddons-devel \
    kf6-kdbusaddons-devel kf6-knotifications-devel kf6-kwindowsystem-devel \
    # System deps
    systemd-devel libudev-devel libattr-devel \
    elfutils-libelf-devel elfutils-devel \
    openssl-devel pciutils-devel \
    # Rust toolchain
    rust-toolchain cargo rust-std rust-src \
    # Additional Rust build deps
    cmake ninja-build pkgconfig \
    # Compression for source archives
    tar gzip bzip2 xz zstd \
    # Version control
    git-core \
    # Cleanup
    && dnf clean all

# Create RPM build tree
RUN mkdir -p /build/rpmbuild/{BUILD,RPMS,SOURCES,SPECS,SRPMS} \
    && mkdir -p /build/repo/{x86_64,noarch,src}

# Default environment
ENV CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1 \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Default command: build all RPMs
WORKDIR /build
CMD ["/build/scripts/build-all-rpms.sh"]

# Health check: verify Rust is available
RUN rustc --version && cargo --version
