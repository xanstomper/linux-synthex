[Unit]
Description=Solus Slim Services — disable unused background daemons
After=solus-firstboot.service solus-hwdaemon.service
ConditionPathExists=/var/lib/solus/firstboot-complete
ConditionPathExists=!/var/lib/solus/slim-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/solus/solus-slim-services
ExecStartPost=/usr/bin/bash -c 'touch /var/lib/solus/slim-done'
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
