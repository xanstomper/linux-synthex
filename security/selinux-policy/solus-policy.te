###############################################################################
# solus-policy.te
# SELinux policy module for Solus Linux system services
#
# Version: 2.0.0
# Target: Solus Linux (KDE Plasma / Hyprland / GNOME)
# Policy Version: 33 (Fedora-based)
#
# Covers:
#   - solus-stored (Software Center daemon)
#   - solus-desktopd (Desktop customization daemon)
#   - solus-hwdaemon (Hardware detection)
#   - solus-gpu-setupd (GPU driver setup)
#   - solus-control-center (Settings GUI)
#   - solus-security-dashboard (Security health checker)
#   - solus-workspace (Mode switcher)
#   - solus-ai-hub (AI backend)
#   - solus-oobe (First-run wizard)
#   - solus-recovery (Boot recovery)
###############################################################################

policy_module(solus-policy, 2.0.0)

########################################
# 1. Core Types and Attributes
########################################

attribute solus_domain;

# Daemon domains
type solus_stored_t;
domain_type(solus_stored_t)
typeattribute solus_stored_t solus_domain;

type solus_desktopd_t;
domain_type(solus_desktopd_t)
typeattribute solus_desktopd_t solus_domain;

type solus_hwdaemon_t;
domain_type(solus_hwdaemon_t)
typeattribute solus_hwdaemon_t solus_domain;

type solus_gpu_setupd_t;
domain_type(solus_gpu_setupd_t)
typeattribute solus_gpu_setupd_t solus_domain;

type solus_control_center_t;
domain_type(solus_control_center_t)
typeattribute solus_control_center_t solus_domain;

type solus_security_dashboard_t;
domain_type(solus_security_dashboard_t)
typeattribute solus_security_dashboard_t solus_domain;

type solus_workspace_t;
domain_type(solus_workspace_t)
typeattribute solus_workspace_t solus_domain;

type solus_ai_hub_t;
domain_type(solus_ai_hub_t)
typeattribute solus_ai_hub_t solus_domain;

type solus_oobe_t;
domain_type(solus_oobe_t)
typeattribute solus_oobe_t solus_domain;

type solus_recovery_t;
domain_type(solus_recovery_t)
typeattribute solus_recovery_t solus_domain;

# Supporting file types
type solus_data_t;
files_type(solus_data_t)

type solus_var_lib_t;
files_type(solus_var_lib_t)

type solus_var_run_t;
files_type(solus_var_run_t)

type solus_log_t;
logging_log_file(solus_log_t)

type solus_cache_t;
files_type(solus_cache_t)

type solus_tmp_t;
files_type(solus_tmp_t)

# Executable types
type solus_stored_exec_t;
files_type(solus_stored_exec_t)

type solus_desktopd_exec_t;
files_type(solus_desktopd_exec_t)

type solus_hwdaemon_exec_t;
files_type(solus_hwdaemon_exec_t)

type solus_gpu_setupd_exec_t;
files_type(solus_gpu_setupd_exec_t)

type solus_control_center_exec_t;
files_type(solus_control_center_exec_t)

type solus_security_dashboard_exec_t;
files_type(solus_security_dashboard_exec_t)

type solus_workspace_exec_t;
files_type(solus_workspace_exec_t)

type solus_ai_hub_exec_t;
files_type(solus_ai_hub_exec_t)

type solus_oobe_exec_t;
files_type(solus_oobe_exec_t)

type solus_recovery_exec_t;
files_type(solus_recovery_exec_t)

########################################
# 2. Domain Transitions
########################################

domain_entry_file(solus_stored_t, solus_stored_exec_t)
domain_entry_file(solus_desktopd_t, solus_desktopd_exec_t)
domain_entry_file(solus_hwdaemon_t, solus_hwdaemon_exec_t)
domain_entry_file(solus_gpu_setupd_t, solus_gpu_setupd_exec_t)
domain_entry_file(solus_control_center_t, solus_control_center_exec_t)
domain_entry_file(solus_security_dashboard_t, solus_security_dashboard_exec_t)
domain_entry_file(solus_workspace_t, solus_workspace_exec_t)
domain_entry_file(solus_ai_hub_t, solus_ai_hub_exec_t)
domain_entry_file(solus_oobe_t, solus_oobe_exec_t)
domain_entry_file(solus_recovery_t, solus_recovery_exec_t)

# Allow init to launch Solus daemons
init_daemon_domain(solus_stored_t, solus_stored_exec_t)
init_daemon_domain(solus_desktopd_t, solus_desktopd_exec_t)
init_daemon_domain(solus_hwdaemon_t, solus_hwdaemon_exec_t)
init_daemon_domain(solus_gpu_setupd_t, solus_gpu_setupd_exec_t)
init_daemon_domain(solus_ai_hub_t, solus_ai_hub_exec_t)
init_daemon_domain(solus_oobe_t, solus_oobe_exec_t)
init_daemon_domain(solus_recovery_t, solus_recovery_exec_t)

########################################
# 3. Base Domain Permissions
########################################

# Shared permissions for all Solus domains
allow solus_domain self:process { signal sigchld getattr setrlimit };
allow solus_domain self:fifo_file { read write };
allow solus_domain self:unix_stream_socket { create connect listen accept read write };
allow solus_domain self:unix_dgram_socket { create connect read write };

# FDs inherited from init
allow solus_domain init_t:fd use;

# Basic filesystem access
files_read_usr_files(solus_domain)
libs_use_ld_so(solus_domain)
libs_use_shared_libs(solus_domain)

# /dev devices
dev_read_rand(solus_domain)
dev_read_urand(solus_domain)
dev_read_sysfs(solus_domain)

# Proc access
kernel_read_system_state(solus_domain)
kernel_read_network_state(solus_domain)

# Terminal access for interactive domains
allow { solus_control_center_t solus_security_dashboard_t solus_oobe_t }
      devpts_t:chr_file { read write ioctl };

# syslog
logging_send_syslog_msg(solus_domain)

########################################
# 4. solus-stored (Software Center Daemon)
########################################

# D-Bus session bus
dbus_session_domain(solus_stored_t)
allow solus_stored_t self:dbus { send_msg acquire_svc };

# Package management
allow solus_stored_t self:capability { sys_admin };
allow solus_stored_t rpm_var_lib_t:dir { search read write add_name remove_name };
allow solus_stored_t rpm_var_lib_t:file { read getattr create write unlink };
allow solus_stored_t rpm_var_lib_t:lnk_file read;

# Execute RPM
corecmd_exec_bin(solus_stored_t)
can_exec(solus_stored_t, rpm_exec_t)

# Network for repos
sysnet_dns_name_resolve(solus_stored_t)
corenet_tcp_connect_http_port(solus_stored_t)
corenet_tcp_connect_https_port(solus_stored_t)

# Flatpak integration
allow solus_stored_t flatpak_var_lib_t:dir { search read };
allow solus_stored_t flatpak_var_lib_t:file { read getattr };

# Cache management
allow solus_stored_t solus_cache_t:dir { create read write search add_name remove_name };
allow solus_stored_t solus_cache_t:file { create read write unlink rename };

# BTRFS snapshots for rollback
allow solus_stored_t self:capability sys_admin;
allow solus_stored_t fixed_disk_device_t:blk_file { read write ioctl };

# D-Bus communications
allow solus_stored_t policykit_t:dbus send_msg;
allow solus_stored_t fwupd_t:dbus send_msg;

########################################
# 5. solus-desktopd (Desktop Customization)
########################################

dbus_session_domain(solus_desktopd_t)
allow solus_desktopd_t self:dbus { send_msg acquire_svc };

# KDE Plasma config
allow solus_desktopd_t user_home_dir_t:dir search;
allow solus_desktopd_t user_home_t:dir { read search };
read_files_pattern(solus_desktopd_t, user_home_t, user_home_t)
write_files_pattern(solus_desktopd_t, user_home_t, user_home_t)

# Execute KDE tools
corecmd_exec_bin(solus_desktopd_t)
can_exec(solus_desktopd_t, bin_t)

# Service management
allow solus_desktopd_t self:capability { sys_admin sys_nice };
allow solus_desktopd_t init_t:system { status start stop };
allow solus_desktopd_t systemd_unit_file_t:file { read getattr };
allow solus_desktopd_t systemd_unit_file_t:dir search;

# D-Bus system services
allow solus_desktopd_t accountsd_t:dbus send_msg;
allow solus_desktopd_t colord_t:dbus send_msg;

# Wayland access
allow solus_desktopd_t xserver_t:unix_stream_socket { connectto read write };

########################################
# 6. solus-hwdaemon (Hardware Detection)
########################################

# Read-only hardware detection from sysfs
dev_read_sysfs(solus_hwdaemon_t)
allow solus_hwdaemon_t self:capability { sys_admin dac_override };
kernel_read_system_state(solus_hwdaemon_t)

# Read /sys/class/*
files_read_kernel_modules(solus_hwdaemon_t)
dev_read_urand(solus_hwdaemon_t)

# Write runtime profile
allow solus_hwdaemon_t solus_var_run_t:dir { create read write search add_name };
allow solus_hwdaemon_t solus_var_run_t:file { create read write };
manage_files_pattern(solus_hwdaemon_t, solus_var_run_t, solus_var_run_t)

# USB device enumeration for VR/RGB/peripheral detection
allow solus_hwdaemon_t usb_device_t:dir search;
allow solus_hwdaemon_t usb_device_t:file { read getattr };

# DRM device enumeration for GPU/monitor detection
allow solus_hwdaemon_t sysfs_t:dir search;
allow solus_hwdaemon_t sysfs_t:file { read getattr };

########################################
# 7. solus-gpu-setupd (GPU Driver Setup)
########################################

# Required for GPU driver installation
allow solus_gpu_setupd_t self:capability { sys_admin sys_module dac_override };
allow solus_gpu_setupd_t self:process { setrlimit };

# Execute package manager
corecmd_exec_bin(solus_gpu_setupd_t)
can_exec(solus_gpu_setupd_t, rpm_exec_t)

# GPU detection
dev_read_sysfs(solus_gpu_setupd_t)

# Write GPU profile
allow solus_gpu_setupd_t solus_var_run_t:dir { create read write search add_name };
allow solus_gpu_setupd_t solus_var_run_t:file { create read write };

# Kernel module operations
allow solus_gpu_setupd_t modules_object_t:file { read getattr };
allow solus_gpu_setupd_t modules_object_t:dir search;

# D-Bus for hwdaemon coordination
allow solus_gpu_setupd_t self:dbus { send_msg };
allow solus_gpu_setupd_t solus_hwdaemon_t:dbus send_msg;

########################################
# 8. solus-control-center (Settings GUI)
########################################

dbus_session_domain(solus_control_center_t)
allow solus_control_center_t self:dbus { send_msg acquire_svc };

# Wayland/KDE display
allow solus_control_center_t xserver_t:unix_stream_socket { connectto read write };

# User home for config
allow solus_control_center_t user_home_dir_t:dir search;
read_files_pattern(solus_control_center_t, user_home_t, user_home_t)
write_files_pattern(solus_control_center_t, user_home_t, user_home_t)

# D-Bus to Solus daemons
allow solus_control_center_t { solus_desktopd_t solus_stored_t solus_hwdaemon_t }:dbus send_msg;

# System settings
allow solus_control_center_t self:capability { sys_admin sys_nice };
allow solus_control_center_t power_device_t:dir search;
allow solus_control_center_t power_device_t:file { read write };

########################################
# 9. solus-security-dashboard
########################################

dbus_session_domain(solus_security_dashboard_t)
allow solus_security_dashboard_t self:dbus { send_msg acquire_svc };

# Read security state
selinux_read_policy(solus_security_dashboard_t)
allow solus_security_dashboard_t selinux_config_t:file { read getattr };
allow solus_security_dashboard_t selinux_config_t:dir search;
allow solus_security_dashboard_t security_t:dir search;
allow solus_security_dashboard_t security_t:file { read getattr };

# Read audit logs
allow solus_security_dashboard_t auditd_log_t:dir search;
allow solus_security_dashboard_t auditd_log_t:file { read getattr };

# Journal access
allow solus_security_dashboard_t journalctl_exec_t:file { read getattr execute };
can_exec(solus_security_dashboard_t, journalctl_exec_t)

# Firewalld status
allow solus_security_dashboard_t firewalld_t:dbus send_msg;

# Display
allow solus_security_dashboard_t xserver_t:unix_stream_socket { connectto read write };

# Read system state
allow solus_security_dashboard_t self:capability dac_read_search;

########################################
# 10. solus-workspace (Mode Switcher)
########################################

allow solus_workspace_t self:capability { sys_admin sys_nice sys_resource };
corecmd_exec_bin(solus_workspace_t)
can_exec(solus_workspace_t, bin_t)

# CPU governor tuning
allow solus_workspace_t sysfs_t:dir search;
allow solus_workspace_t sysfs_t:file { read write };

# sysctl
allow solus_workspace_t proc_t:file { read write };
allow solus_workspace_t proc_t:dir search;

# Service management
allow solus_workspace_t init_t:system { status start stop };
allow solus_workspace_t systemd_unit_file_t:file { read getattr };
allow solus_workspace_t systemd_unit_file_t:dir search;

# Logging
allow solus_workspace_t self:dbus { send_msg };

########################################
# 11. solus-ai-hub (AI Backend)
########################################

init_daemon_domain(solus_ai_hub_t, solus_ai_hub_exec_t)
allow solus_ai_hub_t self:capability { net_bind_service sys_nice ipc_lock };

# Network
sysnet_dns_name_resolve(solus_ai_hub_t)
corenet_tcp_bind_generic_port(solus_ai_hub_t)
corenet_tcp_connect_http_port(solus_ai_hub_t)
corenet_tcp_connect_https_port(solus_ai_hub_t)

# GPU access for acceleration
allow solus_ai_hub_t dri_device_t:chr_file { read write ioctl open };
allow solus_ai_hub_t kfd_device_t:chr_file { read write ioctl open };

# IPC with Ollama
allow solus_ai_hub_t self:unix_stream_socket { create connect listen accept };

# Write models
allow solus_ai_hub_t solus_var_lib_t:dir { create read write search add_name remove_name };
allow solus_ai_hub_t solus_var_lib_t:file { create read write unlink rename };

# Logs
allow solus_ai_hub_t solus_log_t:dir { create read write search add_name };
allow solus_ai_hub_t solus_log_t:file { create read write append };

# D-Bus
allow solus_ai_hub_t self:dbus { send_msg acquire_svc };

########################################
# 12. solus-oobe (First-Run Wizard)
########################################

dbus_session_domain(solus_oobe_t)
allow solus_oobe_t self:dbus { send_msg acquire_svc };

# Display
allow solus_oobe_t xserver_t:unix_stream_socket { connectto read write };

# User creation
allow solus_oobe_t self:capability { sys_admin sys_chroot };
allow solus_oobe_t accountsd_t:dbus send_msg;

# Write user config
corecmd_exec_bin(solus_oobe_t)

# Package install for OOBE bundles
allow solus_oobe_t rpm_var_lib_t:dir { search read };
allow solus_oobe_t rpm_var_lib_t:file { read getattr };

# Enable services
allow solus_oobe_t init_t:system { status start stop enable disable };
allow solus_oobe_t systemd_unit_file_t:dir search;
allow solus_oobe_t systemd_unit_file_t:file { read getattr };

########################################
# 13. solus-recovery (Boot Recovery)
########################################

allow solus_recovery_t self:capability { sys_admin sys_chroot sys_boot };
allow solus_recovery_t fixed_disk_device_t:blk_file { read write ioctl };
allow solus_recovery_t devpts_t:chr_file { read write ioctl };

# BTRFS snapshot operations
allow solus_recovery_t snapperd_data_t:dir { read search };
allow solus_recovery_t snapperd_data_t:file { read getattr };

# Mount operations
allow solus_recovery_t fs_t:dir { mounton search };
allow solus_recovery_t fs_t:filesystem mount;

# Execute recovery tools
corecmd_exec_bin(solus_recovery_t)
corecmd_exec_shell(solus_recovery_t)

# Logging
allow solus_recovery_t solus_log_t:dir { create read write search add_name };
allow solus_recovery_t solus_log_t:file { create read write append };

########################################
# 14. File Contexts (see solus-policy.fc)
########################################
########################################
# 15. Neverallow Rules
########################################

# Never write to system binaries
neverallow solus_domain bin_t:file { write unlink rename };

# Never shadow access
neverallow solus_domain shadow_t:file { read write };

# Never kernel memory access
neverallow solus_domain kmem_device_t:chr_file { read write };
neverallow solus_domain mem_device_t:chr_file { read write };

# Never modify SELinux policy (except security dashboard for status reads)
neverallow { solus_stored_t solus_desktopd_t solus_hwdaemon_t
             solus_gpu_setupd_t solus_control_center_t solus_workspace_t
             solus_ai_hub_t solus_oobe_t solus_recovery_t }
           selinux_config_t:file write;

# Never ptrace across domains
neverallow solus_domain ~solus_domain:process ptrace;

# Never load kernel modules (except gpu-setupd which installs GPU drivers)
neverallow { solus_stored_t solus_desktopd_t solus_hwdaemon_t
             solus_control_center_t solus_security_dashboard_t
             solus_workspace_t solus_ai_hub_t solus_oobe_t
             solus_recovery_t }
           modules_object_t:file write;

########################################
# 16. Optional Boolean Policies
########################################

# Check booleans declared in solus-policy.if
tunable_policy(`solus_use_nfs', `
    allow solus_stored_t nfs_t:dir { read search };
')

tunable_policy(`solus_use_samba', `
    allow solus_stored_t cifs_t:dir { read search };
')

tunable_policy(`solus_dashboard_debug', `
    allow solus_security_dashboard_t var_log_t:dir search;
    allow solus_security_dashboard_t var_log_t:file { read getattr };
')
