# Solus SELinux file context mappings
# Maps filesystem paths to SELinux types defined in solus-policy.te

# === Solus system binaries ===
/usr/bin/solus-stored		--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/solus-desktopd		--	system_u:object_r:solus_desktopd_exec_t:s0
/usr/bin/solus-hwdaemon		--	system_u:object_r:solus_hwdaemon_exec_t:s0
/usr/bin/solus-gpu-setupd	--	system_u:object_r:solus_gpu_setupd_exec_t:s0
/usr/bin/solus-control-center	--	system_u:object_r:solus_control_center_exec_t:s0
/usr/bin/solus-security-dashboard --	system_u:object_r:solus_security_dashboard_exec_t:s0
/usr/bin/solus-workspace	--	system_u:object_r:solus_workspace_exec_t:s0
/usr/bin/solus-ai-hub		--	system_u:object_r:solus_ai_hub_exec_t:s0
/usr/bin/solus-oobe		--	system_u:object_r:solus_oobe_exec_t:s0
/usr/bin/solus-recovery		--	system_u:object_r:solus_recovery_exec_t:s0
/usr/bin/solus-firstboot\.sh	--	system_u:object_r:solus_oobe_exec_t:s0

# === Solus CLI tools ===
/usr/bin/solus\.py		--	system_u:object_r:solus_control_center_exec_t:s0
/usr/bin/solus-marketplace	--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/solus-blueprint	--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/solus-webapp-engine	--	system_u:object_r:solus_stored_exec_t:s0

# === libexec binaries ===
/usr/libexec/solus(/.*)?		system_u:object_r:solus_data_t:s0

# === Data directories ===
/usr/share/solus(/.*)?			system_u:object_r:solus_data_t:s0
/var/lib/solus(/.*)?			system_u:object_r:solus_var_lib_t:s0
/var/run/solus(/.*)?			system_u:object_r:solus_var_run_t:s0
/var/log/solus(/.*)?			system_u:object_r:solus_log_t:s0
/var/cache/solus(/.*)?			system_u:object_r:solus_cache_t:s0
/tmp/solus(/.*)?			system_u:object_r:solus_tmp_t:s0
