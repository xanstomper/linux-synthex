# Synthex SELinux file context mappings
# Maps filesystem paths to SELinux types defined in synthex-policy.te

# === Synthex system binaries ===
/usr/bin/synthex-stored		--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/synthex-desktopd		--	system_u:object_r:solus_desktopd_exec_t:s0
/usr/bin/synthex-hwdaemon		--	system_u:object_r:solus_hwdaemon_exec_t:s0
/usr/bin/synthex-gpu-setupd	--	system_u:object_r:solus_gpu_setupd_exec_t:s0
/usr/bin/synthex-control-center	--	system_u:object_r:solus_control_center_exec_t:s0
/usr/bin/synthex-security-dashboard --	system_u:object_r:solus_security_dashboard_exec_t:s0
/usr/bin/synthex-workspace	--	system_u:object_r:solus_workspace_exec_t:s0
/usr/bin/synthex-ai-hub		--	system_u:object_r:solus_ai_hub_exec_t:s0
/usr/bin/synthex-oobe		--	system_u:object_r:solus_oobe_exec_t:s0
/usr/bin/synthex-recovery		--	system_u:object_r:solus_recovery_exec_t:s0
/usr/bin/synthex-firstboot\.sh	--	system_u:object_r:solus_oobe_exec_t:s0

# === Synthex CLI tools ===
/usr/bin/synthex\.py		--	system_u:object_r:solus_control_center_exec_t:s0
/usr/bin/synthex-marketplace	--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/synthex-blueprint	--	system_u:object_r:solus_stored_exec_t:s0
/usr/bin/synthex-webapp-engine	--	system_u:object_r:solus_stored_exec_t:s0

# === libexec binaries ===
/usr/libexec/synthex(/.*)?		system_u:object_r:solus_data_t:s0

# === Data directories ===
/usr/share/synthex(/.*)?			system_u:object_r:solus_data_t:s0
/var/lib/synthex(/.*)?			system_u:object_r:solus_var_lib_t:s0
/var/run/synthex(/.*)?			system_u:object_r:solus_var_run_t:s0
/var/log/synthex(/.*)?			system_u:object_r:solus_log_t:s0
/var/cache/synthex(/.*)?			system_u:object_r:solus_cache_t:s0
/tmp/synthex(/.*)?			system_u:object_r:solus_tmp_t:s0
