[Unit]
Description=Synthex Boot Profile Recorder
Documentation=https://synthex-linux.org/docs/boot
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/libexec/synthex/boot-profile.py
RemainAfterExit=no
SuccessExitStatus=0 1
StandardOutput=journal

[Install]
WantedBy=multi-user.target
