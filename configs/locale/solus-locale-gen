#!/usr/bin/env bash
# /usr/sbin/solus-locale-gen — Generate locales for Solus
# Called during first boot to generate all commonly-used locales
set -euo pipefail

echo "🌍 Generating locales..."

# Common locales to generate
LOCALES=(
    "en_US.UTF-8"
    "en_GB.UTF-8"
    "de_DE.UTF-8"
    "fr_FR.UTF-8"
    "es_ES.UTF-8"
    "it_IT.UTF-8"
    "pt_BR.UTF-8"
    "pt_PT.UTF-8"
    "ru_RU.UTF-8"
    "ja_JP.UTF-8"
    "ko_KR.UTF-8"
    "zh_CN.UTF-8"
    "zh_TW.UTF-8"
    "ar_SA.UTF-8"
    "hi_IN.UTF-8"
    "tr_TR.UTF-8"
    "pl_PL.UTF-8"
    "nl_NL.UTF-8"
    "sv_SE.UTF-8"
    "cs_CZ.UTF-8"
    "el_GR.UTF-8"
    "fi_FI.UTF-8"
    "da_DK.UTF-8"
    "no_NO.UTF-8"
    "th_TH.UTF-8"
    "vi_VN.UTF-8"
    "id_ID.UTF-8"
    "ms_MY.UTF-8"
    "uk_UA.UTF-8"
    "ro_RO.UTF-8"
    "hu_HU.UTF-8"
    "sk_SK.UTF-8"
    "bg_BG.UTF-8"
    "hr_HR.UTF-8"
    "sr_RS.UTF-8"
    "sl_SI.UTF-8"
    "et_EE.UTF-8"
    "lv_LV.UTF-8"
    "lt_LT.UTF-8"
    "fa_IR.UTF-8"
    "he_IL.UTF-8"
    "bn_IN.UTF-8"
    "ta_IN.UTF-8"
    "te_IN.UTF-8"
    "ml_IN.UTF-8"
    "kn_IN.UTF-8"
    "gu_IN.UTF-8"
    "pa_IN.UTF-8"
    "mr_IN.UTF-8"
    "ur_PK.UTF-8"
)

# Write to locale.gen
LOCALE_GEN="/etc/locale.gen"
if [ -f "$LOCALE_GEN" ]; then
    cp "$LOCALE_GEN" "${LOCALE_GEN}.bak"
    for locale in "${LOCALES[@]}"; do
        # Uncomment the locale if it exists
        sed -i "s/^#${locale}/${locale}/" "$LOCALE_GEN" 2>/dev/null || true
    done
fi

# Generate locales
if command -v locale-gen &>/dev/null; then
    locale-gen
    echo "✅ Locales generated"
else
    echo "⚠️  locale-gen not available, using localectl"
    for locale in "${LOCALES[@]:0:5}"; do
        localectl set-locale "$locale" 2>/dev/null || true
    done
fi
