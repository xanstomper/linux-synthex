# /etc/systemd/system/solus-live-setup.service — Live ISO environment setup
# Runs on boot in the live environment to configure the live session

[Unit]
Description=Solus Live Image Setup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/run/solus-live

[Service]
Type=oneshot
ExecStart=/usr/libexec/solus/live-setup.sh
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=graphical.target
