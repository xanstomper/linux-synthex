<?xml version="1.0" encoding="UTF-8"?>
<!-- /etc/polkit-1/rules.d/49-solus.rules — Solus polkit rules -->

<!DOCTYPE polkit PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.0.dtd">
<polkit-config>

  <!-- Allow wheel group to manage without authentication for common tasks -->
  <match user="root">
    <return result="yes"/>
  </match>

  <!-- Allow package management without password for wheel -->
  <match action_id="org.freedesktop.packagekit.system-update">
    <match group="wheel">
      <return result="yes"/>
    </match>
  </match>

  <!-- Allow disk management for wheel -->
  <match action_id="org.freedesktop.udisks2.filesystem-mount-system">
    <match group="wheel">
      <return result="yes"/>
    </match>
  </match>

  <!-- Allow network configuration for wheel -->
  <match action_id="org.freedesktop.NetworkManager.settings.modify.system">
    <match group="wheel">
      <return result="yes"/>
    </match>
  </match>

  <!-- Allow firmware updates without password -->
  <match action_id="org.freedesktop.fwupd.*">
    <match group="wheel">
      <return result="yes"/>
    </match>
  </match>

</polkit-config>
