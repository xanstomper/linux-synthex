# /etc/sudoers.d/solus — Solus sudo configuration

# Allow wheel group to use sudo without password for specific commands
# (safe operations only — system updates, driver management)

# Full sudo for wheel group (with password)
%wheel ALL=(ALL) ALL

# Passwordless for safe operations
%wheel ALL=(ALL) NOPASSWD: /usr/bin/dnf5 update *
%wheel ALL=(ALL) NOPASSWD: /usr/bin/dnf5 upgrade *
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/solus/solus-safety-check
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/solus/hardware-detect.sh
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/solus/apply-theme.sh
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/solus/apply-cachy-tuning.sh
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/solus/apply-nobara-fixes.sh

# Allow flatpak operations without password
%wheel ALL=(ALL) NOPASSWD: /usr/bin/flatpak install *
%wheel ALL=(ALL) NOPASSWD: /usr/bin/flatpak update *
%wheel ALL=(ALL) NOPASSWD: /usr/bin/flatpak uninstall *

# Lecture/insults off for better UX
Defaults !lecture
Defaults !insults

# Always use a TTY for security
Defaults requiretty

# Increase sudo timeout (15 minutes)
Defaults timestamp_timeout=15

# Log sudo usage
Defaults logfile="/var/log/sudo.log"
