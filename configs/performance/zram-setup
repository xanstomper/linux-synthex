#!/usr/bin/env bash
# zram setup - safe: adds compressed RAM swap, keeps existing disk swap intact
exec 2>/dev/null
modprobe zram || true
if ls /dev/zram0 >/dev/null 2>&1 && ! /sbin/swapon --show | grep -q '/dev/zram0'; then
    echo lz4 > /sys/block/zram0/compressor 2>/dev/null || true
    mem=$(awk '/MemTotal/{print int($2/1024/2)}' /proc/meminfo)
    [ "$mem" -gt 8192 ] && mem=8192
    echo "${mem}M" > /sys/block/zram0/disksize 2>/dev/null || true
    /sbin/mkswap /dev/zram0 2>/dev/null || true
    /sbin/swapon /dev/zram0 -p 100 2>/dev/null || true
fi
exit 0
