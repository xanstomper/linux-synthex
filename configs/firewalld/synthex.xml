# /etc/firewalld/zones/synthex.xml — Synthex default firewall zone
# Slightly more permissive than Fedora default (for gaming/server)

<?xml version="1.0" encoding="utf-8"?>
<zone>
  <short>Synthex</short>
  <description>SynthOS default zone. Allows SSH, mDNS, and common gaming ports.</description>

  <!-- Services -->
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
  <service name="mdns"/>
  <service name="samba-client"/>

  <!-- Gaming: Steam Remote Play (TCP 27036) -->
  <port protocol="tcp" port="27036"/>
  <!-- Gaming: Steam Remote Play (UDP 27031-27036) -->
  <port protocol="udp" port="27031-27036"/>

  <!-- Gaming: Moonlight/Sunshine (TCP 47984, 47989, 48010) -->
  <port protocol="tcp" port="47984"/>
  <port protocol="tcp" port="47989"/>
  <port protocol="tcp" port="48010"/>

  <!-- Gaming: Moonlight/Sunshine (UDP 47998-48000) -->
  <port protocol="udp" port="47998-48000"/>

  <!-- LAN file sharing: Warpinator -->
  <port protocol="tcp" port="42000"/>
  <port protocol="udp" port="42000"/>

  <!-- RDP -->
  <port protocol="tcp" port="3389"/>

  <!-- VNC -->
  <port protocol="tcp" port="5900-5910"/>

  <rule family="ipv4">
    <source address="224.0.0.0/4"/>
    <accept/>
  </rule>
  <rule family="ipv6">
    <source address="ff00::/8"/>
    <accept/>
  </rule>
</zone>
