"""
synthex-rice — CLI customization tool for SynthOS Desktop Rice & Themes
Allows instantaneous tweaking of themes, accent colors, widget toggles, EQ presets, wallpapers, and presets.
"""

import argparse
import json
import os
import sys
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "synthex"
CONFIG_FILE = CONFIG_DIR / "rice.json"

THEME_PRESETS = {
    "nova": {"accent": "#7AA2F7", "secondary": "#BB9AF7", "surface": "#141923", "dock": "#12161F"},
    "tokyonight": {"accent": "#7AA2F7", "secondary": "#F7768E", "surface": "#1A1B26", "dock": "#16161E"},
    "catppuccin": {"accent": "#89B4FA", "secondary": "#CBA6F7", "surface": "#1E1E2E", "dock": "#181825"},
    "nord": {"accent": "#88C0D0", "secondary": "#81A1C1", "surface": "#2E3440", "dock": "#242933"},
    "cyberpunk": {"accent": "#00F0FF", "secondary": "#FF007F", "surface": "#0D0D18", "dock": "#07070F"},
    "oled": {"accent": "#60A5FA", "secondary": "#A78BFA", "surface": "#0A0A0A", "dock": "#000000"},
    "gruvbox": {"accent": "#D79921", "secondary": "#FE8019", "surface": "#282828", "dock": "#1D2021"},
    "rosepine": {"accent": "#EB6F92", "secondary": "#C4A7E7", "surface": "#191724", "dock": "#13101E"},
    "synthwave": {"accent": "#FF71CE", "secondary": "#01CDFE", "surface": "#1E122B", "dock": "#150C20"}
}


def load_config():
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "theme": "nova",
        "styleMode": "glass",
        "accentColor": "#7AA2F7",
        "secondaryColor": "#BB9AF7",
        "surfaceColor": "#141923",
        "dockColor": "#12161F",
        "cornerRadius": 18,
        "cardOpacity": 0.94,
        "dockSize": 40,
        "dockPosition": "bottom",
        "wallpaperPath": "file:///home/jewboy420/linux-synthex/branding/wallpaper/synthex-dark-4k.svg",
        "widgets": {
            "clock": True,
            "weather": True,
            "quickSettings": True,
            "mediaPlayer": True,
            "systemMonitor": True,
            "terminalRice": True,
            "dock": True,
            "topPill": True
        },
        "performanceMode": "balanced",
        "nightLight": False,
        "dnd": False,
        "eqPreset": "Balanced",
        "eqBands": [0, 2, 0, -1, 3]
    }


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

    # Sync Hyprland active theme
    try:
        accent = cfg.get("accentColor", "#7AA2F7").lstrip("#")
        secondary = cfg.get("secondaryColor", "#BB9AF7").lstrip("#")
        surface = cfg.get("surfaceColor", "#141923").lstrip("#")
        rounding = cfg.get("cornerRadius", 18)
        hypr_dir = Path.home() / ".config" / "hypr"
        hypr_dir.mkdir(parents=True, exist_ok=True)
        with open(hypr_dir / "synthex-theme.conf", "w") as f:
            f.write(f"""# SynthOS Auto-Generated Hyprland Theme
$accent = rgb({accent})
$secondary = rgb({secondary})
$surface = rgb({surface})
$active_border_color = rgb({accent}) rgb({secondary}) 45deg
$inactive_border_color = rgba(255, 255, 255, 0.1)
$rounding = {rounding}
""")
        os.system("hyprctl reload >/dev/null 2>&1")
    except Exception:
        pass

    print("\033[32m✔ SynthOS Rice configuration saved and synchronized with desktop!\033[0m")


def main():
    parser = argparse.ArgumentParser(description="SynthOS Desktop Rice & Theme Customizer")
    subparsers = parser.add_subparsers(dest="command")

    # Style command (Liquid Glass vs Solid Matte)
    style_p = subparsers.add_parser("style", help="Set visual finish (glass vs matte)")
    style_p.add_argument("mode", choices=["glass", "matte", "current"], help="Visual finish style")

    # Theme command
    theme_p = subparsers.add_parser("theme", help="Manage desktop themes")
    theme_p.add_argument("name", choices=list(THEME_PRESETS.keys()) + ["list", "current"], help="Theme preset name")

    # Accent command
    accent_p = subparsers.add_parser("accent", help="Set custom hex accent color")
    accent_p.add_argument("hex", help="Hex color code (e.g. #7AA2F7, #00F0FF, #E5A84B)")

    # Wallpaper command
    wall_p = subparsers.add_parser("wallpaper", help="Manage desktop background wallpaper")
    wall_p.add_argument("path", help="Path or URL to wallpaper image file")

    # Widget command
    widget_p = subparsers.add_parser("widget", help="Toggle desktop widget visibility")
    widget_p.add_argument("name", choices=["clock", "weather", "quickSettings", "mediaPlayer", "systemMonitor", "terminalRice", "dock", "topPill", "list"], help="Widget name")
    widget_p.add_argument("state", choices=["on", "off", "toggle"], nargs="?", default="toggle")

    # EQ command
    eq_p = subparsers.add_parser("eq", help="Set media center equalizer preset")
    eq_p.add_argument("preset", choices=["Balanced", "Bass Boost", "Vocal Clarity", "Electronic Hi-Fi"], help="EQ Preset")

    # Presets export/import command
    preset_p = subparsers.add_parser("preset", help="Export or import complete rice configuration")
    preset_p.add_argument("action", choices=["export", "import", "reset"], help="Preset action")
    preset_p.add_argument("file", nargs="?", default="~/.config/synthex/my-rice.json", help="Path to json preset file")

    args = parser.parse_args()
    cfg = load_config()

    if args.command == "style":
        if args.mode == "current":
            print(f"Current finish style: {cfg.get('styleMode', 'glass')}")
        else:
            cfg["styleMode"] = args.mode
            save_config(cfg)
            print(f"Finish style set to: \033[1m{args.mode.upper()}\033[0m")

    elif args.command == "theme":
        if args.name == "list":
            print("\nAvailable SynthOS Themes:")
            for t in THEME_PRESETS:
                cur = " (active)" if cfg.get("theme") == t else ""
                print(f"  • \033[1m{t}\033[0m{cur}")
            print()
        elif args.name == "current":
            print(f"Current theme: {cfg.get('theme', 'nova')}")
        else:
            preset = THEME_PRESETS[args.name]
            cfg["theme"] = args.name
            cfg["accentColor"] = preset["accent"]
            cfg["secondaryColor"] = preset["secondary"]
            cfg["surfaceColor"] = preset["surface"]
            cfg["dockColor"] = preset["dock"]
            save_config(cfg)

    elif args.command == "accent":
        color = args.hex if args.hex.startswith("#") else f"#{args.hex}"
        cfg["accentColor"] = color
        save_config(cfg)

    elif args.command == "wallpaper":
        p = args.path
        if not p.startswith("file://") and not p.startswith("http"):
            p = f"file://{os.path.abspath(os.path.expanduser(p))}"
        cfg["wallpaperPath"] = p
        save_config(cfg)
        print(f"Wallpaper set to: {p}")

    elif args.command == "widget":
        if args.name == "list":
            print("\nDesktop Widgets Status:")
            for k, v in cfg.get("widgets", {}).items():
                st = "\033[32mON\033[0m" if v else "\033[31mOFF\033[0m"
                print(f"  • {k:15}: {st}")
            print()
        else:
            w = cfg.setdefault("widgets", {})
            if args.state == "on":
                w[args.name] = True
            elif args.state == "off":
                w[args.name] = False
            else:
                w[args.name] = not w.get(args.name, True)
            save_config(cfg)
            print(f"Widget '{args.name}' is now {'ON' if w[args.name] else 'OFF'}")

    elif args.command == "eq":
        cfg["eqPreset"] = args.preset
        save_config(cfg)

    elif args.command == "preset":
        target = Path(os.path.expanduser(args.file))
        if args.action == "export":
            target.parent.mkdir(parents=True, exist_ok=True)
            with open(target, "w") as f:
                json.dump(cfg, f, indent=2)
            print(f"\033[32m✔ Exported current rice to {target}\033[0m")
        elif args.action == "import":
            if target.exists():
                with open(target, "r") as f:
                    new_cfg = json.load(f)
                    cfg.update(new_cfg)
                    save_config(cfg)
                    print(f"\033[32m✔ Successfully imported rice from {target}\033[0m")
            else:
                print(f"\033[31m✖ File not found: {target}\033[0m")
        elif args.action == "reset":
            save_config({
                "theme": "nova",
                "styleMode": "glass",
                "accentColor": "#7AA2F7",
                "secondaryColor": "#BB9AF7",
                "surfaceColor": "#141923",
                "dockColor": "#12161F",
                "cornerRadius": 18,
                "cardOpacity": 0.94,
                "dockSize": 40,
                "dockPosition": "bottom",
                "wallpaperPath": "file:///home/jewboy420/linux-synthex/branding/wallpaper/synthex-dark-4k.svg",
                "widgets": {"clock": True, "weather": True, "quickSettings": True, "mediaPlayer": True, "systemMonitor": True, "terminalRice": True, "dock": True, "topPill": True},
                "performanceMode": "balanced",
                "nightLight": False,
                "dnd": False,
                "eqPreset": "Balanced",
                "eqBands": [0, 2, 0, -1, 3]
            })

    else:
        parser.print_help()


if __name__ == "__main__":
    main()
