[Unit]
Description=Solus AI Hub Backend Service
Documentation=https://docs.solus-project.org/ai/
Requires=ollama.service
After=network.target ollama.service

[Service]
Type=dbus
BusName=org.solus.AIHub
ExecStart=/usr/lib/solus-ai-hub/solus-ai-hub-backend
ExecReload=/bin/kill -HUP $MAINPID
User=ollama
Group=ollama
RuntimeDirectory=solus-ai-hub
StateDirectory=solus-ai-hub
CacheDirectory=solus-ai-hub
LogsDirectory=solus-ai-hub

# Security hardening
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Resource limits
LimitNOFILE=65536
LimitNPROC=256
MemoryMax=4G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
